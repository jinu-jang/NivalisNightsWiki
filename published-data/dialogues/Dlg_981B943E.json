":"DemeanorTemplate","speaker":"Sanderson","text":"Yeah. It's what I figured. Who ever heard of a security droid artist? Stupid. Anyway, here's your money. I'll see ya around.","speakerId":"Ntt_F750E7F8","textSource":"localization","pronounText":{"TextHeVersion":"Yeah. It's what I figured. Who ever heard of a security droid artist? Stupid. Anyway, here's your money. I'll see ya around.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":6,"name":"Sad"},"position":{"x":3200.0,"y":175.0},"source":{"file":"resources.assets","pathId":"20156","byteOffset":15510960,"byteLength":432}},{"id":"DFr_AB884D64","articyId":"72057791606426166","type":"line","className":"DemeanorTemplate","speaker":"Sanderson","text":"Even a security droid with a ruptured cranial plate from too many headbutts?","speakerId":"Ntt_F750E7F8","textSource":"localization","pronounText":{"TextHeVersion":"Even a security droid with a ruptured cranial plate from too many headbutts?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":6,"name":"Sad"},"position":{"x":2625.0,"y":425.0},"source":{"file":"resources.assets","pathId":"17789","byteOffset":14617456,"byteLength":420}},{"id":"DFr_D0290BE2","articyId":"72057791606426192","type":"line","className":"DemeanorTemplate","speaker":"Sanderson","text":"Thank you, you don't know what this means... maybe I'll go and buy... a sketchbook.","speakerId":"Ntt_F750E7F8","textSource":"localization","pronounText":{"TextHeVersion":"Thank you, you don't know what this means... maybe I'll go and buy... a sketchbook.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":3,"name":"Happy"},"position":{"x":3200.0,"y":425.0},"source":{"file":"resources.assets","pathId":"23059","byteOffset":16608608,"byteLength":400}},{"id":"DFr_92E79DD3","articyId":"72057791606426219","type":"line","className":"DemeanorTemplate","speaker":