{"schemaVersion":2,"dialogueId":"Dlg_9CE1F8D5","title":"Harper Oisiris Third Meeting","entry":"Dlg_9CE1F8D5::entry","exit":"Dlg_9CE1F8D5::exit","nodes":[{"id":"DFr_CB7FBC08","articyId":"72057615512832042","type":"line","className":"DemeanorTemplate","speaker":"Harper Osiris","text":"Well, they haven't tracked me down yet!","speakerId":"Ntt_1FFCB1D8","textSource":"localization","pronounText":{"TextHeVersion":"Well, they haven't tracked me down yet!","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":900.0,"y":800.0},"source":{"file":"resources.assets","pathId":"26169","byteOffset":17781848,"byteLength":384}},{"id":"DFr_323F5794","articyId":"72057615512832063","type":"line","className":"DemeanorTemplate","speaker":"Harper Osiris","text":"That is not the kind of negativity I need right now. And I told you, most people die at home!","speakerId":"Ntt_1FFCB1D8","textSource":"localization","pronounText":{"TextHeVersion":"That is not the kind of negativity I need right now. And I told you, most people die at home!","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":2,"name":"Upset"},"position":{"x":1500.0,"y":900.0},"source":{"file":"resources.assets","pathId":"50897","byteOffset":33594160,"byteLength":440}},{"id":"DFr_2096DBA2","articyId":"72057615512832075","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"You're right I apologize.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"You're right I apologize.","TextSheVersion":"You're right I apologize.","TextTheyVersion":"You're right I apologize."},"effects":[],"conditions":[],"script":"","demeanor":{"value":4,"name":"Shocked"},"position":{"x":1800.0,"y":900.0},"source":{"file":"resources.assets","pathId":"47767","byteOffset":32406208,"byteLength":336}},{"id":"DFr_913A55C1","articyId":"72057615512832084","type":"line","className":"DemeanorTemplate","speaker":"Harper Osiris","text":"Ah. Noted!","speakerId":"Ntt_1FFCB1D8","textSource":"localization","pronounText":{"TextHeVersion":"Ah. Noted!","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1500.0,"y":675.0},"source":{"file":"resources.assets","pathId":"28555","byteOffset":18687944,"byteLength":320}},{"id":"DFr_D2799427","articyId":"72057615512832091","type":"line","className":"DemeanorTemplate","speaker":"Harper Osiris","text":"Look I know you're right but Ma Gomba gifted me some strange mushrooms and since I've been eating them, things have been... Lighter.","speakerId":"Ntt_1FFCB1D8","textSource":"localization","pronounText":{"TextHeVersion":"Look I know you're right but Ma Gomba gifted me some strange mushrooms and since I've been eating them, things have been... Lighter.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2100.0,"y":900.0},"source":{"file":"resources.assets","pathId":"51186","byteOffset":33777288,"byteLength":440}},{"id":"DFr_47235891","articyId":"72057615512832114","type":"line","className":"DemeanorTemplate","speaker":"Harper Osiris","text":"It's like all the things I was worried about are in a bed, cuddled under a blanket... In a different city.","speakerId":"Ntt_1FFCB1D8","textSource":"localization","pronounText":{"TextHeVersion":"It's like all the things I was worried about are in a bed, cuddled under a blanket... In a different city.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2650.0,"y":900.0},"source":{"file":"resources.assets","pathId":"45771","byteOffset":31648088,"byteLength":452}},{"id":"DFr_8DDE66EB","articyId":"72057615512832135","type":"line","className":"DemeanorTemplate","speaker":"Harper Osiris","text":"See! Saying something like that would normally make my stomach knot up with stress, but instead I feel even more relaxed.","speakerId":"Ntt_1FFCB1D8","textSource":"localization","pronounText":{"TextHeVersion":"See! Saying something like that would normally make my stomach knot up with stress, but instead I feel even more relaxed.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":3200.0,"y":1075.0},"source":{"file":"resources.assets","pathId":"17299","byteOffset":14433760,"byteLength":432}},{"id":"DFr_FC62D80C","articyId":"72057615512832141","type":"line","className":"DemeanorTemplate","speaker":"Harper Osiris","text":"Look I'm sure she'd hook you up if you asked her.","speakerId":"Ntt_1FFCB1D8","textSource":"localization","pronounText":{"TextHeVersion":"Look I'm sure she'd hook you up if you asked her.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3200.0,"y":725.0},"source":{"file":"resources.assets","pathId":"30576","byteOffset":19447408,"byteLength":396}},{"id":"DFr_2C0A2287","articyId":"72057615512832163","type":"line","className":"DemeanorTemplate","speaker":"Harper Osiris","text":"Me too! But if I don't, I don't!","speakerId":"Ntt_1FFCB1D8","textSource":"localization","pronounText":{"TextHeVersion":"Me too! But if I don't, I don't!","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":3,"name":"Happy"},"position":{"x":3750.0,"y":1075.0},"source":{"file":"resources.assets","pathId":"23730","byteOffset":16858960,"byteLength":340}},{"id":"DFr_EADD4624","articyId":"72057615512832170","type":"line","className":"DemeanorTemplate","speaker":"Harper Osiris","text":"Hey, it's your choice.","speakerId":"Ntt_1FFCB1D8","textSource":"localization","pronounText":{"TextHeVersion":"Hey, it's your choice.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3750.0,"y":725.0},"source":{"file":"resources.assets","pathId":"37018","byteOffset":28347152,"byteLength":332}},{"id":"DFr_3A315E4F","articyId":"72057821671255726","type":"line","className":"DemeanorTemplate","speaker":"Harper Osiris","text":"Hey... thanks for the flat.","speakerId":"Ntt_1FFCB1D8","textSource":"localization","pronounText":{"TextHeVersion":"Hey... thanks for the flat.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":325.0,"y":800.0},"source":{"file":"resources.assets","pathId":"33952","byteOffset":20726856,"byteLength":336}},{"id":"DFr_E07AA7DC","articyId":"72057821671255944","type":"line","className":"DemeanorTemplate","speaker":"Harper Osiris","text":"Anyway, I gotta go. If Danny Danetti asks for me: that's okay. He's my brother. You can level with him. As for everybody else - you don't know me.","speakerId":"Ntt_1FFCB1D8","textSource":"localization","pronounText":{"TextHeVersion":"Anyway, I gotta go. If Danny Danetti asks for me: that's okay. He's my brother. You can level with him. As for everybody else - you don't know me.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":4075.0,"y":900.0},"source":{"file":"resources.assets","pathId":"51100","byteOffset":33744736,"byteLength":492}},{"id":"DFr_2702BBC0","articyId":"72057606922850099","type":"line","className":"DemeanorTemplate","speaker":"Harper Osiris","text":"I'm sure you make the right decision.","speakerId":"Ntt_1FFCB1D8","textSource":"localization","pronounText":{"TextHeVersion":"I'm sure you make the right decision.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":4675.0,"y":775.0},"source":{"file