{"schemaVersion":2,"dialogueId":"Dlg_669F437B","title":"Gideon comes looking for Thaddeus","entry":"Dlg_669F437B::entry","exit":"Dlg_669F437B::exit","nodes":[{"id":"DFr_486B22B0","articyId":"72057645577583834","type":"line","className":"DemeanorTemplate","speaker":"Gideon","text":"Hello friend.","speakerId":"Ntt_970ECEDA","textSource":"localization","pronounText":{"TextHeVersion":"Hello friend.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":475.0,"y":450.0},"source":{"file":"resources.assets","pathId":"43500","byteOffset":30785728,"byteLength":400}},{"id":"DFr_0EC1F73A","articyId":"72057645577583854","type":"line","className":"DemeanorTemplate","speaker":"Gideon","text":"I've kept an eye on you since you took the noodle stand. You're doing good work.","speakerId":"Ntt_970ECEDA","textSource":"localization","pronounText":{"TextHeVersion":"I've kept an eye on you since you took the noodle stand. You're doing good work.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":1075.0,"y":450.0},"source":{"file":"resources.assets","pathId":"42859","byteOffset":30544976,"byteLength":440}},{"id":"DFr_126E7D95","articyId":"72057645577583877","type":"line","className":"DemeanorTemplate","speaker":"Gideon","text":"Say, have we met before?","speakerId":"Ntt_970ECEDA","textSource":"localization","pronounText":{"TextHeVersion":"Say, have we met before?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1675.0,"y":450.0},"source":{"file":"resources.assets","pathId":"52273","byteOffset":34189784,"byteLength":372}},{"id":"DFr_125B6B68","articyId":"72057645577583906","type":"line","className":"DemeanorTemplate","speaker":"Gideon","text":"Right. This LUZ is something else, huh? We're all stuck here together. Good for business though.","speakerId":"Ntt_970ECEDA","textSource":"localization","pronounText":{"TextHeVersion":"Right. This LUZ is something else, huh? We're all stuck here together. Good for business though.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":2575.0,"y":450.0},"source":{"file":"resources.assets","pathId":"17664","byteOffset":14571440,"byteLength":404}},{"id":"DFr_A75ED62A","articyId":"72057645577583934","type":"line","className":"DemeanorTemplate","speaker":"Gideon","text":"You're not from around here. Gen Debtor? You've got the look.","speakerId":"Ntt_970ECEDA","textSource":"localization","pronounText":{"TextHeVersion":"You're not from around here. Gen Debtor? You've got the look.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3475.0,"y":425.0},"source":{"file":"resources.assets","pathId":"31830","byteOffset":19922824,"byteLength":420}},{"id":"DFr_10BB366C","articyId":"72057645577584083","type":"line","className":"DemeanorTemplate","speaker":"Gideon","text":"You're nervous. Like you're waiting for a shoe to fall. Don't worry. No one is looking for you.","speakerId":"Ntt_970ECEDA","textSource":"localization","pronounText":{"TextHeVersion":"You're nervous. Like you're waiting for a shoe to fall. Don't worry. No one is looking for you.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":4075.0,"y":425.0},"source":{"file":"resources.assets","pathId":"41171","byteOffset":29903048,"byteLength":440}},{"id":"DFr_53697CC9","articyId":"72057645577584105","type":"line","className":"DemeanorTemplate","speaker":"Gideon","text":"You know, these things always go better when we treat each other with respect. When we each assume we are dealing with honesty.","speakerId":"Ntt_970ECEDA","textSource":"loc