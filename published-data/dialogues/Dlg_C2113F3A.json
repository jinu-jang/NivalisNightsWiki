{"schemaVersion":2,"dialogueId":"Dlg_C2113F3A","title":"Change of Heart","entry":"Dlg_C2113F3A::entry","exit":"Dlg_C2113F3A::exit","nodes":[{"id":"DFr_7C2D6BAE","articyId":"72057611217973671","type":"line","className":"DemeanorTemplate","speaker":"Karel Crabface Jones","text":"Ya mind? You're blocking my view of a fascinating oil slick.","speakerId":"Ntt_54F0DED1","textSource":"localization","pronounText":{"TextHeVersion":"Ya mind? You're blocking my view of a fascinating oil slick.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":2,"name":"Upset"},"position":{"x":475.0,"y":525.0},"source":{"file":"resources.assets","pathId":"38951","byteOffset":29066712,"byteLength":368}},{"id":"DFr_616CD507","articyId":"72057611217973691","type":"line","className":"DemeanorTemplate","speaker":"Karel Crabface Jones","text":"Here to taunt me with it? Wave it around with those fleshy human arms of yours like some kinda sadistic squid?","speakerId":"Ntt_54F0DED1","textSource":"localization","pronounText":{"TextHeVersion":"Here to taunt me with it? Wave it around with those fleshy human arms of yours like some kinda sadistic squid?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1075.0,"y":525.0},"source":{"file":"resources.assets","pathId":"25275","byteOffset":17445016,"byteLength":456}},{"id":"DFr_8BC68C17","articyId":"72057611217973712","type":"line","className":"DemeanorTemplate","speaker":"Karel Crabface Jones","text":"What are ya, a TheraPay Bot? I know what I need. So stump it up, or don't bother coming back.","speakerId":"Ntt_54F0DED1","textSource":"localization","pronounText":{"TextHeVersion":"What are ya, a TheraPay Bot? I know what I need. So stump it up, or don't bother coming back.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":