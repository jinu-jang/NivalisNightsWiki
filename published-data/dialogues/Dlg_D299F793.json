"byteOffset":32520952,"byteLength":444}},{"id":"DFr_9434494A","articyId":"72057606922872803","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"It's a good start I guess, but nowhere near enough.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"It's a good start I guess, but nowhere near enough.","TextSheVersion":"It's a good start I guess, but nowhere near enough.","TextTheyVersion":"It's a good start I guess, but nowhere near enough."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2100.0,"y":175.0},"source":{"file":"resources.assets","pathId":"45525","byteOffset":31555384,"byteLength":360}},{"id":"DFr_7FB6D97A","articyId":"72057606922872810","type":"line","className":"DemeanorTemplate","speaker":"Ava","text":"I agree. I'll transfer the current balance to your HUD.","speakerId":"Ntt_DC270F89","textSource":"localization","pronounText":{"TextHeVersion":"I agree. I'll transfer the current balance to your HUD.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2750.0,"y":175.0},"source":{"file":"resources.assets","pathId":"52193","byteOffset":34159680,"byteLength":364}},{"id":"DFr_8B4A0657","articyId":"72057606922872816","type":"line","className":"DemeanorTemplate","speaker":"Ava","text":"Thanks to Clancy's adverts we collected 3411 Lims, plus a few direct donations. I think Reena could help boost the campaign; you should speak to her.","speakerId":"Ntt_DC270F89","textSource":"localization","pronounText":{"TextHeVersion":"Thanks to Clancy's adverts we collected 3411 Lims, plus a few direct donations. I think Reena could help boost the campaign; you should speak to her.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1800.0,"y":425.0},"source":{"file":"resources.assets","pathId":"49088","byteOffset":32911608,"byteLength":460}},{"id":"DFr_9D3EB9CC","articyId":"72057606922872822","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Yeah, that's not enough. I'll speak to Reena.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Yeah, that's not enough. I'll speak to Reena.","TextSheVersion":"Yeah, that's not enough. I'll speak to Reena.","TextTheyVersion":"Yeah, that's not enough. I'll speak to Reena."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2100.0,"y":425.0},"source":{"file":"resources.assets","pathId":"45776","byteOffset":31650112,"byteLength":356}},{"id":"DFr_221BD3C9","articyId":"72057606922872828","type":"line","className":"DemeanorTemplate","speaker":"Ava","text":"Good choice. I'll send the current balance to your HUD.","speakerId":"Ntt_DC270F89","textSource":"localization","pronounText":{"TextHeVersion":"Good choice. I'll send the current balance to your HUD.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2750.0,"y":425.0},"source":{"file":"resources.assets","pathId":"51490","byteOffset":33895040,"byteLength":364}},{"id":"DFr_894C5A19","articyId":"72057606922872843","type":"line","className":"DemeanorTemplate","speaker":"Ava","text":"Thanks to Reena we collected 2274 Lims - plus a few direct donations. But I think Clancy is the one with real advertising power.","speakerId":"Ntt_DC270F89","textSource":"localization","pronounText":{"TextHeVersion":"Thanks to Reena we collected 2274 Lims - plus a few direct donations. But I think Clancy is the one with real advertising power.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1800.0,"y":675.0},"source":{"file":"resources.assets","pathId":"36838","byteOffset":28279232,