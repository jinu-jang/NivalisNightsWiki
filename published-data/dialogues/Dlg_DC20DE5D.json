{"schemaVersion":2,"dialogueId":"Dlg_DC20DE5D","title":"Fire Sal","entry":"Dlg_DC20DE5D::entry","exit":"Dlg_DC20DE5D::exit","nodes":[{"id":"DFr_916D3806","articyId":"72057770131589913","type":"line","className":"DemeanorTemplate","speaker":"Sal Magundi II","text":"TT's working like a charm. We never had so many diners. One of them tried to eat old Banor's britches. Ah, you shoulda seen it.","speakerId":"Ntt_771390DE","textSource":"localization","pronounText":{"TextHeVersion":"TT's working like a charm. We never had so many diners. One of them tried to eat old Banor's britches. Ah, you shoulda seen it.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":450.0,"y":375.0},"source":{"file":"resources.assets","pathId":"31889","byteOffset":19945232,"byteLength":472}},{"id":"DFr_E3117C45","articyId":"72057770131589933","type":"line","className":"DemeanorTemplate","speaker":"Sal Magundi II","text":"Crabsticks! Who's the snitch? I'll dose their morning latte with SnoutHowler, then we'll see who's laughing.","speakerId":"Ntt_771390DE","textSource":"localization","pronounText":{"TextHeVersion":"Crabsticks! Who's the snitch? I'll dose their morning latte with SnoutHowler, then we'll see who's laughing.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":2,"name":"Upset"},"position":{"x":1025.0,"y":250.0},"source":{"file":"resources.assets","pathId":"47793","byteOffset":32415640,"byteLength":416}},{"id":"DFr_C1F5E335","articyId":"72057770131589947","type":"line","className":"DemeanorTemplate","speaker":"Sal Magundi II","text":"You're firing me? ME? Sal Magundi II? Creator of the Ham Daiquiri? Winner of Quiche or Die? Your best friend?!","speakerId":"Ntt_771390DE","textSource":"localization","pronounText":{"TextHeVersion":"You're firing me? ME? Sal Magundi II? Creator of the Ham Daiquiri? Winner of Quiche or Die? Your best friend?!","TextSh