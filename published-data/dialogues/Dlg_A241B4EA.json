{"schemaVersion":2,"dialogueId":"Dlg_A241B4EA","title":"Find Safia in Hive Mall","entry":"Dlg_A241B4EA::entry","exit":"Dlg_A241B4EA::exit","nodes":[{"id":"DFr_52351769","articyId":"72057606922867074","type":"line","className":"DemeanorTemplate","speaker":"Safia Megane","text":"What's up?","speakerId":"SafiaMegane","textSource":"localization","pronounText":{"TextHeVersion":"What's up?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":0.0,"y":425.0},"source":{"file":"resources.assets","pathId":"38178","byteOffset":28777448,"byteLength":320}},{"id":"DFr_43797F56","articyId":"72057606922867081","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"I'm his boss, and when I asked him about his poor performance, your name came up.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I'm his boss, and when I asked him about his poor performance, your name came up.","TextSheVersion":"I'm his boss, and when I asked him about his poor performance, your name came up.","TextTheyVersion":"I'm his boss, and when I asked him about his poor performance, your name came up."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":900.0,"y":425.0},"source":{"file":"resources.assets","pathId":"50301","byteOffset":33370656,"byteLength":392}},{"id":"DFr_74AA1E35","articyId":"72057606922867087","type":"line","className":"DemeanorTemplate","speaker":"Safia Megane","text":"I don't want to get him into any trouble.","speakerId":"SafiaMegane","textSource":"localization","pronounText":{"TextHeVersion":"I don't want to get him into any trouble.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1200.0,"y":425.0},"source":{"file":"resources.assets","pathId":"38620","byteOffset":28944904,"byteLength":352}},{"id":"DFr_34556D12","articyId":"72057606922867094","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"But?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"But?","TextSheVersion":"But?","TextTheyVersion":"But?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1500.0,"y":425.0},"source":{"file":"resources.assets","pathId":"26946","byteOffset":18074536,"byteLength":312}},{"id":"DFr_55B24536","articyId":"72057606922867108","type":"line","className":"DemeanorTemplate","speaker":"Safia Megane","text":"I've dated guys like that before. It never works out.","speakerId":"SafiaMegane","textSource":"localization","pronounText":{"TextHeVersion":"I've dated guys like that before. It never works out.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":6,"name":"Sad"},"position":{"x":1775.0,"y":425.0},"source":{"file":"resources.assets","pathId":"23548","byteOffset":16786936,"byteLength":364}},{"id":"DFr_998342F7","articyId":"72057606922867115","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Do you know some Ashwin Chopra?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Do you know some Ashwin Chopra?","TextSheVersion":"Do you know some Ashwin Chopra?","TextTheyVersion":"Do you know some Ashwin Chopra?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":300.0,"y":425.0},"source":{"file":"resources.assets","pathId":"47303","byteOffset":32231840,"byteLength":340}},{"id":"DFr_7A90DBF6","articyId":"72057606922867122","type":"line","className":"DemeanorTemplate","speaker":"Safia Megane","text":"Who's asking?","speakerId":"SafiaMegane","textSource":"localization","pronounText":{"TextHeVersion":"Who's asking?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":600.0,"y":425.0},"source":{"file":"resources.assets","pathId":"39997","byteOffset":29461488,"byteLength":324}},{"id":"DFr_87B34509","articyId":"72057606922867130","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"And he still thinks he has a chance?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"And he still thinks he has a chance?","TextSheVersion":"And he still thinks he has a chance?","TextTheyVersion":"And he still thinks he has a chance?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2075.0,"y":425.0},"source":{"file":"resources.assets","pathId":"52675","byteOffset":34340472,"byteLength":344}},{"id":"DFr_63646A99","articyId":"72057606922867137","type":"line","className":"DemeanorTemplate","speaker":"Safia Megane","text":"He's not in love with me, he's in love with the idea of being in love.","speakerId":"SafiaMegane","textSource":"localization","pronounText":{"TextHeVersion":"He's not in love with me, he's in love with the idea of being in love.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2400.0,"y":425.0},"source":{"file":"resources.assets","pathId":"19853","byteOffset":15393568,"byteLength":380}},{"id":"DFr_E4E1F0E4","articyId":"72057606922867158","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Maybe you need to be clearer with him.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Maybe you need to be clearer with him.","TextSheVersion":"Maybe you need to be clearer with him.","TextTheyVersion":"Maybe you need to be clearer with him."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3000.0,"y":300.0},"source":{"file":"resources.assets","pathId":"51853","byteOffset":34033184,"byteLength":348}},{"id":"DFr_EEDF13CB","articyId":"72057606922867164","type":"line","className":"DemeanorTemplate","speaker":"Safia Megane","text":"He's not gonna listen to me. Anything I say just gets twisted up in his head. He needs a sane voice. A detached voice. A voice like yours.","speakerId":"SafiaMegane","textSource":"localization","pronounText":{"TextHeVersion":"He's not gonna listen to me. Anything I say just gets twisted up in his head. He needs a sane voice. A detached voice. A voice like yours.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3300.0,"y":425.0},"source":{"file":"resources.assets","pathId":"25980","byteOffset":17710616,"byteLength":448}},{"id":"DFr_2428A387","articyId":"72057606922867171","type":"line","className":"DemeanorTemplate","speaker":"Safia Megane","text":"He's still young, you know. He'll get over this. Maybe he'll be a good man, maybe not. Right now, he doesn't need romance. He needs a friend. Or failing that, a friendly boss.","speakerId":"SafiaMegane","textSource":"localization","pronounText":{"TextHeVersion":"He's still young, you know. He'll get over this. Maybe he'll be a good man, maybe not. Right now, he doesn't need romance. He needs a friend. Or failing that, a friendly boss.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3600.0,"y":425.0},"source":{"file":"resources.assets","pathId":"46355","byteOffset":31869784,"byteLength":524}},{"id":"DFr_18C66233","articyId":"72057606922867193","type":"line","className":"DemeanorTemplate","speaker":"Safia Megane","text":"Now he's a heart-sick animal. Feeling sorry for himself. Avoiding me, then finding excuses to be around me through mutual friends.","speakerId":"SafiaMegane","textSource":"localization","pronounText":{"TextHeVersion":"Now he's a heart-sick animal. Feeling sorry for himself. Avoiding me, then finding excuses to be around me through mutual friends.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":2,"name":"Upset"},"position":{"x":2700.0,"y":425.0},"source":{"file":"resources.assets","pathId":"21412","byteOffset":15988088,"byteLength":476}},{"id":"DFr_799D0F10","articyId":"72057606922867201","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"So what do you suggest I do about this?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"So what do you suggest I do about this?","TextSheVersion":"So what do you suggest I do about this?","TextTheyVersion":"So what do you suggest I do about this?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3000.0,"y":550.0},"source":{"file":"resources.assets","pathId":"18775","byteOffset":14989352,"byteLength":348}},{"id":"Dlg_A241B4EA::entry","type":"entry","text":"Find Safia in Hive Mall","speaker":null,"effects":[],"conditions":[]},{"id":"Dlg_A241B4EA::exit","type":"exit","text":"Find Safia in Hive Mall","speaker":null,"effects":[],"conditions":[]},{"id":"Dlg_A089BB72","type":"external","text":"Ava comments on Safia","speaker":null,"effects":[],"conditions":[],"source":{"file":"resources.assets","pathId":"28867","byteOffset":18804664,"byteLength":540},"dialogueId":"Dlg_A089BB72"}],"edges":[{"id":"Dlg_A241B4EA::entry:72057606922867217:0","from":"Dlg_A241B4EA::entry","to":"DFr_52351769","fromPin":"72057606922867217","toPin":"72057606922867075","targetPinRole":"input","pinOrder":0,"order":0,"label":"","effects":[],"script":"AshwinChopra.IsHired","conditions":["AshwinChopra.IsHired"]},{"id":"DFr_52351769:72057606922867076:0","from":"DFr_52351769","to":"DFr_998342F7","fromPin":"72057606922867076","toPin":"72057606922867116","targetPinRole":"input","pinOrder":0,"order":0,"label":"","effects":[],"script":"","conditions":[]},{"id":"DFr_43797F56:7205