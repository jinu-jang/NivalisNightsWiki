 steal it.","TextSheVersion":"I didn't steal it.","TextTheyVersion":"I didn't steal it."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1900.0,"y":300.0},"source":{"file":"resources.assets","pathId":"40920","byteOffset":29807624,"byteLength":300}},{"id":"DFr_319D65E1","articyId":"72057778721526936","type":"choice","className":"DialogueFragment","speaker":"Player","text":"I didn't kill anyone for it.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I didn't kill anyone for it.","TextSheVersion":"I didn't kill anyone for it.","TextTheyVersion":"I didn't kill anyone for it."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1900.0,"y":525.0},"source":{"file":"resources.assets","pathId":"23300","byteOffset":16696664,"byteLength":308}},{"id":"DFr_14E2738A","articyId":"72057778721526942","type":"choice","className":"DialogueFragment","speaker":"Player","text":"I found it.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I found it.","TextSheVersion":"I found it.","TextTheyVersion":"I found it."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1900.0,"y":750.0},"source":{"file":"resources.assets","pathId":"19127","byteOffset":15122096,"byteLength":292}},{"id":"DFr_65A97848","articyId":"72057778721526967","type":"choice","className":"DialogueFragment","speaker":"Player","text":"Do you know anything about it, or not?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Do you know anything about it, or not?","TextSheVersion":"Do you know anything about it, or not?","TextTheyVersion":"Do you know anything about it, or not?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":2475.0,"y":400.0},"source":{"file":"resources.assets","pathId":"37621","byteOffset":28571120,"byteLength":320}},{"id":"DFr_F7C21EE6","articyId":"72057778721526973","type":"choice","className":"Dial