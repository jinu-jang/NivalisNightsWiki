g in exchange.","TextTheyVersion":"She promised me something in exchange."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":3100.0,"y":25.0},"source":{"file":"resources.assets","pathId":"30614","byteOffset":19461816,"byteLength":320}},{"id":"DFr_BE98FC99","articyId":"72057611218083409","type":"choice","className":"DialogueFragment","speaker":"Player","text":"She said she'd pay me...","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"She said she'd pay me...","TextSheVersion":"She said she'd pay me...","TextTheyVersion":"She said she'd pay me..."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":4000.0,"y":275.0},"source":{"file":"resources.assets","pathId":"22158","byteOffset":16268560,"byteLength":304}},{"id":"DFr_197C8B42","articyId":"72057611218083415","type":"choice","className":"DialogueFragment","speaker":"Player","text":"We have to stick together.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"We have to stick together.","TextSheVersion":"We have to stick together.","TextTheyVersion":"We have to stick together."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":4000.0,"y":25.0},"source":{"file":"resources.assets","pathId":"34353","byteOffset":20879320,"byteLength":336}},{"id":"DFr_28E071FB","articyId":"72057611218083440","type":"choice","className":"DialogueFragment","speaker":"Player","text":"So you'll help?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"So you'll help?","TextSheVersion":"So you'll help?","TextTheyVersion":"So you'll help?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":5200.0,"y":150.0},"source":{"file":"resources.assets","pathId":"52357","byteOffset":34221600,"byteLength":296}},{"id":"DFr_A5FB0FC4","articyId":"72057611218083455","type":"choice","className":"DialogueFragment","speaker":"Player","text":"But she's a sailor, sort of. Like you.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"But she's a sailor, sort of. Like you.","TextSheVersion":"But she's a sailor, sort of. Like you.","TextTheyVersion":"But she's a sailor, sort of. Like you."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":4600.0,"y":150.0},"source":{"file":"resources.assets","pathId":"16505","byteOffset":14140952,"byteLength":320}},{"id":"DFr_5D9258A0","articyId":"72057821671309552","type":"choice","className":"DialogueFragment","speaker":"Player","text":"Aye, that's why I'm here. Could you help someone escape the LUZ in your bilge?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Aye, that's why I'm here. Could you help someone escape the LUZ in your bilge?","TextSheVersion":"Aye, that's why I'm here. Could you help someone escape the LUZ in your bilge?","TextTheyVersion":"Aye, that's why I'm here. Could you help someone escape the LUZ in your bilge?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1300.0,"y":25.0},"source":{"file":"resources.assets","pathId":"46165","byteOffset":31795368,"byteLength":360}},{"id":"DFr_3FEF7FC9","articyId":"72057606922885601","type":"choice","className":"DialogueFragment","speaker":"Player","text":"Great, will do. Thanks!","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Great, will do. Thanks!","TextSheVersion":"Great, will do. Thanks!","TextTheyVersion":"Great, will do. Thanks!"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":5800.0,"y":150.0},"source":{"file":"resources.assets","pathId":"44533","byteOffset":31177184,"byteLength":304}},{"id":"Ins_4FEE15EB","articyId":"72057611218083385","type":"action","className":"Instruction","speaker":null,"text":"","speakerId":null,"textSource":"authored","pronounText":null,"effects":[{"type":"delta","variable":"GlobalMorality.Corp","value":-1}],"condition