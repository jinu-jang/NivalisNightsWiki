{"schemaVersion":2,"dialogueId":"Dlg_27018AFA","title":"Salty","entry":"Dlg_27018AFA::entry","exit":"Dlg_27018AFA::exit","nodes":[{"id":"DFr_5E7910BC","articyId":"72057697117168018","type":"line","className":"DemeanorTemplate","speaker":"Taylor Hernz","text":"You smell like grass.","speakerId":"Ntt_9C42C4AC","textSource":"localization","pronounText":{"TextHeVersion":"You smell like grass.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":150.0,"y":500.0},"source":{"file":"resources.assets","pathId":"39364","byteOffset":29222136,"byteLength":388}},{"id":"DFr_ACF32FC1","articyId":"72057697117168040","type":"line","className":"DemeanorTemplate","speaker":"Taylor Hernz","text":"There's no water in yer veins. If I cut yah, you'd bleed redder than red.","speakerId":"Ntt_9C42C4AC","textSource":"localization","pronounText":{"TextHeVersion":"There's no water in yer veins. If I cut yah, you'd bleed redder than red.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":6,"name":"Sad"},"position":{"x":750.0,"y":500.0},"source":{"file":"resources.assets","pathId":"31976","byteOffset":19978592,"byteLength":420}},{"id":"DFr_D9799950","articyId":"72057697117168062","type":"line","className":"DemeanorTemplate","speaker":"Taylor Hernz","text":"Aye. Don't give me no reason to. Now, if you'll excuse me, I have some melodramatic pondering to do.","speakerId":"Ntt_9C42C4AC","textSource":"localization","pronounText":{"TextHeVersion":"Aye. Don't give me no reason to. Now, if you'll excuse me, I have some melodramatic pondering to do.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":1925.0,"y":625.0},"source":{"file":"resources.assets","pathId":"28315","byteOffset":18594152,"byteLength":408}},{"id":"DFr_1E3A3C77","articyId":"72057697117168069","type":"line","className":"DemeanorTemplate","speaker":"Taylor Hernz","text":"Aye. That's what every beach banger says before bedding themselves in a mound of sand.","speakerId":"Ntt_9C42C4AC","textSource":"localization","pronounText":{"TextHeVersion":"Aye. That's what every beach banger says before bedding themselves in a mound of sand.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":1324.0,"y":375.0},"source":{"file":"resources.assets","pathId":"38136","byteOffset":28762176,"byteLength":432}},{"id":"DFr_D3DCD95A","articyId":"72057697117168090","type":"line","className":"DemeanorTemplate","speaker":"Taylor Hernz","text":"Boy, you better believe it.","speakerId":"Ntt_9C42C4AC","textSource":"localization","pronounText":{"TextHeVersion":"Boy, you better believe it.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":1925.0,"y":150.0},"source":{"file":"resources.assets","pathId":"23685","byteOffset":16840360,"byteLength":336}},{"id":"DFr_B325B93D","articyId":"72057697117168098","type":"line","className":"DemeanorTemplate","speaker":"Taylor Hernz","text":"Aye. Now, if you'll excuse me, I have some melodramatic pondering to do.","speakerId":"Ntt_9C42C4AC","textSource":"localization","pronounText":{"TextHeVersion":"Aye. Now, if you'll excuse me, I have some melodramatic pondering to do.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":1925.0,"y":375.0},"source":{"file":"resources.assets","pathId":"18004","byteOffset":14698864,"byteLength":380}},{"id":"DFr_A1283557","articyId":"72057697117168113","type":"line","className":"DemeanorTemplate","speaker":"Taylor Hernz","text":"Reflection of my conquests and the fruits they did not bear.","speakerId":"Ntt_9C42C4AC","textSource":"localization","pronounText":{"TextHeVersion":"Reflection of my conquests and the fruits they did not bear.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":2525.0,"y":500.0},"source":{"file":"resources.assets","pathId":"40068","byteOffset":29487496,"byteLength":368}},{"id":"DFr_D70BCCB2","articyId":"72057697117168127","type":"line","className":"DemeanorTemplate","speaker":"Taylor Hernz","text":"Sounds like you know nothing!","speakerId":"Ntt_9C42C4AC","textSource":"localization","pronounText":{"TextHeVersion":"Sounds like you know nothing!","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":2,"name":"Upset"},"position":{"x":3125.0,"y":500.0},"source":{"file":"resources.assets","pathId":"27433","byteOffset":18259688,"byteLength":376}},{"id":"DFr_7DEC807F","articyId":"72057697117168148","type":"line","className":"DemeanorTemplate","speaker":"Taylor Hernz","text":"That's some salty sarcasm spewing from yer trap. Should keep that ironically offensive whale shit to yerself!","speakerId":"Ntt_9C42C4AC","textSource":"localization","pronounText":{"TextHeVersion":"That's some salty sarcasm spewing from yer trap. Should keep that ironically offensive whale shit to yerself!","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":3725.0,"y":725.0},"source":{"file":"resources.assets","pathId":"43929","byteOffset":30953648,"byteLength":468}},{"id":"DFr_46422768","articyId":"72057697117168156","type":"line","className":"DemeanorTemplate","speaker":"Taylor Hernz","text":"They be tales as old as Luna's pull.","speakerId":"Ntt_9C42C4AC","textSource":"localization","pronounText":{"TextHeVersion":"They be tales as old as Luna's pull.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":3725.0,"y":500.0},"source":{"file":"resources.assets","pathId":"46252","byteOffset":31829248,"byteLength":344}},{"id":"DFr_B3BE300A","articyId":"72057697117168184","type":"line","className":"DemeanorTemplate","speaker":"Taylor Hernz","text":"Toe the line! Disobedience will be met by stern words and guilt. A captain of my stature, WITH MY REPUTATION, shall chop down the pegs on which you walk!","speakerId":"Ntt_9C42C4AC","textSource":"localization","pronounText":{"TextHeVersion":"Toe the line! Disobedience will be met by stern words and guilt. A captain of my stature, WITH MY REPUTATION, shall chop down the pegs on which you walk!","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":2,"name":"Upset"},"position":{"x":4325.0,"y":825.0},"source":{"file":"resources.assets","pathId":"21641","byteOffset":16077664,"byteLength":464}},{"id":"DFr_52255235","articyId":"72057697117168199","type":"line","className":"DemeanorTemplate","speaker":"Taylor Hernz","text":"Because of land lubbers that keep us... keep us down. Buried in the... in the texts of history. Unnamed and forgotten!","speakerId":"Ntt_9C42C4AC","textSource":"localization","pronounText":{"TextHeVersion":"Because of land lubbers that keep us... keep us down. Buried in the... in the texts of history. Unnamed and forgotten!","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":4925.0,"y":675.0},"source":{"file":"resources.assets","pathId":"36200","byteOffset":28041632,"byteLength":496}},{"id":"DFr_3D38115E","articyId":"72057697117168222","type":"line","className":"DemeanorTemplate","speaker":"Taylor Hernz","text":"Of course you don't! That's why yer on the shore rather than sailing the Gridless sea.","speakerId":"Ntt_9C42C4AC","textSource":"localization","pronounText":{"TextHeVersion":"Of course you don't! That's why yer on the shore rather than sailing the Gridless sea.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":5499.0,"y":550.0},"source":{"file":"resources.assets","pathId":"24359","byteOffset":17091408,"byteLength":396}},{"id":"DFr_9416F4C4","articyId":"72057697117168230","type":"line","className":"DemeanorTemplate","speaker":"Taylor Hernz","text":"All of it! A good captain will have a ship named after the... er... name he chose. And then ports and harbors, bays and quays shall bear his moniker!","speakerId":"Ntt_9C42C4AC","textSource":"localization","pronounText":{"TextHeVersion":"All of it! A good captain will have a ship named after the... er... name he chose. And then ports and harbors, bays and quays shall bear his moniker!","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":5500.0,"y":800.0},"source":{"file":"resources.assets","pathId":"51204","byteOffset":33784464,"byteLength":460}},{"id":"DFr_A2EDABC4","articyId":"72057697117168244","type":"line","className":"DemeanorTemplate","speaker":"Taylor Hernz","text":"It's not about me! It's about my stories. The way they spread like tentacles from the beasts below. Er, I'm sure they will once they're told.","speakerId":"Ntt_9C42C4AC","textSource":"localization","pronounText":{"TextHeVersion":"It's not about me! It's about my stories. The way they spread like tentacles from the beasts below. Er, I'm sure they will once they're told.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":6100.0,"y":800.0},"source":{"file":"resources.assets","pathId":"32828","byteOffset":20303136,"byteLength":492}},{"id":"DFr_3DD00CE1","articyId":"72057697117168265","type":"line","className":"DemeanorTemplate","speaker":"Taylor Hernz","text":"EVERYONE needs to hear them! They are tales of triumph and tragedy. Of torment and torrential rain. Wait! I have the saltiest of ideas. One for the books.","speakerId":"Ntt_9C42C4AC","textSource":"localization","pronounText":{"TextHeVersion":"EVERYONE needs to hear them! They are tales of triumph and tragedy. Of torment and torrential rain. Wait! I have the saltiest of ideas. One for the books.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":3,"name":"Happy"},"position":{"x":6700.0,"y":800.0},"source":{"file":"resources.assets","pathId":"28531","byteOffset":18677256,"byteLength":464}},{"id":"DFr_AB6EC063","articyId":"72057697117168280","type":"line","className":"DemeanorTemplate","speaker":"Taylor Hernz","text":"You!","speakerId":"Ntt_9C42C4AC","textSource":"localization","pronounText":{"TextHeVersion":"You!","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":3,"name":"Happy"},"position":{"x":7300.0,"y":800.0},"source":{"file":"resources.assets","pathId":"46410","byteOffset":31891616,"byteLength":312}},{"id":"DFr_3F689483","articyId":"72057697117168294","type":"line","className":"DemeanorTemplate","speaker":"Taylor Hernz","text":"Your salaciously sarcastic tongue will make you the perfect tale-teller. Go forth, spread words of my wisdom to the masses and GET ME NAMING RIGHTS TO SOMETHING!","speakerId":"Ntt_9C42C4AC","textSource":"localization","pronounText":{"TextHeVersion":"Your salaciously sarcastic tongue will make you the perfect tale-teller. Go forth, spread words of my wisdom to the masses and GET ME NAMING RIGHTS TO SOMETHING!","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":7900.0,"y":800.0},"source":{"file":"resources.assets","pathId":"32804","byteOffset":20294168,"byteLength":508}},{"id":"DFr_E37A878E","articyId":"72057697117168315","type":"line","className":"DemeanorTemplate","speaker":"Taylor Hernz","text":"As an order from your Captain, I bestow this quest upon you! Now sail, er, walk forth, and speak the words that come to mind. I shall work on my speech for what shall certainly be a grand dedication.","speakerId":"Ntt_9C42C4AC","textSource":"localization","pronounText":{"TextHeVersion":"As an order from your Captain, I bestow this quest upon you! Now sail, er, walk forth, and speak the words that come to mind. I shall work on my speech for what shall certainly be a grand dedication.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":2,"name":"Upset"},"position":{"x":8475.0,"y":800.0},"source":{"file":"resources.assets","pathId":"37053","byteOffset":28359792,"byteLength":508}},{"id":"DFr_D814D0BB","articyId":"72057821671326470","type":"line","className":"DemeanorTemplate","speaker":"Taylor Hernz","text":"Yer born to a life of walkin' on land like the rest of the dredgers, cleanin' shit from the sidewalk with the bottom of yer boots.","speakerId":"Ntt_9C42C4AC","textSource":"localization","pronounText":{"TextHeVersion":"Yer born to a life of walkin' on land like the rest of the dredgers, cleanin' shit from the sidewalk with the bottom of yer boots.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":5800.0,"y":550.0},"source":{"file":"resources.assets","pathId":"30390","byteOffset":19377768,"byteLength":440}},{"id":"DFr_CBDB1641","articyId":"72057697117168025","type":"choice","className":"DialogueFragment","speaker":"Player","text":"Thanks?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Thanks?","TextSheVersion":"Thanks?","TextTheyVersion":"Thanks?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":450.0,"y":375.0},"source":{"file":"resources.assets","pathId":"48190","byteOffset":32567904,"byteLength":288}},{"id":"DFr_0FEE9775","articyId":"72057697117168033","type":"choice","className":"DialogueFragment","speaker":"Player","text":"I smell better than you.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I smell better than you.","TextSheVersion":"I smell better than you.","TextTheyVersion":"I smell better than you."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":450.0,"y":625.0},"source":{"file":"resources.assets","pathId":"45972","byteOffset":31724216,"byteLength":328}},{"id":"DFr_DC7F94F7","articyId":"72057697117168048","type":"choice","className":"DialogueFragment","speaker":"Player","text":"Is this about the sea? I like the sea.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Is this about the sea? I like the sea.","TextSheVersion":"Is this about the sea? I like the sea.","TextTheyVersion":"Is this about the sea? I like the sea."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1037.0,"y":375.0},"source":{"file":"resources.assets","pathId":"28711","byteOffset":18745064,"byteLength":320}},{"id":"DFr_E1F2344E","articyId":"72057697117168055","type":"choice","className":"DialogueFragment","speaker":"Player","text":"Don't cut me.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Don't cut me.","TextSheVersion":"Don't cut me.","TextTheyVersion":"Don't cut me."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1037.0,"y":625.0},"source":{"file":"resources.assets","pathId":"42844","byteOffset":30539032,"byteLength":296}},{"id":"DFr_C4910686","articyId":"72057697117168076","type":"choice","className":"DialogueFragment","speaker":"Player","text":"That's a lot of B's.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"That's a lot of B's.","TextSheVersion":"That's a lot of B's.","TextTheyVersion":"That's a lot of B's."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1625.0,"y":150.0},"source":{"file":"resources.assets","pathId":"18445","byteOf