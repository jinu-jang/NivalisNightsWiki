":"DialogueFragment","speaker":"Player","text":"Thin skin for a sailor.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Thin skin for a sailor.","TextSheVersion":"Thin skin for a sailor.","TextTheyVersion":"Thin skin for a sailor."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":4025.0,"y":950.0},"source":{"file":"resources.assets","pathId":"25321","byteOffset":17463928,"byteLength":304}},{"id":"DFr_727D7187","articyId":"72057697117168192","type":"choice","className":"DialogueFragment","speaker":"Player","text":"Some reputation. I've never heard of you.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Some reputation. I've never heard of you.","TextSheVersion":"Some reputation. I've never heard of you.","TextTheyVersion":"Some reputation. I've never heard of you."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":4625.0,"y":825.0},"source":{"file":"resources.assets","pathId":"27866","byteOffset":18423584,"byteLength":324}},{"id":"DFr_ACD5AB80","articyId":"72057697117168208","type":"choice","className":"DialogueFragment","speaker":"Player","text":"I don't want anything named after me.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I don't want anything named after me.","TextSheVersion":"I don't want anything named after me.","TextTheyVersion":"I don't want anything named after me."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":5212.0,"y":550.0},"source":{"file":"resources.assets","pathId":"51621","byteOffset":33944792,"byteLength":320}},{"id":"DFr_01EEC9F2","articyId":"72057697117168215","type":"choice","className":"DialogueFragment","speaker":"Player","text":"What do you want named after you?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"What do you want named after you?","TextSheVersion":"What do you want named after you?","TextT