{"schemaVersion":2,"dialogueId":"Dlg_C3BC7D46","title":"We need 3 dishes on the menu","entry":"Dlg_C3BC7D46::entry","exit":"Dlg_C3BC7D46::exit","nodes":[{"id":"DFr_DC487F55","articyId":"72057611218074519","type":"line","className":"DemeanorTemplate","speaker":"Marcelle DeNuite","text":"Don't mind me, I'm just here sniffing around.","speakerId":"Ntt_F55BAE21","textSource":"localization","pronounText":{"TextHeVersion":"Don't mind me, I'm just here sniffing around.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":550.0,"y":425.0},"source":{"file":"resources.assets","pathId":"17968","byteOffset":14686136,"byteLength":356}},{"id":"DFr_AD7F7E6B","articyId":"72057611218074542","type":"line","className":"DemeanorTemplate","speaker":"Marcelle DeNuite","text":"An aroma of alteration. An odor of originality. Sadly, I haven't found it.","speakerId":"Ntt_F55BAE21","textSource":"localization","pronounText":{"TextHeVersion":"An aroma of alteration. An odor of originality. Sadly, I haven't found it.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":6,"name":"Sad"},"position":{"x":1137.0,"y":425.0},"source":{"file":"resources.assets","pathId":"16669","byteOffset":14201016,"byteLength":384}},{"id":"DFr_030DB53A","articyId":"72057611218074556","type":"line","className":"DemeanorTemplate","speaker":"Marcelle DeNuite","text":"How is a humble food critic meant to critique when he has nothing to go on? How am I to evaluate your skill when you only offer so little?","speakerId":"Ntt_F55BAE21","textSource":"localization","pronounText":{"TextHeVersion":"How is a humble food critic meant to critique when he has nothing to go on? How am I to evaluate your skill when you only offer so little?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":6,"name":"Sad"},"position":{"x":1711.0,"y":400.0},"sou