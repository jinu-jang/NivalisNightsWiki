{"schemaVersion":2,"dialogueId":"Dlg_264FA5E9","title":"Deeala to the Moon!","entry":"Dlg_264FA5E9::entry","exit":"Dlg_264FA5E9::exit","nodes":[{"id":"DFr_607AFA7E","articyId":"72057774426555791","type":"line","className":"DemeanorTemplate","speaker":"Deeala","text":"Well.. I'm homeless.","speakerId":"Ntt_621D2725","textSource":"localization","pronounText":{"TextHeVersion":"Well.. I'm homeless.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":6,"name":"Sad"},"position":{"x":0.0,"y":0.0},"source":{"file":"resources.assets","pathId":"49470","byteOffset":33057992,"byteLength":364}},{"id":"DFr_0192B89A","articyId":"72057774426555810","type":"line","className":"DemeanorTemplate","speaker":"Deeala","text":"Remember my arsehole landlord Pilk Dane?","speakerId":"Ntt_621D2725","textSource":"localization","pronounText":{"TextHeVersion":"Remember my arsehole landlord Pilk Dane?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":600.0,"y":0.0},"source":{"file":"resources.assets","pathId":"42191","byteOffset":30289736,"byteLength":384}},{"id":"DFr_055AE5E0","articyId":"72057774426555829","type":"line","className":"DemeanorTemplate","speaker":"Deeala","text":"He wanted me to teach him how to roast people at the comedy club.","speakerId":"Ntt_621D2725","textSource":"localization","pronounText":{"TextHeVersion":"He wanted me to teach him how to roast people at the comedy club.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1200.0,"y":0.0},"source":{"file":"resources.assets","pathId":"33892","byteOffset":20704712,"byteLength":376}},{"id":"DFr_87FD2EB0","articyId":"72057774426555857","type":"line","className":"DemeanorTemplate","speaker":"Deeala","text":"Well, I taught him alright. A bit too well.","speakerId":"Ntt_621D2725","textSource":"localization","pronounText":{"TextHeVersion":"Well, I taught him alright. A bit too well.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1800.0,"y":0.0},"source":{"file":"resources.assets","pathId":"32315","byteOffset":20104768,"byteLength":388}},{"id":"DFr_B37D5DB3","articyId":"72057774426555872","type":"line","className":"DemeanorTemplate","speaker":"Deeala","text":"Oh no. Not at all. I had barely made one comment, and he had already evicted me.","speakerId":"Ntt_621D2725","textSource":"localization","pronounText":{"TextHeVersion":"Oh no. Not at all. I had barely made one comment, and he had already evicted me.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":2,"name":"Upset"},"position":{"x":2400.0,"y":0.0},"source":{"file":"resources.assets","pathId":"51518","byteOffset":33906288,"byteLength":424}},{"id":"DFr_7F2FB2B3","articyId":"72057774426555887","type":"line","className":"DemeanorTemplate","speaker":"Deeala","text":"I made a joke about his stand up routine.","speakerId":"Ntt_621D2725","textSource":"localization","pronounText":{"TextHeVersion":"I made a joke about his stand up routine.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3000.0,"y":0.0},"source":{"file":"resources.assets","pathId":"19117","byteOffset":15118312,"byteLength":352}},{"id":"DFr_CCF694C3","articyId":"72057774426555901","type":"line","className":"DemeanorTemplate","speaker":"Deeala","text":"\"It takes more muscles to frown than to smile. Your routine is like a gym session for my face.\"","speakerId":"Ntt_621D2725","textSource":"localization","pronounText":{"TextHeVersion":"\"It takes more muscles to frown than to smile. Your routine is like a gym session for my face.\"","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":2,"name":"Upset"},"position":{"x":3600.0,"y":0.0},"source":{"file":"resources.assets","pathId":"50167","byteOffset":33321256,"byteLength":440}},{"id":"DFr_CA92A9D2","articyId":"72057774426555917","type":"line","className":"DemeanorTemplate","speaker":"Deeala","text":"I followed it with \"Your stand up is as funny as a fire in a kindergarten.\"","speakerId":"Ntt_621D2725","textSource":"localization","pronounText":{"TextHeVersion":"I followed it with \"Your stand up is as funny as a fire in a kindergarten.\"","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":2,"name":"Upset"},"position":{"x":4200.0,"y":0.0},"source":{"file":"resources.assets","pathId":"25812","byteOffset":17647848,"byteLength":428}},{"id":"DFr_4C61791D","articyId":"72057774426555931","type":"line","className":"DemeanorTemplate","speaker":"Deeala","text":"Anyway, he chucked me out, called me a traitor to comedy, changed the locks and threw all my stuff in a trash compactor.","speakerId":"Ntt_621D2725","textSource":"localization","pronounText":{"TextHeVersion":"Anyway, he chucked me out, called me a traitor to comedy, changed the locks and threw all my stuff in a trash compactor.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":2,"name":"Upset"},"position":{"x":4800.0,"y":0.0},"source":{"file":"resources.assets","pathId":"36092","byteOffset":28001456,"byteLength":428}},{"id":"DFr_3AD57297","articyId":"72057774426555954","type":"line","className":"DemeanorTemplate","speaker":"Deeala","text":"Now I'm on my way to Luna.","speakerId":"Ntt_621D2725","textSource":"localization","pronounText":{"TextHeVersion":"Now I'm on my way to Luna.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":2,"name":"Upset"},"position":{"x":5400.0,"y":0.0},"source":{"file":"resources.assets","pathId":"22738","byteOffset":16486856,"byteLength":372}},{"id":"DFr_F6132306","articyId":"72057774426555991","type":"line","className":"DemeanorTemplate","speaker":"Deeala","text":"This rich Luna Corpster has been asking me to go visit him for a while. Might as well take him up on his offer. There's nothing for me here now.","speakerId":"Ntt_621D2725","textSource":"localization","pronounText":{"TextHeVersion":"This rich Luna Corpster has been asking me to go visit him for a while. Might as well take him up on his offer. There's nothing for me here now.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":2,"name":"Upset"},"position":{"x":6000.0,"y":0.0},"source":{"file":"resources.assets","pathId":"18275","byteOffset":14800496,"byteLength":452}},{"id":"DFr_A59FC76A","articyId":"72057774426556006","type":"line","className":"DemeanorTemplate","speaker":"Deeala","text":"Well... he's my second cousin. He wants to put me on a Corp recruitment fast track training course.","speakerId":"Ntt_621D2725","textSource":"localization","pronounText":{"TextHeVersion":"Well... he's my second cousin. He wants to put me on a Corp recruitment fast track training course.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":2,"name":"Upset"},"position":{"x":6600.0,"y":0.0},"source":{"file":"resources.assets","pathId":"16846","byteOffset":14265200,"byteLength":444}},{"id":"DFr_BAE3C013","articyId":"72057774426556021","type":"line","className":"DemeanorTemplate","speaker":"Deeala","text":"Maybe I can mooch off him for a while and find a less soul-destroying job.","speakerId":"Ntt_621D2725","textSource":"localization","pronounText":{"TextHeVersion":"Maybe I can mooch off him for a while and find a less soul-destroying job.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":2,"name":"Upset"},"position":{"x":7200.0,"y":-125.0},"source":{"file":"resources.assets","pathId":"46262","byteOffset":31832856,"byteLength":384}},{"id":"DFr_CE49B3F2","articyId":"72057774426556036","type":"line","className":"DemeanorTemplate","speaker":"Deeala","text":"I've spent my whole life fighting my own battles. Maybe just this once, it would have been nice to have someone fight FOR me.","speakerId":"Ntt_621D2725","textSource":"localization","pronounText":{"TextHeVersion":"I've spent my whole life fighting my own battles. Maybe just this once, it would have been nice to have someone fight FOR me.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":2,"name":"Upset"},"position":{"x":7800.0,"y":0.0},"source":{"file":"resources.assets","pathId":"39004","byteOffset":29086640,"byteLength":472}},{"id":"DFr_C8BADA28","articyId":"72057774426556081","type":"line","className":"DemeanorTemplate","speaker":"Deeala","text":"Well, whatever. I need to get out of here now. So... thanks for being a pretty OK friend, and a non-terrible human. Mostly.","speakerId":"Ntt_621D2725","textSource":"localization","pronounText":{"TextHeVersion":"Well, whatever. I need to get out of here now. So... thanks for being a pretty OK friend, and a non-terrible human. Mostly.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":2,"name":"Upset"},"position":{"x":8400.0,"y":0.0},"source":{"file":"resources.assets","pathId":"31428","byteOffset":19771152,"byteLength":468}},{"id":"DFr_E6635F24","articyId":"72057774426556110","type":"line","className":"DemeanorTemplate","speaker":"Deeala","text":"Who knows, maybe I'll see you up there one day. If I do, say hi. But never bring up Pilk fucking Dane ever again! Later.","speakerId":"Ntt_621D2725","textSource":"localization","pronounText":{"TextHeVersion":"Who knows, maybe I'll see you up there one day. If I do, say hi. But never bring up Pilk fucking Dane ever again! Later.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":2,"name":"Upset"},"position":{"x":9000.0,"y":0.0},"source":{"file":"resources.assets","pathId":"46481","byteOffset":31918416,"byteLength":428}},{"id":"DFr_74DC8E1A","articyId":"72057774426555798","type":"choice","className":"DialogueFragment","speaker":"Player","text":"I'm sorry.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I'm sorry.","TextSheVersion":"I'm sorry.","TextTheyVersion":"I'm sorry."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":300.0,"y":-125.0},"source":{"file":"resources.assets","pathId":"47469","byteOffset":32294544,"byteLength":312}},{"id":"DFr_3C65B8FE","articyId":"72057774426555804","type":"choice","className":"DialogueFragment","speaker":"Player","text":"What happened?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"What happened?","TextSheVersion":"What happened?","TextTheyVersion":"What happened?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":300.0,"y":125.0},"source":{"file":"resources.assets","pathId":"43824","byteOffset":30910808,"byteLength":296}},{"id":"DFr_0991F65C","articyId":"72057774426555817","type":"choice","className":"DialogueFragment","speaker":"Player","text":"I do.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I do.","TextSheVersion":"I do.","TextTheyVersion":"I do."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":900.0,"y":-125.0},"source":{"file":"resources.assets","pathId":"33296","byteOffset":20480688,"byteLength":288}},{"id":"DFr_4BA8A223","articyId":"72057774426555823","type":"choice","className":"DialogueFragment","speaker":"Player","text":"Remind me.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Remind me.","TextSheVersion":"Remind me.","TextTheyVersion":"Remind me."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":900.