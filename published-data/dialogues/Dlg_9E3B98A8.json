{"schemaVersion":2,"dialogueId":"Dlg_9E3B98A8","title":"A rat's ass!","entry":"Dlg_9E3B98A8::entry","exit":"Dlg_9E3B98A8::exit","nodes":[{"id":"DFr_B76F036B","articyId":"72057606922877051","type":"line","className":"DemeanorTemplate","speaker":"Gladstone","text":"Ah, my friend, there you are!","speakerId":"Ntt_B44D6973","textSource":"localization","pronounText":{"TextHeVersion":"Ah, my friend, there you are!","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":600.0,"y":500.0},"source":{"file":"resources.assets","pathId":"37373","byteOffset":28477304,"byteLength":340}},{"id":"DFr_4D8790E0","articyId":"72057606922877058","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Me?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Me?","TextSheVersion":"Me?","TextTheyVersion":"Me?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":900.0,"y":500.0},"source":{"file":"resources.assets","pathId":"50499","byteOffset":33446024,"byteLength":312}},{"id":"DFr_991C75B4","articyId":"72057606922877065","type":"line","className":"DemeanorTemplate","speaker":"Gladstone","text":"Yes, you! I've been hearing whispers that you're trying to save the McKenna boy's life.","speakerId":"Ntt_B44D6973","textSource":"localization","pronounText":{"TextHeVersion":"Yes, you! I've been hearing whispers that you're trying to save the McKenna boy's life.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1200.0,"y":500.0},"source":{"file":"resources.assets","pathId":"30853","byteOffset":19553528,"byteLength":396}},{"id":"DFr_C07DAAD9","articyId":"72057606922877072","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Why?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"Te