":2100.0,"y":625.0},"source":{"file":"resources.assets","pathId":"48138","byteOffset":32547664,"byteLength":340}},{"id":"DFr_AA92FEA4","articyId":"72057606922877100","type":"line","className":"DemeanorTemplate","speaker":"Gladstone","text":"Because more humans means more rats. They want us to be one family.","speakerId":"Ntt_B44D6973","textSource":"localization","pronounText":{"TextHeVersion":"Because more humans means more rats. They want us to be one family.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2400.0,"y":375.0},"source":{"file":"resources.assets","pathId":"38451","byteOffset":28881248,"byteLength":376}},{"id":"DFr_E813451B","articyId":"72057606922877107","type":"line","className":"DemeanorTemplate","speaker":"Gladstone","text":"Their claws aren't built for Lims. But they see things, nice things, and they tell me where to find them.","speakerId":"Ntt_B44D6973","textSource":"localization","pronounText":{"TextHeVersion":"Their claws aren't built for Lims. But they see things, nice things, and they tell me where to find them.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2400.0,"y":625.0},"source":{"file":"resources.assets","pathId":"36901","byteOffset":28303816,"byteLength":416}},{"id":"DFr_1BE3C500","articyId":"72057606922877114","type":"line","className":"DemeanorTemplate","speaker":"Gladstone","text":"Jewelry, bits of tech, lost trinkets, spare parts... the sewers are full of expensive things, if you know where to look.","speakerId":"Ntt_B44D6973","textSource":"localization","pronounText":{"TextHeVersion":"Jewelry, bits of tech, lost trinkets, spare parts... the sewers are full of expensive things, if you know where to look.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"posi