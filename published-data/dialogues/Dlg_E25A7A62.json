"byteLength":316}},{"id":"DFr_61551E17","articyId":"72057774426561304","type":"line","className":"DialogueFragment","speaker":"Lois Gyo","text":"You seem cheerful. Or are you making fun of me? A simple \"Hi Lois\" would be fine.","speakerId":"Ntt_36265A9E","textSource":"localization","pronounText":{"TextHeVersion":"You seem cheerful. Or are you making fun of me? A simple \"Hi Lois\" would be fine.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":575.0,"y":-200.0},"source":{"file":"resources.assets","pathId":"46352","byteOffset":31868640,"byteLength":364}},{"id":"DFr_4908FC08","articyId":"72057774426561313","type":"choice","className":"DialogueFragment","speaker":"Player","text":"Waiting for?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Waiting for?","TextSheVersion":"Waiting for?","TextTheyVersion":"Waiting for?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":2100.0,"y":100.0},"source":{"file":"resources.assets","pathId":"32350","byteOffset":20121304,"byteLength":292}},{"id":"DFr_79F2D3F1","articyId":"72057774426561319","type":"choice","className":"DialogueFragment","speaker":"Player","text":"Go on.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Go on.","TextSheVersion":"Go on.","TextTheyVersion":"Go on."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":2100.0,"y":325.0},"source":{"file":"resources.assets","pathId":"18220","byteOffset":14779632,"byteLength":288}},{"id":"DFr_569EEA3C","articyId":"72057774426561334","type":"line","className":"DialogueFragment","speaker":"Lois Gyo","text":"I dunno. I guess I was sorta hoping I'd bump into you. I mean I'm researching Industrial levels for this FPS game they've put me on, so I guess that's my excuse for being here... But my real reason is to... just explore the city.","speakerId":"Ntt_36265A9E","textSource":"localization","pronounText":{"TextHeVersion":"I dunno. I guess I was sorta hoping I'd bump into you. I mean I'm researching Industrial levels for this FPS game they've put me on, so I guess that's my excuse for being here... But my real reason is to... just explore the city.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":2400.0,"y":175.0},"source":{"file":"resources.assets","pathId":"44025","byteOffset":30990848,"byteLength":548}},{"id":"DFr_A9837340","articyId":"72057774426561341","type":"choice","className":"DialogueFragment","speaker":"Player","text":"I'm glad to see you too Lois.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I'm glad to see you too Lois.","TextSheVersion":"I'm glad to see you too Lois.","TextTheyVersion":"I'm glad to see you too Lois."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":2700.0,"y":100.0},"source":{"file":"resources.assets","pathId":"35649","byteOffset":27834648,"byteLength":312}},{"id":"DFr_D7EB4C4E","articyId":"72057774426561355","type":"choice","className":"DialogueFragment","speaker":"Player","text":"Where?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Where?","TextSheVersion":"Where?","TextTheyVersion":"Where?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":3300.0,"y":25.0},"source":{"file":"resources.assets","pathId":"29429","byteOffset":19013096,"byteLength":288}},{"id":"DFr_2DCF07EE","articyId":"72057774426561361","type":"choice","className":"DialogueFragment","speaker":"Player","text":"Why?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Why?","TextSheVersion":"Why?","TextTheyVersion":"Why?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":3300.0,"y":250.0},"source":{"file":"resources.assets","pathId":"19979","byteOffset":15442712,"byteLength":284}},{"id":"DFr_0438935E","articyId":"72057774426561369","type":"line","className":"DialogueFragment","speaker":"Lois Gyo","text":"I'd like to see the Ventz. Or maybe even the Steppes. Can you imagine? Leaving the city... I've never even stepped foot out of this DISTRICT.","speakerId":"Ntt_36265A9E","textSource":"localization","pronounText":{"TextHeVersion":"I'd like to see the Ventz. Or maybe even the Steppes. Can you imagine? Leaving the city... I've never even stepped foot out of this DISTRICT.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":3600.0,"y":125.0},"source":{"file":"resources.assets","pathId":"26681","byteOffset":17972904,"byteLength":496}},{"id":"DFr_10F0799F","articyId":"72057774426561377","type":"choice","className":"DialogueFragment","speaker":"Player","text":"Everything you could ever want is here in the city.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Everything you could ever want is here in the city.","TextSheVersion":"Everything you could ever want is here in the city.","TextTheyVersion":"Everything you could ever want is here in the city."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":3900.0,"y":-125.0},"source":{"file":"resources.assets","pathId":"20374","byteOffset":15591640,"byteLength":332}},{"id":"DFr_E9EBB4DF","articyId":"72057774426561383","type":"choice","className":"DialogueFragment","speaker":"Player","text":"I need out of here too.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I need out of here too.","TextSheVersion":"I need out of here too.","TextTheyVersion":"I need out of here too."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":3900.0,"y":125.0},"source":{"file":"resources.assets","pathId":"33627","byteOffset":20604880,"byteLength":304}},{"id":"DFr_9501A4ED","articyId":"72057774426561390","type":"line","className":"DialogueFragment","speaker":"Lois Gyo","text":"You could always come with me?","speakerId":"Ntt_36265A9E","textSource":"localization","pronounText":{"TextHeVersion":"You could always come with me?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":4200.0,"y":50.0},"source":{"file":"resources.assets","pathId":"28942","byteOffset":18832416,"byteLength":384}},{"id":"DFr_2659C631","articyId":"72057774426561399","type":"choice","className":"DialogueFragment","speaker":"Player","text":"I'd like to travel, but Nivalis will always be home.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I'd like to travel, but Nivalis will always be home.","TextSheVersion":"I'd like to travel, but Nivalis will always be home.","TextTheyVersion":"I'd like to travel, but Nivalis will always be home."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":3900.0,"y":350.0},"source":{"file":"resources.assets","pathId":"31131","byteOffset":19658224,"byteLength":332}},{"id":"DFr_FA892F2B","articyId":"72057774426561406","type":"choice","className":"DialogueFragment","speaker":"Player","text":"I'm not sure.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I'm not sure.","TextSheVersion":"I'm not sure.","TextTheyVersion":"I'm not sure."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":4475.0,"y":75.0},"source":{"file":"resources.assets","pathId":"46007","byteOffset":31737144,"byteLength":296}},{"id":"DFr_5956D60B","articyId":"72057774426561412","type":"choice","className":"DialogueFragment","speaker":"Player","text":"No, I don't want that.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"No, I don't want that.","TextSheVersion":"No, I don't want that.","TextTheyVersion":"No, I don't want that."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":4475.0,"y":-150.0},"source":{"file":"resources.assets","pathId":"42073","byteOffset":30243168,"byteLength":304}},{"id":"DFr_56E48D0E","articyId":"72057774426561420","type":"choice","className":"DialogueFragment","speaker":"Player","text":"I would like that.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I would like that.","TextSheVersion":"I would like that.","TextTheyVersion":"I would like that."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":4475.0,"y":300.0},"source":{"file":"resources.assets","pathId":"18063","byteOffset":14720928,"byteLength":300}},{"id":"DFr_FCC3DA9A","articyId":"72057774426561427","type":"line","className":"DialogueFragment","speaker":"Lois Gyo","text":"Hey, it's just an idea. Well, honestly, more of a dream than an idea. But, you know, keep it in mind.","speakerId":"Ntt_36265A9E","textSource":"localization","pronounText":{"TextHeVersion":"Hey, it's just an idea. Well, honestly, more of a dream than an idea. But, you know, keep it in mind.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":4775.0,"y":100.0},"source":{"file":"resources.assets","pathId":"40096","byteOffset":29497872,"byteLength":384}},{"id":"DFr_749ADC5C","articyId":"72057774426561436","type":"line","className":"DialogueFragment","speaker":"Lois Gyo","text":"Alright. Well, I should get back to my apartment. I have a milestone to deliver, and if the serial killer that sneaks into apartments comes and I'm not home, he might be pretty bummed.","speakerId":"Ntt_36265A9E","textSource":"localization","pronounText":{"TextHeVersion":"Alright. Well, I should get back to my apartment. I have a milestone to deliver, and if the serial killer that sneaks into apartments comes and I'm not home, he might be pretty bummed.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":5400.0,"y":100.0},"source":{"file":"resources.assets",