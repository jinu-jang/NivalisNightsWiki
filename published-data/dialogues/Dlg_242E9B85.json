{"schemaVersion":2,"dialogueId":"Dlg_242E9B85","title":"Talk to Clancy 3","entry":"Dlg_242E9B85::entry","exit":"Dlg_242E9B85::exit","nodes":[{"id":"DFr_72D6E2C6","articyId":"72057606922876622","type":"line","className":"DemeanorTemplate","speaker":"Clancy Pantermino","text":"Well, finally. I've been waiting for you to come see me.","speakerId":"Ntt_CDA9F8FA","textSource":"localization","pronounText":{"TextHeVersion":"Well, finally. I've been waiting for you to come see me.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":600.0,"y":375.0},"source":{"file":"resources.assets","pathId":"35526","byteOffset":25800336,"byteLength":364}},{"id":"DFr_AF5D7968","articyId":"72057606922876634","type":"line","className":"DemeanorTemplate","speaker":"Clancy Pantermino","text":"Yes, what is it?","speakerId":"Ntt_CDA9F8FA","textSource":"localization","pronounText":{"TextHeVersion":"Yes, what is it?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":600.0,"y":625.0},"source":{"file":"resources.assets","pathId":"37706","byteOffset":28602184,"byteLength":324}},{"id":"DFr_8EFA82CE","articyId":"72057606922876641","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"I haven't had much time.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I haven't had much time.","TextSheVersion":"I haven't had much time.","TextTheyVersion":"I haven't had much time."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":900.0,"y":375.0},"source":{"file":"resources.assets","pathId":"34100","byteOffset":20782464,"byteLength":332}},{"id":"DFr_7C3A5BEE","articyId":"72057606922876648","type":"line","className":"DemeanorTemplate","speaker":"Clancy Pantermino","text":"No, you haven't had much brain. You need 40,000 Lims, I can halve the time it takes you to collect it. You're just poor at math.","speakerId":"Ntt_CDA9F8FA","textSource":"localization","pronounText":{"TextHeVersion":"No, you haven't had much brain. You need 40,000 Lims, I can halve the time it takes you to collect it. You're just poor at math.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1200.0,"y":375.0},"source":{"file":"resources.assets","pathId":"30114","byteOffset":19271984,"byteLength":436}},{"id":"DFr_7EEDA55D","articyId":"72057606922876655","type":"line","className":"DemeanorTemplate","speaker":"Clancy Pantermino","text":"But hopefully that won't cost a child's life.","speakerId":"Ntt_CDA9F8FA","textSource":"localization","pronounText":{"TextHeVersion":"But hopefully that won't cost a child's life.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1500.0,"y":375.0},"source":{"file":"resources.assets","pathId":"50886","byteOffset":33590160,"byteLength":356}},{"id":"DFr_B52E6E21","articyId":"72057606922876662","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Well, why did you wait for me, if you care so much?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Well, why did you wait for me, if you care so much?","TextSheVersion":"Well, why did you wait for me, if you care so much?","TextTheyVersion":"Well, why did you wait for me, if you care so much?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1800.0,"y":375.0},"source":{"file":"resources.assets","pathId":"40750","byteOffset":29743496,"byteLength":360}},{"id":"DFr_076603F6","articyId":"72057606922876669","type":"line","className":"DemeanorTemplate","speaker":"Clancy Pantermino","text":"A client-less campaign is little better than a con.","speakerId":"Ntt_CDA9F8FA","textSource":"localization","pronounText":{"TextHeVersion":"A client-less campaign is little better than a con.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2100.0,"y":375.0},"source":{"file":"resources.assets","pathId":"44816","byteOffset":31288608,"byteLength":360}},{"id":"DFr_58072B9F","articyId":"72057606922876676","type":"line","className":"DemeanorTemplate","speaker":"Clancy Pantermino","text":"Besides, if I'm going to give up free advertising space, I want to know who I'm giving it to. So go on: hit me with me your pitch.","speakerId":"Ntt_CDA9F8FA","textSource":"localization","pronounText":{"TextHeVersion":"Besides, if I'm going to give up free advertising space, I want to know who I'm giving it to. So go on: hit me with me your pitch.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2400.0,"y":375.0},"source":{"file":"resources.assets","pathId":"41803","byteOffset":30142336,"byteLength":476}},{"id":"DFr_E93B504C","articyId":"72057606922876682","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"You should give us the ad space because it's good business.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"You should give us the ad space because it's good business.","TextSheVersion":"You should give us the ad space because it's good business.","TextTheyVersion":"You should give us the ad space because it's good business."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2700.0,"y":375.0},"source":{"file":"resources.assets","pathId":"50056","byteOffset":33280272,"byteLength":400}},{"id":"DFr_C31567AA","articyId":"72057606922876689","type":"line","className":"DemeanorTemplate","speaker":"Clancy Pantermino","text":"That's not how CorpSec will see it.","speakerId":"Ntt_CDA9F8FA","textSource":"localization","pronounText":{"TextHeVersion":"That's not how CorpSec will see it.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3000.0,"y":375.0},"source":{"file":"resources.assets","pathId":"31711","byteOffset":19876448,"byteLength":344}},{"id":"DFr_8FC2B55E","articyId":"72057606922876696","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"You should give us the ad space because it's the right thing to do.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"You should give us the ad space because it's the right thing to do.","TextSheVersion":"You should give us the ad space because it's the right thing to do.","TextTheyVersion":"You should give us the ad space because it's the right thing to do."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2700.0,"y":625.0},"source":{"file":"resources.assets","pathId":"42692","byteOffset":30478752,"byteLength":376}},{"id":"DFr_8F86580C","articyId":"72057606922876703","type":"line","className":"DemeanorTemplate","speaker":"Clancy Pantermino","text":"Eh. Right for you, perhaps. What about me? I have to earn a living you know.","speakerId":"Ntt_CDA9F8FA","textSource":"localization","pronounText":{"TextHeVersion":"Eh. Right for you, perhaps. What about me? I have to earn a living you know.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3000.0,"y":625.0},"source":{"file":"resources.assets","pathId":"39247","byteOffset":29179624,"byteLength":384}},{"id":"DFr_994894E5","articyId":"72057606922876710","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Come on, this won't cost you anything.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Come on, this won't cost you anything.","TextSheVersion":"Come on, this won't cost you anything.","TextTheyVersion":"Come on, this won't cost you anything."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3300.0,"y":625.0},"source":{"file":"resources.assets","pathId":"46916","byteOffset":32077824,"byteLength":348}},{"id":"DFr_AED4B386","articyId":"72057606922876718","type":"line","className":"DemeanorTemplate","speaker":"Clancy Pantermino","text":"In fact, helping you might even harm my relationship with them. So I think it'll have to be a no.","speakerId":"Ntt_CDA9F8FA","textSource":"localization","pronounText":{"TextHeVersion":"In fact, helping you might even harm my relationship with them. So I think it'll have to be a no.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3300.0,"y":375.0},"source":{"file":"resources.assets","pathId":"50158","byteOffset":33317760,"byteLength":444}},{"id":"DFr_6A2A87AE","articyId":"72057606922876725","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"If it was a no, you wouldn't have wasted time talking to me.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"If it was a no, you wouldn't have wasted time talking to me.","TextSheVersion":"If it was a no, you wouldn't have wasted time talking to me.","TextTheyVersion":"If it was a no, you wouldn't have wasted time talking to me."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3600.0,"y":375.0},"source":{"file":"resources.assets","pathId":"41427","byteOffset":30000552,"byteLength":368}},{"id":"DFr_AD7AF2DE","articyId":"72057606922876732","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"What about your relationship with dozens of potential new clients?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"What about your relationship with dozens of potential new clients?","TextSheVersion":"What about your relationship with dozens of potential new clients?","TextTheyVersion":"What about your relationship with dozens of potential new clients?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3600.0,"y":625.0},"source":{"file":"resources.assets","pathId":"38964","byteOffset":29072160,"byteLength":376}},{"id":"DFr_E66619F5","articyId":"72057606922876739","type":"line","className":"DemeanorTemplate","speaker":"Clancy Pantermino","text":"So, you do speak commerce after all. It's true, being seen as benevolent can lead to an uptick in sales.","speakerId":"Ntt_CDA9F8FA","textSource":"localization","pronounText":{"TextHeVersion":"So, you do speak commerce after all. It's true, being seen as benevolent can lead to an uptick in sales.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3900.0,"y":375.0},"source":{"file":"resources.assets","pathId":"20305","byteOffset":15565848,"byteLength":412}},{"id":"DFr_9F033CC0","articyId":"72057606922876746","type":"line","className":"DemeanorTemplate","speaker":"Clancy Pantermino","text":"And even Corpsters can't resist a good sob story like this one.","speakerId":"Ntt_CDA9F8FA","textSource":"localization","pronounText":{"TextHeVersion":"And even Corpsters can't resist a good sob story like this one.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":4200.0,"y":375.0},"source":{"file":"resources.assets","pathId":"30414","byteOffset":19386728,"byteLength":408}},{"id":"DFr_F1001971","articyId":"72057606922876754","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"So you'll help?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"So you'll help?","TextSheVersion":"So you'll help?","TextTheyVersion":"So you'll help?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":4500.0,"y":375.0},"source":{"file":"resources.assets","pathId":"19460","byteOffset":15247376,"byteLength":324}},{"id":"DFr_E36EFDD4","articyId":"72057606922876761","type":"line","className":"DemeanorTemplate","speaker":"Clancy Pantermino","text":"Very well. I'll donate some prime advertising space. And will forward the donations once a week.","speakerId":"Ntt_CDA9F8FA","textSource":"localization","pronounText":{"TextHeVersion":"Very well. I'll donate some prime advertising space. And will forward the donations once a week.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":4800.0,"y":375.0},"source":{"file":"resources.assets","pathId":"40565","byteOffset":29675000,"byteLength":404}},{"id":"DFr_D7396B23","articyId":"72057606922876768","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Exactly.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Exactly.","TextSheVersion":"Exactly.","TextTheyVersion":"Exactly."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":4500.0,"y":625.0},"source":{"file":"resources.assets","pathId":"39802","byteOffset":29388064,"byteLength":348}},{"id":"DFr_3A4D7243","articyId":"72057606922876776","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"See? We all win.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"See? We all win.","TextSheVersion":"See? We all win.","TextTheyVersion":"See? We all win."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":5100.0,"y":375.0},"source":{"file":"resources.as