{"schemaVersion":2,"dialogueId":"Dlg_DFDB36C2","title":"Danny needs a new donut recipe","entry":"Dlg_DFDB36C2::entry","exit":"Dlg_DFDB36C2::exit","nodes":[{"id":"DFr_A719402D","articyId":"72057645577539158","type":"line","className":"DemeanorTemplate","speaker":"Danny Danetti","text":"Hey. HEY! It's you.","speakerId":"Ntt_BB92D958","textSource":"localization","pronounText":{"TextHeVersion":"Hey. HEY! It's you.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":3,"name":"Happy"},"position":{"x":0.0,"y":0.0},"source":{"file":"resources.assets","pathId":"46199","byteOffset":31808352,"byteLength":328}},{"id":"DFr_777E6AEC","articyId":"72057645577539172","type":"line","className":"DemeanorTemplate","speaker":"Danny Danetti","text":"Listen, I gotta ask you something. I have a donut... situation. A donut problem.","speakerId":"Ntt_BB92D958","textSource":"localization","pronounText":{"TextHeVersion":"Listen, I gotta ask you something. I have a donut... situation. A donut problem.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":600.0,"y":0.0},"source":{"file":"resources.assets","pathId":"45736","byteOffset":31633984,"byteLength":460}},{"id":"DFr_C0565DE6","articyId":"72057645577539200","type":"line","className":"DemeanorTemplate","speaker":"Danny Danetti","text":"I'm working on a... a project. But I can't get my gelatin to set on my macha mirror glaze and I can't afford more macha powder.","speakerId":"Ntt_BB92D958","textSource":"localization","pronounText":{"TextHeVersion":"I'm working on a... a project. But I can't get my gelatin to set on my macha mirror glaze and I can't afford more macha powder.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":1800.0,"y":0.0},"source":{"file":"resources.assets","pathId":"19428","byteOffset":15235024,"byteLength":436}},{"id":"DFr_DDDC8574","articyId":"72057645577539205","type":"line","className":"DemeanorTemplate","speaker":"Danny Danetti","text":"Cute! You're gonna hear me out though, right?","speakerId":"Ntt_BB92D958","textSource":"localization","pronounText":{"TextHeVersion":"Cute! You're gonna hear me out though, right?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1200.0,"y":250.0},"source":{"file":"resources.assets","pathId":"37561","byteOffset":28547608,"byteLength":392}},{"id":"DFr_AEC28B27","articyId":"72057645577539226","type":"line","className":"DemeanorTemplate","speaker":"Danny Danetti","text":"Harsh!","speakerId":"Ntt_BB92D958","textSource":"localization","pronounText":{"TextHeVersion":"Harsh!","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":6,"name":"Sad"},"position":{"x":2100.0,"y":500.0},"source":{"file":"resources.assets","pathId":"44004","byteOffset":30982192,"byteLength":316}},{"id":"DFr_9F1EAC0A","articyId":"72057645577539246","type":"line","className":"DemeanorTemplate","speaker":"Danny Danetti","text":"Hmm, maybe I should ask someone else. Dammit... Well, you want to know what my project is anyway?","speakerId":"Ntt_BB92D958","textSource":"localization","pronounText":{"TextHeVersion":"Hmm, maybe I should ask someone else. Dammit... Well, you want to know what my project is anyway?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2700.0,"y":-125.0},"source":{"file":"resources.assets","pathId":"38521","byteOffset":28907984,"byteLength":444}},{"id":"DFr_EA1857DD","articyId":"72057645577539289","type":"line","className":"DemeanorTemplate","speaker":"Danny Danetti","text":"Ah, you must be busy. Catch you later I guess.","speakerId":"Ntt_BB92D958","textSource":"localization","pronounText":{"Te