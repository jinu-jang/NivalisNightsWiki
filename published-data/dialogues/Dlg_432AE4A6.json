{"schemaVersion":2,"dialogueId":"Dlg_432AE4A6","title":"Reena drops by to help","entry":"Dlg_432AE4A6::entry","exit":"Dlg_432AE4A6::exit","nodes":[{"id":"DFr_B6663FB2","articyId":"72057606922875925","type":"line","className":"DemeanorTemplate","speaker":"Reena ‘The Radiance’ Coda","text":"There you are. There's something I'd like to tell you.","speakerId":"Ntt_3DAD828A","textSource":"localization","pronounText":{"TextHeVersion":"There you are. There's something I'd like to tell you.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":900.0,"y":375.0},"source":{"file":"resources.assets","pathId":"31453","byteOffset":19780864,"byteLength":400}},{"id":"DFr_19D8B1B9","articyId":"72057606922875932","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"I'm a little busy.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I'm a little busy.","TextSheVersion":"I'm a little busy.","TextTheyVersion":"I'm a little busy."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1200.0,"y":125.0},"source":{"file":"resources.assets","pathId":"25202","byteOffset":17416792,"byteLength":328}},{"id":"DFr_E1429F07","articyId":"72057606922875939","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"I have something to say too.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I have something to say too.","TextSheVersion":"I have something to say too.","TextTheyVersion":"I have something to say too."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1200.0,"y":375.0},"source":{"file":"resources.assets","pathId":"29012","byteOffset":18857800,"byteLength":336}},{"id":"DFr_7A11C305","articyId":"72057606922875946","type":"line","className":"DemeanorTemplate","speaker":"Reena ‘The Radiance’ Coda","text":"I will hear anything you have to say.","speakerId":"Ntt_3DAD828A","textSource":"localization","pronounText":{"TextHeVersion":"I will hear anything you have to say.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1500.0,"y":375.0},"source":{"file":"resources.assets","pathId":"37221","byteOffset":28422768,"byteLength":384}},{"id":"DFr_8A5A0C7C","articyId":"72057606922875953","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Your lights for Iann. They were amazing. Thank you!","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Your lights for Iann. They were amazing. Thank you!","TextSheVersion":"Your lights for Iann. They were amazing. Thank you!","TextTheyVersion":"Your lights for Iann. They were amazing. Thank you!"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1800.0,"y":375.0},"source":{"file":"resources.assets","pathId":"40709","byteOffset":29728808,"byteLength":360}},{"id":"DFr_76CDB9B1","articyId":"72057606922875960","type":"line","className":"DemeanorTemplate","speaker":"Reena ‘The Radiance’ Coda","text":"I was inspired by the boy's story. It is some of my finest work.","speakerId":"Ntt_3DAD828A","textSource":"localization","pronounText":{"TextHeVersion":"I was inspired by the boy's story. It is some of my finest work.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2100.0,"y":375.0},"source":{"file":"resources.assets","pathId":"43260","byteOffset":30694496,"byteLength":372}},{"id":"DFr_46A7BA7D","articyId":"72057606922875967","type":"line","className":"DemeanorTemplate","speaker":"Reena ‘The Radiance’ Coda","text":"And people noticed. I have been offered a contract to create a new artwork in a corporate headquarters.","speakerId":"Ntt_3DAD828A","textSource":"localization","pronounText":{"TextHeVersion":"And people noticed. I have been offered a contract to create a new artwork in a corporate headquarters.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":2400.0,"y":375.0},"source":{"file":"resources.assets","pathId":"48481","byteOffset":32676368,"byteLength":448}},{"id":"DFr_3F77044F","articyId":"72057606922875974","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"That's... good?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"That's... good?","TextSheVersion":"That's... good?","TextTheyVersion":"That's... good?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2700.0,"y":375.0},"source":{"file":"resources.assets","pathId":"43072","byteOffset":30624584,"byteLength":324}},{"id":"DFr_891DE2C3","articyId":"72057606922875981","type":"line","className":"DemeanorTemplate","speaker":"Reena ‘The Radiance’ Coda","text":"Yes. It's why I want to donate a further 200 Lims.","speakerId":"Ntt_3DAD828A","textSource":"localization","pronounText":{"TextHeVersion":"Yes. It's why I want to donate a further 200 Lims.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3000.0,"y":375.0},"source":{"file":"resources.assets","pathId":"19114","byteOffset":15117232,"byteLength":396}},{"id":"DFr_3BCDA7D4","articyId":"72057606922875988","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"I wish you didn't have to, but thanks.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I wish you didn't have to, but thanks.","TextSheVersion":"I wish you didn't have to, but thanks.","TextTheyVersion":"I wish you didn't have to, but thanks."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3300.0,"y":375.0},"source":{"file":"resources.assets","pathId":"49807","byteOffset":33186160,"byteLength":348}},{"id":"DFr_694BB7DB","articyId":"72057606922875995","type":"line","className":"DemeanorTemplate","speaker":"Reena ‘The Radiance’ Coda","text":"It is necessary. For both of us. I will see you in the lights.","speakerId":"Ntt_3DAD828A","textSource":"localization","pronounText":{"TextHeVersion":"It is necessary. For both of us. I will see you in the lights.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3600.0,"y":375.0},"source":{"file":"resources.assets","pathId":"42594","byteOffset":30442008,"byteLength":372}},{"id":"DFr_44EC58A8","articyId":"72057606922876007","type":"line","className":"DemeanorTemplate","speaker":"Reena ‘The Radiance’ Coda","text":"I simply came to say thank you.","speakerId":"Ntt_3DAD828A","textSource":"localization","pronounText":{"TextHeVersion":"I simply came to say thank you.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1500.0,"y":125.0},"source":{"file":"resources.assets","pathId":"34176","byteOffset":20812624,"byteLength":376}},{"id":"DFr_F05B3926","articyId":"72057606922876014","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Oh?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Oh?","TextSheVersion":"Oh?","TextTheyVersion":"Oh?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1800.0,"y":125.0},"source":{"file":"resources.assets","pathId":"49968","byteOffset":33245232,"byteLength":312}},{"id":"DFr_29BBE3E3","articyId":"72057606922876021","type":"line","className":"DemeanorTemplate","speaker":"Reena ‘The Radiance’ Coda","text":"You have seen the lights I created for the child?","speakerId":"Ntt_3DAD828A","textSource":"localization","pronounText":{"TextHeVersion":"You have seen the lights I created for the child?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2100.0,"y":125.0},"source":{"file":"resources.assets","pathId":"52496","byteOffset":34273088,"byteLength":360}},{"id":"DFr_1193E394","articyId":"72057606922876028","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"I did. They were good.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I did. They were good.","TextSheVersion":"I did. They were good.","TextTheyVersion":"I did. They were good."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2400.0,"y":125.0},"source":{"file":"resources.assets","pathId":"31344","byteOffset":19738184,"byteLength":332}},{"id":"DFr_56998AD6","articyId":"72057606922876036","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Gotta take paying work, I guess.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Gotta take paying work, I guess.","TextSheVersion":"Gotta take paying work, I guess.","TextTheyVersion":"Gotta take paying work, I guess."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2700.0,"y":125.0},"source":{"file":"resources.assets","pathId":"33087","byteOffset":20401040,"byteLength":340}},{"id":"DFr_5E5195D4","articyId":"72057606922876044","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Fair enough.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Fair enough.","TextSheVersion":"Fair enough.","TextTheyVersion":"Fair enough."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3300.0,"y":125.0},"source":{"file":"resources.assets","pathId":"18467","byteOffset":14873376,"byteLength":320}},{"id":"DFr_ACF412A1","articyId":"72057606922876053","type":"line","className":"DemeanorTemplate","speaker":"Reena ‘The Radiance’ Coda","text":"You - you're running a campaign to save the child, Iann.","speakerId":"Ntt_3DAD828A","textSource":"localization","pronounText":{"TextHeVersion":"You - you're running a campaign to save the child, Iann.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":900.0,"y":625.0},"source":{"file":"resources.assets","pathId":"20436","byteOffset":15613752,"byteLength":364}},{"id":"DFr_9439B88E","articyId":"72057606922876060","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"That's right. Do you want to donate?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"That's right. Do you want to donate?","TextSheVersion":"That's right. Do you want to donate?","TextTheyVersion":"That's right. Do you want to donate?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1200.0,"y":625.0},"source":{"file":"resources.assets","pathId":"52445","byteOffset":34254152,"byteLength":344}},{"id":"DFr_661C1173","articyId":"72057606922876067","type":"line","className":"DemeanorTemplate","speaker":"Reena ‘The Radiance’ Coda","text":"I'm an artist, I don't make a lot of money. But I can spare 50 Lims. Life is light.","speakerId":"Ntt_3DAD828A","textSource":"localization","pronounText":{"TextHeVersion":"I'm an artist, I don't make a lot of money. But I can spare 50 Lims. Life is light.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1500.0,"y":625.0},"source":{"file":"resources.assets","pathId":"34180","byteOffset":20814160,"byteLength":392}},{"id":"DFr_B879C3E2","articyId":"72057606922876079","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"That's very kind.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"That's very kind.","TextSheVersion":"That's very kind.","TextTheyVersion":"That's very kind."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2100.0,"y":625.0},"source":{"file":"resources.assets","pathId":"17781","byteOffset":14614712,"byteLength":328}},{"id":"DFr_1CC70C03","articyId":"72057606922876086","type":"line","className":"DemeanorTemplate","speaker":"Reena ‘The Radiance’ Coda","text":"If you had come to me sooner I could have helped more. I could have bathed Iann's name in lights and made the city take notice.","speakerId":"Ntt_3DAD828A","textSource":"localization","pronounText":{"TextHeVersion":"If you had come to me sooner I could have helped more. I could have bathed Iann's name in lights and made the city take notice.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2400.0,"y":625.0},"source":{"file":"resources.assets","pathId":"21521","byteOffset":16028600,"byteLength":436}},{"id":"DFr_C71DB9B1","articyId":"72057606922876093","type":"line","className":"DemeanorTemplate","speaker":"Reena ‘The Radiance’ Coda","text":"No time for that now, sadly. I have a work contract which begins tomorrow.","speakerId":"Ntt_3DAD828A","textSource":"localization","pronounText":{"TextHeVersion":"No time for that now, sadly. I have a work contract which begins tomorrow.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2700.0,"y":625.0},"source":{"file":"resources.assets","pathId":"29005","byteOffset":18855440,"byteLength":384}},{"id":"DFr_C758C2A7","articyId":"72057606922876100","type":"line","className":"DemeanorTemplate","speaker":"R