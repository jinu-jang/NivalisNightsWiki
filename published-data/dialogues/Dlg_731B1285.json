fied"},"position":{"x":4100.0,"y":175.0},"source":{"file":"resources.assets","pathId":"26979","byteOffset":18086984,"byteLength":320}},{"id":"DFr_345C613B","articyId":"72057606922872543","type":"line","className":"DemeanorTemplate","speaker":"Idlehands","text":"A little boy you say?","speakerId":"Ntt_52277EAC","textSource":"localization","pronounText":{"TextHeVersion":"A little boy you say?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":4400.0,"y":175.0},"source":{"file":"resources.assets","pathId":"41861","byteOffset":30164416,"byteLength":332}},{"id":"DFr_B7A1FA1A","articyId":"72057606922872550","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Eight years old. Good family, and he's running out of time.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Eight years old. Good family, and he's running out of time.","TextSheVersion":"Eight years old. Good family, and he's running out of time.","TextTheyVersion":"Eight years old. Good family, and he's running out of time."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":4700.0,"y":175.0},"source":{"file":"resources.assets","pathId":"20650","byteOffset":15697112,"byteLength":368}},{"id":"DFr_A73B6C53","articyId":"72057606922872557","type":"line","className":"DemeanorTemplate","speaker":"Idlehands","text":"Didn't have nobody worrying about me when I was eight... but maybe that was the problem, ya know?","speakerId":"Ntt_52277EAC","textSource":"localization","pronounText":{"TextHeVersion":"Didn't have nobody worrying about me when I was eight... but maybe that was the problem, ya know?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":6,"name":"Sad"},"position":{"x":5000.0,"y":175.0},"source":{"file":"resources.assets","pathId":"47397","byteOffset":32267520,"byteLength":408}},{"id":"DFr_AD11B4DC","articyId":"72057606922872564","type":"line","className":"DemeanorTemplate","speaker":"Idlehands","text":"Once knew a kid who drowned. He was my friend. Bud Mallignagi. I remember them trying to pump the water out his lungs at the dock.","speakerId":"Ntt_52277EAC","textSource":"localization","pronounText":{"TextHeVersion":"Once knew a kid who drowned. He was my friend. Bud Mallignagi. I remember them trying to pump the water out his lungs at the dock.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":5300.0,"y":175.0},"source":{"file":"resources.assets","pathId":"22773","byteOffset":16500096,"byteLength":440}},{"id":"DFr_003D65E8","articyId":"72057606922872571","type":"line","className":"DemeanorTemplate","speaker":"Idlehands","text":"Didn't work. He was down there too long. Bad noises man. A real bad scene.","speakerId":"Ntt_52277EAC","textSource":"localization","pronounText":{"TextHeVersion":"Didn't work. He was down there too long. Bad noises man. A real bad scene.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":5600.0,"y":175.0},"source":{"file":"resources.assets","pathId":"32293","byteOffset":20096680,"byteLength":384}},{"id":"DFr_EAA5325C","articyId":"72057606922872578","type":"line","className":"DemeanorTemplate","speaker":"Idlehands","text":"I'm not completely heartless, ya know...? I can do it for 40,000. That's me selling at cost, and taking on a lot of risk without an extra charge.","speakerId":"Ntt_52277EAC","textSource":"localization","pronounText":{"TextHeVersion":"I'm not completely heartless, ya know...? I can do it for 40,000. That's me selling at cost, and taking on a lot of risk without an extra charge.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":5900.0,"y":175.0},"source":{"file":"resources.assets","pathId":"44712","byteOffset":31247288,"byteLength":492}},{"id":"DFr_3B175200","articyId":"72057606922872585","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"I didn't expect you to actually help.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I didn't expect you to actually help.","TextSheVersion":"I didn't expect you to actually help.","TextTheyVersion":"I didn't expect you to actually help."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":6200.0,"y":300.0},"source":{"file":"resources.assets","pathId":"20736","byteOffset":15729480,"byteLength":348}},{"id":"DFr_F681CFC1","articyId":"72057606922872592","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"You'd really do that?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"You'd really do that?","TextSheVersion":"You'd really do that?","TextTheyVersion":"You'd really do that?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":6200.0,"y":50.0},"source":{"file":"resources.assets","pathId":"49134","byteOffset":32928728,"byteLength":332}},{"id":"DFr_7A8D98AA","articyId":"72057606922872599","type":"line","className":"DemeanorTemplate","speaker":"Idlehands","text":"Listen, I know what I am, but no one else does. Not really.","speakerId":"Ntt_52277EAC","textSource":"localization","pronounText":{"TextHeVersion":"Listen, I know what I am, but no one else does. Not really.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":6500.0,"y":175.0},"source":{"file":"resources.assets","pathId":"33741","byteOffset":20648888,"byteLength":368}},{"id":"DFr_C63580A8","articyId":"72057606922872607","type":"line","className":"DemeanorTemplate","speaker":"Idlehands","text":"Yeah, hard to find any one person who can afford the full 40k. You're gonna have to pool your resources. What's it called - crowdfund. Now get outta here, and come back with the cash.","speakerId":"Ntt_52277EAC","textSource":"localization","pronounText":{"TextHeVersion":"Yeah, hard to find any one person who can afford the full 40k. You're gonna have to pool your resources. What's it called - crowdfund. Now get outta here, and come back with the cash.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":7700.0,"y":175.0},"source":{"file":"resources.assets","pathId":"38278","byteOffset":28816664,"byteLength":492}},{"id":"DFr_FF12BC28","articyId":"72057606922872614","type":"line","className":"DemeanorTemplate","speaker":"Idlehands","text":"I don't take new customers.","speakerId":"Ntt_52277EAC","textSource":"localization","pronounText":{"TextHeVersion":"I don't take new customers.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":2,"name":"Upset"},"position":{"x":800.0,"y":550.0},"source":{"file":"resources.assets","pathId":"30649","byteOffset":19475776,"byteLength":336}},{"id":"DFr_2B027B30","articyId":"72057606922872621","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"I'm not a customer. Vik sent me.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I'm not a customer. Vik sent me.","TextSheVersion":"I'm not a customer. Vik sent me.","TextTheyVersion":"I'm not a customer. Vik sent me."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1100.0,"y":550.0},"source":{"file":"resources.assets","pathId":"28726","byteOffset":18750280,"byteLength":340}},{"id":"DFr_9F9AEFCC","articyId":"72057606922872628","type":"line","className":"DemeanorTemplate","speaker":"Idlehands","text":"Does he want to apologize?","speakerId":"Ntt_52277EAC","textSource":"localization","pronounText":{"TextHeVersion":"Does he want to apologize?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1400.0,"y":550.0},"source":{"file":"resources.assets","pathId":"46800","byteOffset":32035896,"byteLength":336}},{"id":"DFr_A1645580","articyId":"72057606922872635","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Uh, sure.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Uh, sure.","TextSheVersion":"Uh, sure.","TextTheyVersion":"Uh, sure."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1700.0,"y":550.0},"source":{"file":"resources.assets","pathId":"24597","byteOffset":17182088,"byteLength":320}},{"id":"DFr_F004BB32","articyId":"72057606922872643","type":"line","className":"DemeanorTemplate","speaker":"Idlehands","text":"Hehe. Good joke. I appreciate the humor. Now really, what do you want?","speakerId":"Ntt_52277EAC","textSource":"localization","pronounText":{"TextHeVersion":"Hehe. Good joke. I appreciate the humor. Now really, what do you want?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":2000.0,"y":300.0},"source":{"file":"resources.assets","pathId":"43251","byteOffset":30691392,"byteLength":380}},{"id":"DFr_1674D73E","articyId":"72057606922872651","type":"line","className":"DemeanorTemplate","speaker":"Idlehands","text":"No one gets me, and that is fine. If people did, they'd know I ain't the worst here. Not by a long shot.","speakerId":"Ntt_52277EAC","textSource":"localization","pronounText":{"TextHeVersion":"No one gets me, and that is fine. If people did, they'd know I ain't the worst here. Not by a long shot.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[