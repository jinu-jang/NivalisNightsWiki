{"schemaVersion":2,"dialogueId":"Dlg_3A9DFA1D","title":"Hide Gan","entry":"Dlg_3A9DFA1D::entry","exit":"Dlg_3A9DFA1D::exit","nodes":[{"id":"DFr_22B74CDB","articyId":"72057615512784480","type":"line","className":"DialogueFragment","speaker":"Ceres Coilson","text":"Did you find him?","speakerId":"Ntt_50CC216A","textSource":"localization","pronounText":{"TextHeVersion":"Did you find him?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":475.0,"y":600.0},"source":{"file":"resources.assets","pathId":"25585","byteOffset":17564176,"byteLength":300}},{"id":"DFr_07E6CA23","articyId":"72057615512784486","type":"choice","className":"DialogueFragment","speaker":"Player","text":"I looked everywhere, but found nothing.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I looked everywhere, but found nothing.","TextSheVersion":"I looked everywhere, but found nothing.","TextTheyVersion":"I looked everywhere, but found nothing."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":775.0,"y":600.0},"source":{"file":"resources.assets","pathId":"22242","byteOffset":16299584,"byteLength":320}},{"id":"DFr_1D5FA8B8","articyId":"72057615512784494","type":"line","className":"DialogueFragment","speaker":"Ceres Coilson","text":"You wouldn't lie to me would you? I know what you floor-levels can be like. Tricky little buggers.","speakerId":"Ntt_50CC216A","textSource":"localization","pronounText":{"TextHeVersion":"You wouldn't lie to me would you? I know what you floor-levels can be like. Tricky little buggers.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1350.0,"y":600.0},"source":{"file":"resources.assets","pathId":"41760","byteOffset":30126568,"byteLength":416}},{"id":"DFr_0A8AB161","articyId":"72057615512784501","type":"choice","className":"DialogueFragment","speaker":"Player","text":"Nope, I abs