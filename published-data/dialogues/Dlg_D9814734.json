{"schemaVersion":2,"dialogueId":"Dlg_D9814734","title":"Lynnphora find out more about Eugene","entry":"Dlg_D9814734::entry","exit":"Dlg_D9814734::exit","nodes":[{"id":"DFr_A024416A","articyId":"72057615512917558","type":"line","className":"DialogueFragment","speaker":"Lynnphora Adams","text":"Oh I'm sorry looks like you've run into me again!","speakerId":"Ntt_F651C091","textSource":"localization","pronounText":{"TextHeVersion":"Oh I'm sorry looks like you've run into me again!","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":300.0,"y":475.0},"source":{"file":"resources.assets","pathId":"34387","byteOffset":20891936,"byteLength":332}},{"id":"DFr_75C69943","articyId":"72057615512917565","type":"choice","className":"DialogueFragment","speaker":"Player","text":"You apologize a lot.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"You apologize a lot.","TextSheVersion":"You apologize a lot.","TextTheyVersion":"You apologize a lot."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":600.0,"y":475.0},"source":{"file":"resources.assets","pathId":"18477","byteOffset":14876944,"byteLength":300}},{"id":"DFr_A9968AF8","articyId":"72057615512917572","type":"line","className":"DialogueFragment","speaker":"Lynnphora Adams","text":"Do I? I'm sorry!","speakerId":"Ntt_F651C091","textSource":"localization","pronounText":{"TextHeVersion":"Do I? I'm sorry!","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":900.0,"y":475.0},"source":{"file":"resources.assets","pathId":"19971","byteOffset":15439704,"byteLength":332}},{"id":"DFr_BD27F13A","articyId":"72057615512917579","type":"choice","className":"DialogueFragment","speaker":"Player","text":"Still carrying the urn then?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Still carrying the urn then?","TextSheVersion":"Still carrying the urn then?","TextTheyVersion":"Still carrying the urn then?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1200.0,"y":350.0},"source":{"file":"resources.assets","pathId":"21866","byteOffset":16160880,"byteLength":308}},{"id":"DFr_60C92706","articyId":"72057615512917586","type":"line","className":"DialogueFragment","speaker":"Lynnphora Adams","text":"Of course, so naive of me to think I might actually make a choice.","speakerId":"Ntt_F651C091","textSource":"localization","pronounText":{"TextHeVersion":"Of course, so naive of me to think I might actually make a choice.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1500.0,"y":350.0},"source":{"file":"resources.assets","pathId":"23116","byteOffset":16630656,"byteLength":384}},{"id":"DFr_7ADF018A","articyId":"72057615512917593","type":"choice","className":"DialogueFragment","speaker":"Player","text":"These things take time.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"These things take time.","TextSheVersion":"These things take time.","TextTheyVersion":"These things take time."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1800.0,"y":350.0},"source":{"file":"resources.assets","pathId":"20235","byteOffset":15540568,"byteLength":304}},{"id":"DFr_33DCDAB0","articyId":"72057615512917600","type":"choice","className":"DialogueFragment","speaker":"Player","text":"It is a little silly really.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"It is a little silly really.","TextSheVersion":"It is a little silly really.","TextTheyVersion":"It is a little silly really."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1800.0,"y":600.0},"source":{"file":"resources.assets","pathId":"40583","byteOffset":29682040,"byteLength":308}},{"id":"DFr_D51CD1DC","articyId":"72057615512917617","type":"line","className":"DialogueFragment","speaker":"Lynnphora Adams","text":"Yep. You're right. Of course you are. I'm not sure if I'm being sentimental or just lazy.","speakerId":"Ntt_F651C091","textSource":"localization","pronounText":{"TextHeVersion":"Yep. You're right. Of course you are. I'm not sure if I'm being sentimental or just lazy.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":2375.0,"y":475.0},"source":{"file":"resources.assets","pathId":"39307","byteOffset":29201312,"byteLength":372}},{"id":"DFr_C04394AF","articyId":"72057615512917625","type":"choice","className":"DialogueFragment","speaker":"Player","text":"Anything else you can tell me about what Eugene might have liked?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Anything else you can tell me about what Eugene might have liked?","TextSheVersion":"Anything else you can tell me about what Eugene might have liked?","TextTheyVersion":"Anything else you can tell me about what Eugene might have liked?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":2675.0,"y":475.0},"source":{"file":"resources.assets","pathId":"45164","byteOffset":31420400,"byteLength":348}},{"id":"DFr_5041102C","articyId":"72057615512917632","type":"line","className":"DialogueFragment","speaker":"Lynnphora Adams","text":"He used to love the water. Often if we were walking and saw water, he'd just run straight in. I didn't mind, but sometimes the smell was awful. Funny really.","speakerId":"Ntt_F651C091","textSource":"localization","pronounText":{"TextHeVersion":"He used to love the water. Often if we were walking and saw water, he'd just run straight in. I didn't mind, but sometimes the smell was awful. Funny really.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":2975.0,"y":450.0},"source":{"file":"resources.assets","pathId":"20319","byteOffset":15570984,"byteLength":440}},{"id":"DFr_0F0D2FC3","articyId":"72057615512917639","type":"choice","className":"DialogueFragment","speaker":"Player","text":"Maybe you should scatter the ashes in the water?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Maybe you should scatter the ashes in the water?","TextSheVersion":"Maybe you should scatter the ashes in the water?","TextTheyVersion":"Maybe you should scatter the ashes in the water?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":3300.0,"y":475.0},"source":{"file":"resources.assets","pathId":"40934","byteOffset":29813032,"byteLength":328}},{"id":"DFr_635585AF","articyId":"72057615512917652","type":"line","className":"DialogueFragment","speaker":"Lynnphora Adams","text":"I've thought about it many times. Thing is, with him being mostly ash now, I don't know how the water thing sits with me. Will he float? It's hard to swim when you're ash.","speakerId":"Ntt_F651C091","textSource":"localization","pronounText":{"TextHeVersion":"I've thought about it many times. Thing is, with him being mostly ash now, I don't know how the water thing sits with me. Will he float? It's hard to swim when you're ash.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":3600.0,"y":450.0},"source":{"file":"resources.assets","pathId":"32878","byteOffset":20322712,"byteLength":488}},{"id":"DFr_016522A6","articyId":"72057615512917659","type":"choice","className":"DialogueFragment","speaker":"Player","text":"I see your point...","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I see your point...","TextSheVersion":"I see your point...","TextTheyVersion":"I see your point..."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":3950.0,"y":400.0},"source":{"file":"resources.assets","pathId":"40387","byteOffset":29607856,"byteLength":300}},{"id":"DFr_989ACBF3","articyId":"72057615512917666","type":"choice","className":"DialogueFragment","speaker":"Player","text":"He's already dead lady.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"He's already dead lady.","TextSheVersion":"He's already dead lady.","TextTheyVersion":"He's already dead lady."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":3950.0,"y":650.0},"source":{"file":"resources.assets","pathId":"37701","byteOffset":28599952,"byteLength":304}},{"id":"DFr_01B74B70","articyId":"72057615512917683","type":"line","className":"DialogueFragment","speaker":"Lynnphora Adams","text":"Oh I'm sorry, I must have sounded very odd. Yes I remember he's dead. I just feel awful that my conundrum is now your conundrum.","speakerId":"Ntt_F651C091","textSource":"localization","pronounText":{"TextHeVersion":"Oh I'm sorry, I must have sounded very odd. Yes I remember he's dead. I just feel awful that my conundrum is now your conundrum.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":4550.0,"y":650.0},"source":{"file":"resources.assets","pathId":"22440","byteOffset":16374120,"byteLength":444}},{"id":"DFr_6FDA0512","articyId":"72057615512917690","type":"line","className":"DialogueFragment","speaker":"Lynnphora Adams","text":"It's a really tough one isn't it. I just feel awful that my conundrum is now your conundrum.","speakerId":"Ntt_F651C091","textSource":"localization","pronounText":{"TextHeVersion":"It's a really tough one isn't it. I just feel awful that my conundrum is now your conundrum.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":4550.0,"y":400.0},"source":{"file":"resources.assets","pathId":"51907","byteOffset":34052400,"byteLength":408}},{"id":"DFr_6F5392B7","articyId":"72057615512917697","type":"choice","className":"DialogueFragment","speaker":"Player","text":"I won't be losing sleep over it.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I won't be losing sleep over it.","TextSheVersion":"I won't be losing sleep over it.","TextTheyVersion":"I won't be losing sleep over it."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":4850.0,"y":650.0},"source":{"file":"resources.assets","pathId":"21748","byteOffset":16117704,"byteLength":312}},{"id":"DFr_C56524AC","articyId":"72057615512917703","type":"choice","className":"DialogueFragment","speaker":"Player","text":"Sharing the load can help!","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Sharing the load can help!","TextSheVersion":"Sharing the load can help!","TextTheyVersion":"Sharing the load can help!"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":4850.0,"y":400.0},"source":{"file":"resources.assets","pathId":"44309","byteOffset":31095520,"byteLength":308}},{"id":"DFr_C8E16CB0","articyId":"72057615512917723","type":"line","className":"DialogueFragment","speaker":"Lynnphora Adams","text":"You've given me a lot to think about. I hope we get to meet again... I mean if that's ok? No worries if not.","speakerId":"Ntt_F651C091","textSource":"localization","pronounText":{"TextHeVersion":"You've given me a lot to think about. I hope we get to meet again... I mean if that's ok? No worries if not.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":5425.0,"y":525.0},"source":{"file":"resources.assets","pathId":"19573","byteOffset":15287992,"byteLength":388}},{"id":"DFr_F83A877C","articyId":"72057821671325057","type":"choice","className":"DialogueFragment","speaker":"Player","text":"Hello Eugene!","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Hello Eugene!","TextSheVersion":"Hello Eugene!","TextTheyVersion":"Hello Eugene!"},"effects":[],"