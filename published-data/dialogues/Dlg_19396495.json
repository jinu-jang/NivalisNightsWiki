{"schemaVersion":2,"dialogueId":"Dlg_19396495","title":"Good Morning","entry":"Dlg_19396495::entry","exit":"Dlg_19396495::exit","nodes":[{"id":"DFr_EB164A9D","articyId":"72057718591979534","type":"line","className":"DemeanorTemplate","speaker":"Ava","text":"Good morning! You are currently running late for your meeting with Thaddeus Carminus.","speakerId":"Ntt_DC270F89","textSource":"localization","pronounText":{"TextHeVersion":"Good morning! You are currently running late for your meeting with Thaddeus Carminus.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":875.0,"y":275.0},"source":{"file":"resources.assets","pathId":"41849","byteOffset":30160104,"byteLength":436}},{"id":"DFr_55C396EC","articyId":"72057606922883004","type":"line","className":"DemeanorTemplate","speaker":"Ava","text":"It's time to come home. This is your apartment. The sounds of the nightclubs nearby are the heartbeat of the city.","speakerId":"Ntt_DC270F89","textSource":"localization","pronounText":{"TextHeVersion":"It's time to come home. This is your apartment. The sounds of the nightclubs nearby are the heartbeat of the city.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":800.0,"y":525.0},"source":{"file":"resources.assets","pathId":"25057","byteOffset":17362496,"byteLength":440}},{"id":"DFr_360BC4A6","articyId":"72057718591979522","type":"line","className":"DialogueFragment","speaker":"Ava","text":"They say when you hear your name in a dream, you wake up. Did you hear me call your name?","speakerId":"Ntt_DC270F89","textSource":"localization","pronounText":{"TextHeVersion":"They say when you hear your name in a dream, you wake up. Did you hear me call your name?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":200.0,"y":300.0},"sour