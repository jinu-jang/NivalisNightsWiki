TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":4100.0,"y":-175.0},"source":{"file":"resources.assets","pathId":"26019","byteOffset":17724920,"byteLength":456}},{"id":"DFr_5704547E","articyId":"72057606922862971","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"I don't like where this is going.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I don't like where this is going.","TextSheVersion":"I don't like where this is going.","TextTheyVersion":"I don't like where this is going."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":4400.0,"y":-175.0},"source":{"file":"resources.assets","pathId":"25914","byteOffset":17686064,"byteLength":344}},{"id":"DFr_179759EB","articyId":"72057606922862978","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"So you just wanted to warn me?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"So you just wanted to warn me?","TextSheVersion":"So you just wanted to warn me?","TextTheyVersion":"So you just wanted to warn me?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":4400.0,"y":-425.0},"source":{"file":"resources.assets","pathId":"31452","byteOffset":19780520,"byteLength":340}},{"id":"DFr_FB686352","articyId":"72057606922862985","type":"line","className":"DemeanorTemplate","speaker":"Ceres Coilson","text":"For your own safety, don't tell anybody that you ever heard the name Gan Coilson.","speakerId":"Ntt_50CC216A","textSource":"localization","pronounText":{"TextHeVersion":"For your own safety, don't tell anybody that you ever heard the name Gan Coilson.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":6,"name":"Sad"},"position":{"x":4700.0,"y":-175.0},"source":{"file":"resources.assets","pathId":"51595","byteOffset":33935584,"byteLength":428}},{"id":"DFr_FD562BA0","articyId":"72057606922862993","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Is it connected with him having been CTO at LifeCorp?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Is it connected with him having been CTO at LifeCorp?","TextSheVersion":"Is it connected with him having been CTO at LifeCorp?","TextTheyVersion":"Is it connected with him having been CTO at LifeCorp?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":5000.0,"y":-425.0},"source":{"file":"resources.assets","pathId":"40873","byteOffset":29790096,"byteLength":384}},{"id":"DFr_EF0CC8A5","articyId":"72057606922863000","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"I promise.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I promise.","TextSheVersion":"I promise.","TextTheyVersion":"I promise."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":5000.0,"y":-175.0},"source":{"file":"resources.assets","pathId":"32486","byteOffset":20172992,"byteLength":320}},{"id":"DFr_350A8974","articyId":"72057606922863044","type":"line","className":"DemeanorTemplate","speaker":"Ceres Coilson","text":"You must listen to me if you value your comfortable life here in Nivalis.","speakerId":"Ntt_50CC216A","textSource":"localization","pronounText":{"TextHeVersion":"You must listen to me if you value your comfortable life here in Nivalis.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2600.0,"y":300.0},"source":{"file":"resources.assets","pathId":"29831","byteOffset":19166936,"byteLength":384}},{"id":"DFr_C5FD945A","articyId":"72057606922863051","type":"choice","className":"DemeanorTemplate","speaker":