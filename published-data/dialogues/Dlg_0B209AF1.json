{"schemaVersion":2,"dialogueId":"Dlg_0B209AF1","title":"Danny has more donut questions","entry":"Dlg_0B209AF1::entry","exit":"Dlg_0B209AF1::exit","nodes":[{"id":"DFr_78D24BDC","articyId":"72057645577539412","type":"line","className":"DemeanorTemplate","speaker":"Danny Danetti","text":"Hey! My donuts came out great!","speakerId":"Ntt_BB92D958","textSource":"localization","pronounText":{"TextHeVersion":"Hey! My donuts came out great!","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":0.0,"y":0.0},"source":{"file":"resources.assets","pathId":"20583","byteOffset":15670784,"byteLength":340}},{"id":"DFr_103D4D87","articyId":"72057645577539426","type":"line","className":"DemeanorTemplate","speaker":"Danny Danetti","text":"You remember the flavor right?","speakerId":"Ntt_BB92D958","textSource":"localization","pronounText":{"TextHeVersion":"You remember the flavor right?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":600.0,"y":0.0},"source":{"file":"resources.assets","pathId":"28537","byteOffset":18679648,"byteLength":412}},{"id":"DFr_BF9FC70C","articyId":"72057645577539454","type":"line","className":"DemeanorTemplate","speaker":"Danny Danetti","text":"Oh come on! It was the Matcha one, remember? Anyway, it came out great.","speakerId":"Ntt_BB92D958","textSource":"localization","pronounText":{"TextHeVersion":"Oh come on! It was the Matcha one, remember? Anyway, it came out great.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":4,"name":"Shocked"},"position":{"x":1200.0,"y":-125.0},"source":{"file":"resources.assets","pathId":"20155","byteOffset":15510576,"byteLength":380}},{"id":"DFr_D8B47E0C","articyId":"72057645577539462","type":"line","className":"DemeanorTemplate","speaker":"Danny Danetti","text":"Yes! Nice catch. You were listening. Anyway, it came out great. I think it's my best yet.","speakerId":"Ntt_BB92D958","textSource":"localization","pronounText":{"TextHeVersion":"Yes! Nice catch. You were listening. Anyway, it came out great. I think it's my best yet.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":3,"name":"Happy"},"position":{"x":1500.0,"y":250.0},"source":{"file":"resources.assets","pathId":"31732","byteOffset":19885872,"byteLength":400}},{"id":"DFr_0AE5799D","articyId":"72057645577539482","type":"line","className":"DemeanorTemplate","speaker":"Danny Danetti","text":"Not yet my friend! But we are getting close. I can feel it. Listen, can I get your opinion for a minute? I got three flavor profiles I need to explore. Wanna hear them?","speakerId":"Ntt_BB92D958","textSource":"localization","pronounText":{"TextHeVersion":"Not yet my friend! But we are getting close. I can feel it. Listen, can I get your opinion for a minute? I got three flavor profiles I need to explore. Wanna hear them?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2100.0,"y":-125.0},"source":{"file":"resources.assets","pathId":"17100","byteOffset":14359712,"byteLength":512}},{"id":"DFr_6B0884B0","articyId":"72057645577539502","type":"line","className":"DemeanorTemplate","speaker":"Danny Danetti","text":"Oh for real? Maybe I caught you at a bad time or something. I'll uh... see you around. I guess.","speakerId":"Ntt_BB92D958","textSource":"localization","pronounText":{"TextHeVersion":"Oh for real? Maybe I caught you at a bad time or something. I'll uh... see you around. I guess.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":6,"name":"Sad"},"position":{"x":2700.0,"y":125.0},"source":{"file":"resources.assets","pathId":"31103","byteOffset":19648000,"byteLength":404}},{"id":"DFr_323B41C5","articyId":"72057645