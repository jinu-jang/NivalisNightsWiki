{"schemaVersion":2,"dialogueId":"Dlg_3B3983AC","title":"Talk to Agent Teleshenko","entry":"Dlg_3B3983AC::entry","exit":"Dlg_3B3983AC::exit","nodes":[{"id":"DFr_546B2396","articyId":"72057606922877348","type":"line","className":"DemeanorTemplate","speaker":"Agent Teleshko","text":"You. I know what you've been doing and I don't like it.","speakerId":"Ntt_2B1C9A1E","textSource":"localization","pronounText":{"TextHeVersion":"You. I know what you've been doing and I don't like it.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":2,"name":"Upset"},"position":{"x":700.0,"y":450.0},"source":{"file":"resources.assets","pathId":"40031","byteOffset":29474104,"byteLength":400}},{"id":"DFr_C9F5B421","articyId":"72057606922877355","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"What have I been doing?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"What have I been doing?","TextSheVersion":"What have I been doing?","TextTheyVersion":"What have I been doing?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1000.0,"y":325.0},"source":{"file":"resources.assets","pathId":"43914","byteOffset":30947728,"byteLength":332}},{"id":"DFr_C7FE5D2E","articyId":"72057606922877362","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"I feel just the same about you.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I feel just the same about you.","TextSheVersion":"I feel just the same about you.","TextTheyVersion":"I feel just the same about you."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1000.0,"y":575.0},"source":{"file":"resources.assets","pathId":"29630","byteOffset":19089936,"byteLength":340}},{"id":"DFr_B38B5D22","articyId":"72057606922877369","type":"line","className":"DemeanorTemplate","speaker":"Agent Teleshko","text":"You've been doing charity.","speakerId":"Ntt_2B1C9A1E","textSource":"localization","pronounText":{"TextHeVersion":"You've been doing charity.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":4,"name":"Shocked"},"position":{"x":1300.0,"y":450.0},"source":{"file":"resources.assets","pathId":"31013","byteOffset":19614840,"byteLength":376}},{"id":"DFr_BC7D0DDC","articyId":"72057606922877377","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Says who?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Says who?","TextSheVersion":"Says who?","TextTheyVersion":"Says who?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1600.0,"y":450.0},"source":{"file":"resources.assets","pathId":"44160","byteOffset":31040848,"byteLength":320}},{"id":"DFr_FA5F0E1E","articyId":"72057606922877384","type":"line","className":"DemeanorTemplate","speaker":"Agent Teleshko","text":"Don't play stupid. It's all over the Nets.","speakerId":"Ntt_2B1C9A1E","textSource":"localization","pronounText":{"TextHeVersion":"Don't play stupid. It's all over the Nets.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":2,"name":"Upset"},"position":{"x":1900.0,"y":450.0},"source":{"file":"resources.assets","pathId":"52277","byteOffset":34191112,"byteLength":388}},{"id":"DFr_32F4D66C","articyId":"72057606922877391","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"So tell me, how exactly would a dead child be good for business?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"So tell me, how exactly would a dead child be good for business?","TextSheVersion":"So tell me, how exactly would a dead child be good for business?","TextTheyVersion":"So tell me, how exactly would a dead child be good for business?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2200.0,"y":325.0},"source":{"file":"resources.assets","pathId":"43355","byteOffset":30731000,"byteLength":372}},{"id":"DFr_B8F9B451","articyId":"72057606922877398","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"So, I can count on your donation?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"So, I can count on your donation?","TextSheVersion":"So, I can count on your donation?","TextTheyVersion":"So, I can count on your donation?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2200.0,"y":575.0},"source":{"file":"resources.assets","pathId":"30099","byteOffset":19266280,"byteLength":344}},{"id":"DFr_C34AC28A","articyId":"72057606922877405","type":"line","className":"DemeanorTemplate","speaker":"Agent Teleshko","text":"Charity is the scourge of ambition. If McKenna had worked harder to achieve he would be able to afford what he needs.","speakerId":"Ntt_2B1C9A1E","textSource":"localization","pronounText":{"TextHeVersion":"Charity is the scourge of ambition. If McKenna had worked harder to achieve he would be able to afford what he needs.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2500.0,"y":325.0},"source":{"file":"resources.assets","pathId":"18969","byteOffset":15063440,"byteLength":428}},{"id":"DFr_42201342","articyId":"72057606922877412","type":"line","className":"DemeanorTemplate","speaker":"Agent Teleshko","text":"Sarcasm has been known to harm a business. Or kill it altogether.","speakerId":"Ntt_2B1C9A1E","textSource":"localization","pronounText":{"TextHeVersion":"Sarcasm has been known to harm a business. Or kill it altogether.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":2500.0,"y":575.0},"source":{"file":"resources.assets","pathId":"44418","byteOffset":31134712,"byteLength":376}},{"id":"DFr_01E3C88F","articyId":"72057606922877420","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"By that logic, if the child lives, they might achieve great things. And generate millions of Lims.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"By that logic, if the child lives, they might achieve great things. And generate millions of Lims.","TextSheVersion":"By that logic, if the child lives, they might achieve great things. And generate millions of Lims.","TextTheyVersion":"By that logic, if the child lives, they might achieve great things. And generate millions of Lims."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2800.0,"y":450.0},"source":{"file":"resources.assets","pathId":"27571","byteOffset":18312152,"byteLength":408}},{"id":"DFr_47106336","articyId":"72057606922877427","type":"line","className":"DemeanorTemplate","speaker":"Agent Teleshko","text":"Not by my predictions. And it's about the principle of the thing.","speakerId":"Ntt_2B1C9A1E","textSource":"localization","pronounText":{"TextHeVersion":"Not by my predictions. And it's about the principle of the thing.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3100.0,"y":450.0},"source":{"file":"resources.assets","pathId":"42424","byteOffset":30377008,"byteLength":376}},{"id":"DFr_071FAD1D","articyId":"72057606922877434","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Do you have a family, Agent T?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Do you have a family, Agent T?","TextSheVersion":"Do you have a family, Agent T?","TextTheyVersion":"Do you have a family, Agent T?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3400.0,"y":450.0},"source":{"file":"resources.assets","pathId":"21596","byteOffset":16059312,"byteLength":340}},{"id":"DFr_AF3E144D","articyId":"72057606922877441","type":"line","className":"DemeanorTemplate","speaker":"Agent Teleshko","text":"My domestic situation is of no relevance.","speakerId":"Ntt_2B1C9A1E","textSource":"localization","pronounText":{"TextHeVersion":"My domestic situation is of no relevance.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3700.0,"y":450.0},"source":{"file":"resources.assets","pathId":"29874","byteOffset":19182880,"byteLength":352}},{"id":"DFr_D947827F","articyId":"72057606922877448","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"If your kid was sick, I would do the same for them.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"If your kid was sick, I would do the same for them.","TextSheVersion":"If your kid was sick, I would do the same for them.","TextTheyVersion":"If your kid was sick, I would do the same for them."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":4000.0,"y":450.0},"source":{"file":"resources.assets","pathId":"29280","byteOffset":18957776,"byteLength":360}},{"id":"DFr_D5CDCB33","articyId":"72057606922877455","type":"line","className":"DemeanorTemplate","speaker":"Agent Teleshko","text":"I have no time for thought experiments. When I return, I expect this whole thing to be forgotten.","speakerId":"Ntt_2B1C9A1E","textSource":"localization","pronounText":{"TextHeVersion":"I have no time for thought experiments. When I return, I expect this whole thing to be forgotten.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":2,"name":"Upset"},"position":{"x":43