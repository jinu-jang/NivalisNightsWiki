{"schemaVersion":2,"dialogueId":"Dlg_9A3ECCCE","title":"Money from Razlo","entry":"Dlg_9A3ECCCE::entry","exit":"Dlg_9A3ECCCE::exit","nodes":[{"id":"DFr_93D4B84B","articyId":"72057791606429674","type":"line","className":"DemeanorTemplate","speaker":"Razlo","text":"So, you're back. Didn't think it would take you long to come sniffing around for your money.","speakerId":"Ntt_914F2AC5","textSource":"localization","pronounText":{"TextHeVersion":"So, you're back. Didn't think it would take you long to come sniffing around for your money.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":2,"name":"Upset"},"position":{"x":100.0,"y":175.0},"source":{"file":"resources.assets","pathId":"45624","byteOffset":31592736,"byteLength":436}},{"id":"DFr_FD575E12","articyId":"72057791606429688","type":"line","className":"DemeanorTemplate","speaker":"Razlo","text":"I did. To an enterprising buyer with big plans.","speakerId":"Ntt_914F2AC5","textSource":"localization","pronounText":{"TextHeVersion":"I did. To an enterprising buyer with big plans.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":700.0,"y":175.0},"source":{"file":"resources.assets","pathId":"35210","byteOffset":25680600,"byteLength":356}},{"id":"DFr_2BE80C07","articyId":"72057791606429708","type":"line","className":"DemeanorTemplate","speaker":"Razlo","text":"I couldn't possibly say. But I wouldn't eat any of the free donuts in the Curzona offices for a while.","speakerId":"Ntt_914F2AC5","textSource":"localization","pronounText":{"TextHeVersion":"I couldn't possibly say. But I wouldn't eat any of the free donuts in the Curzona offices for a while.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":1300.0,"y":175.0},"source":{"file":"resources.assets","pathId":"18133","byteOffset":147467