9DA3D","articyId":"72057783016489120","type":"line","className":"DemeanorTemplate","speaker":"Nixxy","text":"Thanks. Hey, I bet you're glad you didn't let me spit in your mouth now.","speakerId":"Ntt_1DBCCD4D","textSource":"localization","pronounText":{"TextHeVersion":"Thanks. Hey, I bet you're glad you didn't let me spit in your mouth now.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":5375.0,"y":425.0},"source":{"file":"resources.assets","pathId":"19702","byteOffset":15336824,"byteLength":452}},{"id":"DFr_DC8BA212","articyId":"72057783016489148","type":"line","className":"DemeanorTemplate","speaker":"Nixxy","text":"You're kinda funny. When I figure out what the fuck I'm doing with my life, I'll come back here and try some of your food. For free?","speakerId":"Ntt_1DBCCD4D","textSource":"localization","pronounText":{"TextHeVersion":"You're kinda funny. When I figure out what the fuck I'm doing with my life, I'll come back here and try some of your food. For free?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":6275.0,"y":550.0},"source":{"file":"resources.assets","pathId":"51245","byteOffset":33799784,"byteLength":476}},{"id":"DFr_CF617106","articyId":"72057783016489176","type":"line","className":"DemeanorTemplate","speaker":"Nixxy","text":"Nice. I'll be back then - without an audience next time. See you around Noodle Nut.","speakerId":"Ntt_1DBCCD4D","textSource":"localization","pronounText":{"TextHeVersion":"Nice. I'll be back then - without an audience next time. See you around Noodle Nut.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":3,"name":"Happy"},"position":{"x":6875.0,"y":550.0},"source":{"file":"resources.assets","pathId":"40230","byteOffset":29551064,"byteLength":392}},{"id":"DFr_3F1CB91D","articyId":"72057783016489194","type":"line","className":"DemeanorTemplate","speaker":"Nixxy","text":"Hey. So the votes are in...","speakerId":"Ntt_1DBCCD4D","textSource":"localization","pronounText":{"TextHeVersion":"Hey. So the votes are in...","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":576.0,"y":411.0},"source":{"file":"resources.assets","pathId":"44685","byteOffset":31237408,"byteLength":408}},{"id":"DFr_8AEAB0E4","articyId":"72057783016489206","type":"line","className":"DemeanorTemplate","speaker":"Nixxy","text":"I'm retired. No more streaming for me.","speakerId":"Ntt_1DBCCD4D","textSource":"localization","pronounText":{"TextHeVersion":"I'm retired. No more streaming for me.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":6,"name":"Sad"},"position":{"x":1175.0,"y":425.0},"source":{"file":"resources.assets","pathId":"21572","byteOffset":16049344,"byteLength":348}},{"id":"DFr_B6B66F79","articyId":"72057783016489236","type":"line","className":"DemeanorTemplate","speaker":"Nixxy","text":"No. My whole career.","speakerId":"Ntt_1DBCCD4D","textSource":"localization","pronounText":{"TextHeVersion":"No. My whole career.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":6,"name":"Sad"},"position":{"x":2375.0,"y":425.0},"source":{"file":"resources.assets","pathId":"48541","byteOffset":32699568,"byteLength":328}},{"id":"DFr_5B29B8E5","articyId":"72057774426557649","type":"line","className":"DemeanorTemplate","speaker":"Nixxy","text":"Yes, that's right. Did you know too?","speakerId":"Ntt_1DBCCD4D","textSource":"localization","pronounText":{"TextHeVersion":"Yes, that's right. Did you know too?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":6,"name":"Sad"},"position":{"x":2375.0,"y":650.0},"source":{"file":"resources.assets","pathI