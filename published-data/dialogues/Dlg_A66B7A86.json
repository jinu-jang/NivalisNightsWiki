{"schemaVersion":2,"dialogueId":"Dlg_A66B7A86","title":"Razlo seems quiet","entry":"Dlg_A66B7A86::entry","exit":"Dlg_A66B7A86::exit","nodes":[{"id":"DFr_D8A9EEDA","articyId":"72057645577537447","type":"line","className":"DemeanorTemplate","speaker":"Razlo","text":"You're the new noodle stand owner. What grade of water do you use?","speakerId":"Ntt_914F2AC5","textSource":"localization","pronounText":{"TextHeVersion":"You're the new noodle stand owner. What grade of water do you use?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":2,"name":"Upset"},"position":{"x":0.0,"y":0.0},"source":{"file":"resources.assets","pathId":"18705","byteOffset":14962832,"byteLength":412}},{"id":"DFr_225E6FCA","articyId":"72057645577537458","type":"line","className":"DemeanorTemplate","speaker":"Razlo","text":"How much do you know about the water economy?","speakerId":"Ntt_914F2AC5","textSource":"localization","pronounText":{"TextHeVersion":"How much do you know about the water economy?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":600.0,"y":0.0},"source":{"file":"resources.assets","pathId":"49862","byteOffset":33207088,"byteLength":392}},{"id":"DFr_CE99B586","articyId":"72057645577537491","type":"line","className":"DemeanorTemplate","speaker":"Razlo","text":"We drink it. We use it to power our HOVA's. It flushes away our waste. We boil our noodles with it. We're made of it.","speakerId":"Ntt_914F2AC5","textSource":"localization","pronounText":{"TextHeVersion":"We drink it. We use it to power our HOVA's. It flushes away our waste. We boil our noodles with it. We're made of it.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":1200.0,"y":0.0},"source":{"file":"resources.assets","pathId":"52099","byteOffset":34124736,"byteLength":428}},{"id":"DFr_42