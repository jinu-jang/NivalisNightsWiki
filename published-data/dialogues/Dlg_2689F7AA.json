{"schemaVersion":2,"dialogueId":"Dlg_2689F7AA","title":"Rosco 2","entry":"Dlg_2689F7AA::entry","exit":"Dlg_2689F7AA::exit","nodes":[{"id":"DFr_FE08B7FD","articyId":"72057615512930656","type":"line","className":"DemeanorTemplate","speaker":"Rosco Foreman","text":"Hello again.","speakerId":"Ntt_0FA5B8A8","textSource":"localization","pronounText":{"TextHeVersion":"Hello again.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":325.0,"y":600.0},"source":{"file":"resources.assets","pathId":"39045","byteOffset":29103392,"byteLength":320}},{"id":"DFr_E93D691F","articyId":"72057615512930670","type":"line","className":"DemeanorTemplate","speaker":"Rosco Foreman","text":"Yep. And it just keeps getting weirder. You ever seen a street move?","speakerId":"Ntt_0FA5B8A8","textSource":"localization","pronounText":{"TextHeVersion":"Yep. And it just keeps getting weirder. You ever seen a street move?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":925.0,"y":600.0},"source":{"file":"resources.assets","pathId":"40274","byteOffset":29567176,"byteLength":412}},{"id":"DFr_70F6624F","articyId":"72057615512935887","type":"line","className":"DemeanorTemplate","speaker":"Rosco Foreman","text":"Maybe. Or maybe Curzona's been playing games with the city again. They do love rearranging things without telling anybody.","speakerId":"Ntt_0FA5B8A8","textSource":"localization","pronounText":{"TextHeVersion":"Maybe. Or maybe Curzona's been playing games with the city again. They do love rearranging things without telling anybody.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2125.0,"y":600.0},"source":{"file":"resources.assets","pathId":"28811","byteOffset":18782800,"byteLength":468}},{"id":"DFr_339F8F40","articyI