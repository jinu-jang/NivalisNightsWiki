{"schemaVersion":2,"dialogueId":"Dlg_BB3E86B8","title":"Ava looks for Danny 3","entry":"Dlg_BB3E86B8::entry","exit":"Dlg_BB3E86B8::exit","nodes":[{"id":"DFr_422CD2CA","articyId":"72057821671256351","type":"line","className":"DialogueFragment","speaker":"Ava","text":"I keep trying to find out what happened to Danny...","speakerId":"Ntt_DC270F89","textSource":"localization","pronounText":{"TextHeVersion":"I keep trying to find out what happened to Danny...","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":550.0,"y":550.0},"source":{"file":"resources.assets","pathId":"27987","byteOffset":18468832,"byteLength":332}},{"id":"DFr_FA6F2A27","articyId":"72057821671256357","type":"choice","className":"DialogueFragment","speaker":"Player","text":"Still no trace of him?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Still no trace of him?","TextSheVersion":"Still no trace of him?","TextTheyVersion":"Still no trace of him?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":850.0,"y":550.0},"source":{"file":"resources.assets","pathId":"51541","byteOffset":33915152,"byteLength":304}},{"id":"DFr_1500DB3A","articyId":"72057821671256364","type":"line","className":"DialogueFragment","speaker":"Ava","text":"His trail ends at The Docks. Far from Harper's flat.","speakerId":"Ntt_DC270F89","textSource":"localization","pronounText":{"TextHeVersion":"His trail ends at The Docks. Far from Harper's flat.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1150.0,"y":550.0},"source":{"file":"resources.assets","pathId":"44666","byteOffset":31230408,"byteLength":368}},{"id":"DFr_DA9F1A5D","articyId":"72057821671256371","type":"choice","className":"DialogueFragment","speaker":"Player","text":"What do you think he was looking for?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"