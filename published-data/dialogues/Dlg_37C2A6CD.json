{"schemaVersion":2,"dialogueId":"Dlg_37C2A6CD","title":"Ava remembers","entry":"Dlg_37C2A6CD::entry","exit":"Dlg_37C2A6CD::exit","nodes":[{"id":"DFr_A97F5F01","articyId":"72057821671264053","type":"line","className":"DemeanorTemplate","speaker":"Ava","text":"I... I had no idea Thaddeus was involved.","speakerId":"Ntt_DC270F89","textSource":"localization","pronounText":{"TextHeVersion":"I... I had no idea Thaddeus was involved.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":175.0,"y":375.0},"source":{"file":"resources.assets","pathId":"38834","byteOffset":29023272,"byteLength":352}},{"id":"DFr_4E0935F8","articyId":"72057821671264060","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"He lied to us all.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"He lied to us all.","TextSheVersion":"He lied to us all.","TextTheyVersion":"He lied to us all."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":475.0,"y":375.0},"source":{"file":"resources.assets","pathId":"24755","byteOffset":17245016,"byteLength":328}},{"id":"DFr_64CAB489","articyId":"72057821671264067","type":"line","className":"DemeanorTemplate","speaker":"Ava","text":"He manipulated me. He found a way to change my memories. Made me think I'm an Automata.","speakerId":"Ntt_DC270F89","textSource":"localization","pronounText":{"TextHeVersion":"He manipulated me. He found a way to change my memories. Made me think I'm an Automata.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":775.0,"y":375.0},"source":{"file":"resources.assets","pathId":"23422","byteOffset":16740520,"byteLength":396}},{"id":"DFr_0D026F87","articyId":"72057821671264074","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"How did he do it?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"How did he do it?","TextSheVersion":"How did he do it?","TextTheyVersion":"How did he do it?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1375.0,"y":250.0},"source":{"file":"resources.assets","pathId":"27848","byteOffset":18417016,"byteLength":328}},{"id":"DFr_8D57D39F","articyId":"72057821671264081","type":"line","className":"DemeanorTemplate","speaker":"Ava","text":"Thaddeus always found a way to make things happen that seemed impossible. And as a human, my memories could be tampered with much more easily than an Automata's.","speakerId":"Ntt_DC270F89","textSource":"localization","pronounText":{"TextHeVersion":"Thaddeus always found a way to make things happen that seemed impossible. And as a human, my memories could be tampered with much more easily than an Automata's.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1675.0,"y":375.0},"source":{"file":"resources.assets","pathId":"47037","byteOffset":32126408,"byteLength":508}},{"id":"DFr_AA4D9579","articyId":"72057821671264088","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Changing human memories is easier?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Changing human memories is easier?","TextSheVersion":"Changing human memories is easier?","TextTheyVersion":"Changing human memories is easier?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1975.0,"y":250.0},"source":{"file":"resources.assets","pathId":"43385","byteOffset":30743128,"byteLength":344}},{"id":"DFr_3BBA8018","articyId":"72057821671264095","type":"line","className":"DemeanorTemplate","speaker":"Ava","text":"Yes. Far more time has been spent researching manipulation of human minds than artificial ones.","speakerId":"Ntt_DC270F89","textSource":"localization","pronounText":{"TextHeVersion":"Yes. Far more time has been spent researching manipulation of human minds than artificial ones.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2275.0,"y":250.0},"source":{"file":"resources.assets","pathId":"23500","byteOffset":16769384,"byteLength":440}},{"id":"DFr_3ACC3827","articyId":"72057821671264102","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"I can't believe he did that to you.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I can't believe he did that to you.","TextSheVersion":"I can't believe he did that to you.","TextTheyVersion":"I can't believe he did that to you."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1975.0,"y":500.0},"source":{"file":"resources.assets","pathId":"51918","byteOffset":34056344,"byteLength":344}},{"id":"DFr_C4E6EFAF","articyId":"72057821671264109","type":"line","className":"DemeanorTemplate","speaker":"Ava","text":"Believe me, I have mixed feelings about all of this. Not least, the difference between the value of my sentience as an Automata and as a human.","speakerId":"Ntt_DC270F89","textSource":"localization","pronounText":{"TextHeVersion":"Believe me, I have mixed feelings about all of this. Not least, the difference between the value of my sentience as an Automata and as a human.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2275.0,"y":500.0},"source":{"file":"resources.assets","pathId":"39900","byteOffset":29423056,"byteLength":452}},{"id":"DFr_CCDE2960","articyId":"72057821671264117","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"What are we going to do about all this?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"What are we going to do about all this?","TextSheVersion":"What are we going to do about all this?","TextTheyVersion":"What are we going to do about all this?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2575.0,"y":250.0},"source":{"file":"resources.assets","pathId":"23864","byteOffset":16907912,"byteLength":348}},{"id":"DFr_CB162057","articyId":"72057821671264124","type":"line","className":"DemeanorTemplate","speaker":"Ava","text":"Right now, I'm not even sure I want to know where my body is.","speakerId":"Ntt_DC270F89","textSource":"localization","pronounText":{"TextHeVersion":"Right now, I'm not even sure I want to know where my body is.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2875.0,"y":375.0},"source":{"file":"resources.assets","pathId":"31349","byteOffset":19740168,"byteLength":372}},{"id":"DFr_71ACC526","articyId":"72057821671264131","type":"line","className":"DemeanorTemplate","speaker":"Ava","text":"What would we find? I just... I just can't see a happy end to my story... Leave me to think for a while, ok? I need some time.","speakerId":"Ntt_DC270F89","textSource":"localization","pronounText":{"TextHeVersion":"What would we find? I just... I just can't see a happy end to my story... Leave me to think for a while, ok? I need some time.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3175.0,"y":375.0},"source":{"file":"resources.assets","pathId":"22581","byteOffset":16430496,"byteLength":436}},{"id":"DFr_197151A1","articyId":"72057821671264138","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Sure.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Sure.","TextSheVersion":"Sure.","TextTheyVersion":"Sure."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3475.0,"y":375.0},"source":{"file":"resources.assets","pathId":"44743","byteOffset":31260616,"byteLength":316}},{"id":"DFr_7094D923","articyId":"72057821671268224","type":"line","className":"DemeanorTemplate","speaker":"Ava","text":"And I know he saved me from the fire, but he... he must have changed my memories over and over and over again. Over a hundred years of resetting me...","speakerId":"Ntt_DC270F89","textSource":"localization","pronounText":{"TextHeVersion":"And I know he saved me from the fire, but he... he must have changed my memories over and over and over again. Over a hundred years of resetting me...","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1075.0,"y":375.0},"source":{"file":"resources.assets","pathId":"43686","byteOffset":30856248,"byteLength":496}},{"id":"DFr_56084E71","articyId":"72057606922881015","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Didn't Nabla say that's almost impossible? And Coilson said it too.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Didn't Nabla say that's almost impossible? And Coilson said it too.","TextSheVersion":"Didn't Nabla say that's almost impossible? And Coilson said it too.","TextTheyVersion":"Didn't Nabla say that's almost impossible? And Coilson said it too."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1375.0,"y":475.0},"source":{"file":"resources.assets","pathId":"26819","byteOffset":18025760,"byteLength":376}},{"id":"DFr_C1CEB050","articyId":"72057606922881023","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Thaddeus is out of reach.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText"