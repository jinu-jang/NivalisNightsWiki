{"schemaVersion":2,"dialogueId":"Dlg_E3FA2AAC","title":"Can I have that or what","entry":"Dlg_E3FA2AAC::entry","exit":"Dlg_E3FA2AAC::exit","nodes":[{"id":"DFr_9B8E7E65","articyId":"72057778721537770","type":"line","className":"DemeanorTemplate","speaker":"Cirian Krell","text":"Welcome back. Are you here for a dream land or the wisdom world?","speakerId":"Ntt_3B7FAB37","textSource":"localization","pronounText":{"TextHeVersion":"Welcome back. Are you here for a dream land or the wisdom world?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":3,"name":"Happy"},"position":{"x":275.0,"y":375.0},"source":{"file":"resources.assets","pathId":"37475","byteOffset":28515600,"byteLength":408}},{"id":"DFr_1DD7CFAF","articyId":"72057778721537791","type":"line","className":"DemeanorTemplate","speaker":"Cirian Krell","text":"That's what I believed. Could see it in the depths of your eyes.","speakerId":"Ntt_3B7FAB37","textSource":"localization","pronounText":{"TextHeVersion":"That's what I believed. Could see it in the depths of your eyes.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":900.0,"y":275.0},"source":{"file":"resources.assets","pathId":"18482","byteOffset":14878480,"byteLength":444}},{"id":"DFr_60C1C4F1","articyId":"72057778721537819","type":"line","className":"DemeanorTemplate","speaker":"Cirian Krell","text":"Please, it's simply an observation. You aren't worth having to slip out of CorpSec's radar.","speakerId":"Ntt_3B7FAB37","textSource":"localization","pronounText":{"TextHeVersion":"Please, it's simply an observation. You aren't worth having to slip out of CorpSec's radar.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":1500.0,"y":-175.0},"source":{"file":"resources.assets","pathId":"42511","byteOffset":30409352,"byteLength":436}},{"id":"DFr_0A57257B","articyId":"72057778721537839","type":"line","className":"DemeanorTemplate","speaker":"Cirian Krell","text":"And that move will be into an emergency response HOVA.","speakerId":"Ntt_3B7FAB37","textSource":"localization","pronounText":{"TextHeVersion":"And that move will be into an emergency response HOVA.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":3,"name":"Happy"},"position":{"x":1500.0,"y":50.0},"source":{"file":"resources.assets","pathId":"29863","byteOffset":19178952,"byteLength":388}},{"id":"DFr_DA1B881D","articyId":"72057778721537854","type":"line","className":"DemeanorTemplate","speaker":"Cirian Krell","text":"I know. So keep your intentions over there and we'll keep business over here.","speakerId":"Ntt_3B7FAB37","textSource":"localization","pronounText":{"TextHeVersion":"I know. So keep your intentions over there and we'll keep business over here.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":2100.0,"y":50.0},"source":{"file":"resources.assets","pathId":"47781","byteOffset":32410984,"byteLength":388}},{"id":"DFr_43E581CF","articyId":"72057778721537869","type":"line","className":"DemeanorTemplate","speaker":"Cirian Krell","text":"Indeed. So, you're ready to impart wisdom on yourself?","speakerId":"Ntt_3B7FAB37","textSource":"localization","pronounText":{"TextHeVersion":"Indeed. So, you're ready to impart wisdom on yourself?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":2100.0,"y":-275.0},"source":{"file":"resources.assets","pathId":"20232","byteOffset":15539424,"byteLength":364}},{"id":"DFr_2506E44F","articyId":"72057778721537890","type":"line","className":"DemeanorTemplate","speaker":"Cirian Krell","text":"Enjoy.","speakerId":"Ntt_3B7FAB37","textSource":"localization","pronounText"