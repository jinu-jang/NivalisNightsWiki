{"schemaVersion":2,"dialogueId":"Dlg_D8B4E5D3","title":"Gemelar about decoration","entry":"Dlg_D8B4E5D3::entry","exit":"Dlg_D8B4E5D3::exit","nodes":[{"id":"DFr_6AE67FA6","articyId":"72057611218149150","type":"line","className":"DemeanorTemplate","speaker":"Gemelar Eggleston","text":"Got a minute Boss?","speakerId":"GemelarEggleston","textSource":"localization","pronounText":{"TextHeVersion":"Got a minute Boss?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":325.0,"y":650.0},"source":{"file":"resources.assets","pathId":"27660","byteOffset":18345984,"byteLength":364}},{"id":"DFr_1EEB87C4","articyId":"72057611218149164","type":"line","className":"DemeanorTemplate","speaker":"Gemelar Eggleston","text":"Well, it's my job to get on your nerves if it's good for business. I got an idea.","speakerId":"GemelarEggleston","textSource":"localization","pronounText":{"TextHeVersion":"Well, it's my job to get on your nerves if it's good for business. I got an idea.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":925.0,"y":650.0},"source":{"file":"resources.assets","pathId":"21498","byteOffset":16019736,"byteLength":428}},{"id":"DFr_50AF685D","articyId":"72057611218149178","type":"line","className":"DemeanorTemplate","speaker":"Gemelar Eggleston","text":"Comfort Boss. The more comfortable people feel, the longer they stay, the more expensive stuff they order, and the more sales we make.","speakerId":"GemelarEggleston","textSource":"localization","pronounText":{"TextHeVersion":"Comfort Boss. The more comfortable people feel, the longer they stay, the more expensive stuff they order, and the more sales we make.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":1525.0,"y":650.0},"source":{"file":"resources.assets","pathId":"45493","byteOffset":31543832,"byteLength":444}},{"id":"DFr_1852A8C6","articyId":"72057611218149208","type":"line","className":"DemeanorTemplate","speaker":"Gemelar Eggleston","text":"There are lots of options. Expensive furniture, a jukebox, plants, art ...","speakerId":"GemelarEggleston","textSource":"localization","pronounText":{"TextHeVersion":"There are lots of options. Expensive furniture, a jukebox, plants, art ...","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":2125.0,"y":650.0},"source":{"file":"resources.assets","pathId":"25453","byteOffset":17515024,"byteLength":420}},{"id":"DFr_10D434F8","articyId":"72057611218149269","type":"line","className":"DemeanorTemplate","speaker":"Gemelar Eggleston","text":"Gotta spend money to make it, Boss!","speakerId":"GemelarEggleston","textSource":"localization","pronounText":{"TextHeVersion":"Gotta spend money to make it, Boss!","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":2725.0,"y":525.0},"source":{"file":"resources.assets","pathId":"26178","byteOffset":17785344,"byteLength":344}},{"id":"DFr_925AABDF","articyId":"72057821671260732","type":"line","className":"DemeanorTemplate","speaker":"Gemelar Eggleston","text":"People have no taste, but they know what's expensive. And they usually feel more comfortable in an expensive environment.","speakerId":"GemelarEggleston","textSource":"localization","pronounText":{"TextHeVersion":"People have no taste, but they know what's expensive. And they usually feel more comfortable in an expensive environment.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3025.0,"y":650.0},"source":{"file":"resources.assets","pathId":"43721","byteOffset":30870352,"byteLength":468}},{"id":"DFr_923E6EFA","articyI