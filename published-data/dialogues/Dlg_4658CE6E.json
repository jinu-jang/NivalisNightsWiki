057821671315550","type":"line","className":"DemeanorTemplate","speaker":"Humour Bot 17","text":"It has been my back-up plan for some time. I feel I am well suited to making people feel bad about themselves.","speakerId":"Ntt_B269912D","textSource":"localization","pronounText":{"TextHeVersion":"It has been my back-up plan for some time. I feel I am well suited to making people feel bad about themselves.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":14475.0,"y":125.0},"source":{"file":"resources.assets","pathId":"45142","byteOffset":31412760,"byteLength":456}},{"id":"DFr_C9C80041","articyId":"72057821671315605","type":"line","className":"DemeanorTemplate","speaker":"Humour Bot 17","text":"Do you want to hear some of my material?","speakerId":"Ntt_B269912D","textSource":"localization","pronounText":{"TextHeVersion":"Do you want to hear some of my material?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":15100.0,"y":125.0},"source":{"file":"resources.assets","pathId":"20653","byteOffset":15698488,"byteLength":384}},{"id":"DFr_952AA7B2","articyId":"72057821671315628","type":"line","className":"DemeanorTemplate","speaker":"Humour Bot 17","text":"Very well. This concludes our acquaintance-ship. Goodbye.","speakerId":"Ntt_B269912D","textSource":"localization","pronounText":{"TextHeVersion":"Very well. This concludes our acquaintance-ship. Goodbye.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":17525.0,"y":250.0},"source":{"file":"resources.assets","pathId":"34308","byteOffset":20863144,"byteLength":368}},{"id":"DFr_4C5C944C","articyId":"72057821671315636","type":"line","className":"DemeanorTemplate","speaker":"Humour Bot 17","text":"Always remember that 99% of people won't achieve t