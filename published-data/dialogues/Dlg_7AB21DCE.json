{"schemaVersion":2,"dialogueId":"Dlg_7AB21DCE","title":"Return to Cassius","entry":"Dlg_7AB21DCE::entry","exit":"Dlg_7AB21DCE::exit","nodes":[{"id":"DFr_E55A475A","articyId":"72057615512916255","type":"line","className":"DemeanorTemplate","speaker":"Cassius Pierrepont IV","text":"Ahhh my friend, have you any news? My parents are yet to make contact.","speakerId":"Ntt_6462C222","textSource":"localization","pronounText":{"TextHeVersion":"Ahhh my friend, have you any news? My parents are yet to make contact.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":775.0,"y":575.0},"source":{"file":"resources.assets","pathId":"19832","byteOffset":15385872,"byteLength":416}},{"id":"DFr_A83E2F21","articyId":"72057615512916263","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"I'm afraid we have grave news.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I'm afraid we have grave news.","TextSheVersion":"I'm afraid we have grave news.","TextTheyVersion":"I'm afraid we have grave news."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1075.0,"y":450.0},"source":{"file":"resources.assets","pathId":"51948","byteOffset":34067816,"byteLength":340}},{"id":"DFr_10739F45","articyId":"72057615512916277","type":"line","className":"DemeanorTemplate","speaker":"Cassius Pierrepont IV","text":"Alas I fear they've gone native. They've succumbed to the allure of the poor. I knew the lifestyle would be too exciting for them.","speakerId":"Ntt_6462C222","textSource":"localization","pronounText":{"TextHeVersion":"Alas I fear they've gone native. They've succumbed to the allure of the poor. I knew the lifestyle would be too exciting for them.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1375.0,"y":950.0},"source":{"file":"resources.assets","pathId":"39378","byteOffset":29227376,"byteLength":440}},{"id":"DFr_58646AC2","articyId":"72057615512916284","type":"line","className":"DemeanorTemplate","speaker":"Cassius Pierrepont IV","text":"Oh no. They haven't gone native have they? They've succumbed to the allure of the poor. I knew the lifestyle would be too exciting for them!","speakerId":"Ntt_6462C222","textSource":"localization","pronounText":{"TextHeVersion":"Oh no. They haven't gone native have they? They've succumbed to the allure of the poor. I knew the lifestyle would be too exciting for them!","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":4,"name":"Shocked"},"position":{"x":1375.0,"y":450.0},"source":{"file":"resources.assets","pathId":"50218","byteOffset":33339888,"byteLength":484}},{"id":"DFr_1454D3BE","articyId":"72057615512916312","type":"line","className":"DemeanorTemplate","speaker":"Cassius Pierrepont IV","text":"Well, they may have been at the whole business thing for a long time, maybe they're entitled to their retirement...","speakerId":"Ntt_6462C222","textSource":"localization","pronounText":{"TextHeVersion":"Well, they may have been at the whole business thing for a long time, maybe they're entitled to their retirement...","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1975.0,"y":200.0},"source":{"file":"resources.assets","pathId":"41933","byteOffset":30190920,"byteLength":424}},{"id":"DFr_CE128A80","articyId":"72057615512916319","type":"line","className":"DemeanorTemplate","speaker":"Cassius Pierrepont IV","text":"Oh... I see.","speakerId":"Ntt_6462C222","textSource":"localization","pronounText":{"TextHeVersion":"Oh... I see.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":1975.0,"y":450.0},"source":{"file":"resources.assets","pathId":"40415","byteOffset":29617888,"byteLength":356}},{"id":"DFr_6B3A1C3B","articyId":"72057615512916339","type":"line","className":"DemeanorTemplate","speaker":"Cassius Pierrepont IV","text":"I'm not sure... how to process... what do I do?","speakerId":"Ntt_6462C222","textSource":"localization","pronounText":{"TextHeVersion":"I'm not sure... how to process... what do I do?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":4,"name":"Shocked"},"position":{"x":2575.0,"y":450.0},"source":{"file":"resources.assets","pathId":"42575","byteOffset":30435288,"byteLength":356}},{"id":"DFr_4F267133","articyId":"72057615512916354","type":"line","className":"DemeanorTemplate","speaker":"Cassius Pierrepont IV","text":"But what now?","speakerId":"Ntt_6462C222","textSource":"localization","pronounText":{"TextHeVersion":"But what now?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":6,"name":"Sad"},"position":{"x":2575.0,"y":75.0},"source":{"file":"resources.assets","pathId":"48635","byteOffset":32736536,"byteLength":324}},{"id":"DFr_5028A440","articyId":"72057615512916362","type":"line","className":"DemeanorTemplate","speaker":"Cassius Pierrepont IV","text":"Oh my all this gravity is making my brain taste weird. What would you do?","speakerId":"Ntt_6462C222","textSource":"localization","pronounText":{"TextHeVersion":"Oh my all this gravity is making my brain taste weird. What would you do?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3175.0,"y":325.0},"source":{"file":"resources.assets","pathId":"48701","byteOffset":32761624,"byteLength":456}},{"id":"DFr_0ADC9041","articyId":"72057615512916390","type":"line","className":"DemeanorTemplate","speaker":"Cassius Pierrepont IV","text":"I do like money.","speakerId":"Ntt_6462C222","textSource":"localization","pronounText":{"TextHeVersion":"I do like money.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":3875.0,"y":75.0},"source":{"file":"resources.assets","pathId":"32807","byteOffset":20295344,"byteLength":324}},{"id":"DFr_5621BC50","articyId":"72057615512916397","type":"line","className":"DemeanorTemplate","speaker":"Cassius Pierrepont IV","text":"I do like space.","speakerId":"Ntt_6462C222","textSource":"localization","pronounText":{"TextHeVersion":"I do like space.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":3875.0,"y":300.0},"source":{"file":"resources.assets","pathId":"20718","byteOffset":15722616,"byteLength":324}},{"id":"DFr_E2B9F98A","articyId":"72057615512916404","type":"line","className":"DemeanorTemplate","speaker":"Cassius Pierrepont IV","text":"I have a lot to think about. I discovered Thera-pay bots this morning, perhaps I will find the answers there.","speakerId":"Ntt_6462C222","textSource":"localization","pronounText":{"TextHeVersion":"I have a lot to think about. I discovered Thera-pay bots this morning, perhaps I will find the answers there.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":3875.0,"y":525.0},"source":{"file":"resources.assets","pathId":"27292","byteOffset":18206256,"byteLength":420}},{"id":"DFr_9B6514A1","articyId":"72057615512916425","type":"line","className":"DemeanorTemplate","speaker":"Cassius Pierrepont IV","text":"Well thank you for your help. You have been both useful and kind. If you ever need a room at Pierrepont establishment, you tell them you know old Cassius and... you'll still have to pay, but they'll know how connected you were for a time. Goodbye.","speakerId":"Ntt_6462C222","textSource":"localization","pronounText":{"TextHeVersion":"Well thank you for your help. You have been both useful and kind. If you ever need a room at Pierrepont establishment, you tell them you know old Cassius and... you'll still have to pay, but they'll know how connected you were for a time. Goodbye.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":3,"name":"Happy"},"position":{"x":4525.0,"y":650.0},"source":{"file":"resources.assets","pathId":"46564","byteOffset":31948048,"byteLength":556}},{"id":"DFr_E840EEBE","articyId":"72057821671326230","type":"line","className":"DemeanorTemplate","speaker":"Cassius Pierrepont IV","text":"Those were their Aliases. Always told them that they're frivolous...","speakerId":"Ntt_6462C222","textSource":"localization","pronounText":{"TextHeVersion":"Those were their Aliases. Always told them that they're frivolous...","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2575.0,"y":700.0},"source":{"file":"resources.assets","pathId":"29302","byteOffset":18965384,"byteLength":376}},{"id":"DFr_D1530143","articyId":"72057615512916270","type":"choice","className":"DialogueFragment","speaker":"Player","text":"We weren't able to dig up anything new.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"We weren't able to dig up anything new.","TextSheVersion":"We weren't able to dig up anything new.","TextTheyVersion":"We weren't able to dig up anything new."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1075.0,"y":950.0},"source":{"file":"resources.assets","pathId":"17173","byteOffset":14386232,"byteLength":320}},{"id":"DFr_A9A12AA7","articyId":"72057615512916291","type":"choice","className":"DialogueFragment","speaker":"Player","text":"...Yes. That's the bad news. They have no interest in returning to their past lives.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"...Yes. That's the bad news. They have no interest in returning to their past lives.","TextSheVersion":"...Yes. That's the bad news. They have no interest in returning to their past lives.","TextTheyVersion":"...Yes. That's the bad news. They have no interest in returning to their past lives."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1675.0,"y":200.0},"source":{"file":"resources.assets","pathId":"33854","byteOffset":20690280,"byteLength":364}},{"id":"DFr_F634F3CC","articyId":"72057615512916305","type":"choice","className":"DialogueFragment","speaker":"Player","text":"No I'm afraid it's worse than that. They were killed by The Aseptic.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"No I'm afraid it's worse than that. They were killed by The Aseptic.","TextSheVersion":"No I'm afraid it's worse than that. They were killed by The Aseptic.","TextTheyVersion":"No I'm afraid it's worse than that. They were killed by The Aseptic."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1675.0,"y":450.0},"source":{"file":"resources.assets","pathId":"31946","byteOffset":19966624,"byteLength":348}},{"id":"DFr_1ED69F98","articyId":"72057615512916326","type":"choice","className":"DialogueFragment","speaker":"Player","text":"We think they took the roleplay too far and were mistaken for real poor people.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"We think they took the roleplay too far and were mistaken for real poor people.","TextSheVersion":"We think they took the roleplay too far and were mistaken for real poor people.","TextTheyVersion":"We think they took the roleplay too far and were mistaken for real poor people."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":2275.0,"y":450.0},"source":{"file":"resources.assets","pathId":"36771","byteOffset":28254152,"byteLength":360}},{"id":"DFr_BD6E0203","articyId":"72057615512916333","type":"choice","className":"DialogueFragment","speaker":"Player","text":"It sounds like they deserve it.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"It sounds like they deserve it.","TextSheVersion":"It sounds like they deserve it.","TextTheyVersion":"It sounds like they deserve it."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":2275.0,"y":75.0},"source":{"file":"resources.assets","pathId":"22348","byteOffset":16340456,"byteLength":312}},{"id":"DFr_EE03CACC","articyId":"72057615512916346","type":"choice","className":"DialogueFragment","speaker":"Player","text":"That's up to you. Will you take over the family empire or return to space?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"That's up to you. Will you take over the family empire or return to space?","TextSheVersion":"That's up to you. Will you take over the family empire or return to space?","TextTheyVersion":"That's up to you. Will you take over the family empire or return to space?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":2875.0,"y":325.0},"source":{"file":"resources.assets","pathId":"41791","byteOffset":30138224,"byteLength":356}},{"id":"DFr_5C8B9746","articyId":"72057615512916369","type":"choice","className":"DialogueFragment","speaker":"Player","text":"I'd take over the business. A lot of money to be made in hospitality.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I'd take over the business. A lot of money to be made in hospitality.","TextSheVersion":"I'd take over the business. A lot of money to be made in hospitality.","TextTheyVersion":"I'd take over the business. A lot of money to be made in hospitality."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":3575.0,"y":75.0},"source":{"file":"resources.assets","pathId":"41122","byteOffset":29885440,"byteLength":35