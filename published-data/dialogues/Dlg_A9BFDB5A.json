{"schemaVersion":2,"dialogueId":"Dlg_A9BFDB5A","title":"Talk to Calhoun","entry":"Dlg_A9BFDB5A::entry","exit":"Dlg_A9BFDB5A::exit","nodes":[{"id":"DFr_B2122881","articyId":"72057606922878734","type":"line","className":"DemeanorTemplate","speaker":"Calhoun","text":"There you are.","speakerId":"Ntt_162D9112","textSource":"localization","pronounText":{"TextHeVersion":"There you are.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":575.0,"y":475.0},"source":{"file":"resources.assets","pathId":"32531","byteOffset":20190536,"byteLength":324}},{"id":"DFr_6CB4A102","articyId":"72057606922878741","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"If you're here about a loan...","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"If you're here about a loan...","TextSheVersion":"If you're here about a loan...","TextTheyVersion":"If you're here about a loan..."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":875.0,"y":475.0},"source":{"file":"resources.assets","pathId":"33111","byteOffset":20409680,"byteLength":340}},{"id":"DFr_BD583795","articyId":"72057606922878748","type":"line","className":"DemeanorTemplate","speaker":"Calhoun","text":"Quick ain't ya? Heard you were gathering funds. I happen to have some funds. Course, Mr Calhoun don't do charity...","speakerId":"Ntt_162D9112","textSource":"localization","pronounText":{"TextHeVersion":"Quick ain't ya? Heard you were gathering funds. I happen to have some funds. Course, Mr Calhoun don't do charity...","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":1175.0,"y":475.0},"source":{"file":"resources.assets","pathId":"47231","byteOffset":32203944,"byteLength":460}},{"id":"DFr_66F6D5A1","articyId":"72057606922878755","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Yeah, I know.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Yeah, I know.","TextSheVersion":"Yeah, I know.","TextTheyVersion":"Yeah, I know."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1475.0,"y":350.0},"source":{"file":"resources.assets","pathId":"40097","byteOffset":29498256,"byteLength":324}},{"id":"DFr_4DC4451F","articyId":"72057606922878762","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"I won't need your \"help\". We'll get the donations.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I won't need your \"help\". We'll get the donations.","TextSheVersion":"I won't need your \"help\". We'll get the donations.","TextTheyVersion":"I won't need your \"help\". We'll get the donations."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1475.0,"y":600.0},"source":{"file":"resources.assets","pathId":"46525","byteOffset":31934304,"byteLength":360}},{"id":"DFr_EE2579E6","articyId":"72057606922878769","type":"line","className":"DemeanorTemplate","speaker":"Calhoun","text":"Sound pretty confident. Hope for that kid's sake you're right.","speakerId":"Ntt_162D9112","textSource":"localization","pronounText":{"TextHeVersion":"Sound pretty confident. Hope for that kid's sake you're right.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1775.0,"y":600.0},"source":{"file":"resources.assets","pathId":"51726","byteOffset":33983920,"byteLength":372}},{"id":"DFr_A72F4FF9","articyId":"72057606922878776","type":"line","className":"DemeanorTemplate","speaker":"Calhoun","text":"So you know where I'll be, if - when - you run short.","speakerId":"Ntt_162D9112","textSource":"localization","pronounText":{"TextHeVersion":"So you know where I'll be, if - when - you run short.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1775.0,"y":350.0},"source":{"file":"resources.assets","pathId":"40601","byteOffset":29688712,"byteLength":368}},{"id":"DFr_C5E1CEFA","articyId":"72057606922878783","type":"line","className":"DemeanorTemplate","speaker":"Calhoun","text":"And because I ain't completely cold, I'll do you a favor in the meantime.","speakerId":"Ntt_162D9112","textSource":"localization","pronounText":{"TextHeVersion":"And because I ain't completely cold, I'll do you a favor in the meantime.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":2075.0,"y":350.0},"source":{"file":"resources.assets","pathId":"42914","byteOffset":30565096,"byteLength":420}},{"id":"DFr_72E4F19E","articyId":"72057606922878791","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"I doubt that.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I doubt that.","TextSheVersion":"I doubt that.","TextTheyVersion":"I doubt that."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2375.0,"y":350.0},"source":{"file":"resources.assets","pathId":"42432","byteOffset":30380024,"byteLength":344}},{"id":"DFr_2248A2B3","articyId":"72057606922878798","type":"line","className":"DemeanorTemplate","speaker":"Calhoun","text":"I won't scupper your campaign by telling people what a crook your nice Mr McKenna really is.","speakerId":"Ntt_162D9112","textSource":"localization","pronounText":{"TextHeVersion":"I won't scupper your campaign by telling people what a crook your nice Mr McKenna really is.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2675.0,"y":350.0},"source":{"file":"resources.assets","pathId":"37882","byteOffset":28666608,"byteLength":436}},{"id":"DFr_3A49ACBD","articyId":"72057606922878805","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Are you threatening to ruin the campaign? A kid's life is at stake!","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Are you threatening to ruin the campaign? A kid's life is at stake!","TextSheVersion":"Are you threatening to ruin the campaign? A kid's life is at stake!","TextTheyVersion":"Are you threatening to ruin the campaign? A kid's life is at stake!"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2975.0,"y":350.0},"source":{"file":"resources.assets","pathId":"16638","byteOffset":14189720,"byteLength":376}},{"id":"DFr_84DA7EB6","articyId":"72057606922878812","type":"line","className":"DemeanorTemplate","speaker":"Calhoun","text":"Be a shame if people stopped donating, eh? Shame if old Calhoun was your last hope? Luckily, I'm always here when people need me.","speakerId":"Ntt_162D9112","textSource":"localization","pronounText":{"TextHeVersion":"Be a shame if people stopped donating, eh? Shame if old Calhoun was your last hope? Luckily, I'm always here when people need me.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3275.0,"y":350.0},"source":{"file":"resources.assets","pathId":"43536","byteOffset":30799320,"byteLength":440}},{"id":"DFr_CFB3DAA1","articyId":"72057606922878819","type":"line","className":"DemeanorTemplate","speaker":"Calhoun","text":"I'm just that kinda guy.","speakerId":"Ntt_162D9112","textSource":"localization","pronounText":{"TextHeVersion":"I'm just that kinda guy.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3575.0,"y":350.0