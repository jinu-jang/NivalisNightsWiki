too.","speakerId":"Ntt_5057514D","textSource":"localization","pronounText":{"TextHeVersion":"No. Conland Containers is more than just her. The real masterminds of The Network are monsters living in the Spire. I'll kill her, then keep going till I get them too.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3100.0,"y":325.0},"source":{"file":"resources.assets","pathId":"20793","byteOffset":15750112,"byteLength":476}},{"id":"DFr_34B72A83","articyId":"72057821671351649","type":"line","className":"DemeanorTemplate","speaker":"Edison Mattix","text":"You got a better plan?","speakerId":"Ntt_5057514D","textSource":"localization","pronounText":{"TextHeVersion":"You got a better plan?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3700.0,"y":325.0},"source":{"file":"resources.assets","pathId":"27164","byteOffset":18155096,"byteLength":332}},{"id":"DFr_480DE05C","articyId":"72057619807797459","type":"choice","className":"DialogueFragment","speaker":"Player","text":"You didn't give me much of a choice Edison.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"You didn't give me much of a choice Edison.","TextSheVersion":"You didn't give me much of a choice Edison.","TextTheyVersion":"You didn't give me much of a choice Edison."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":-200.0,"y":75.0},"source":{"file":"resources.assets","pathId":"26009","byteOffset":17721224,"byteLength":324}},{"id":"DFr_65D1A4A3","articyId":"72057619807797465","type":"choice","className":"DialogueFragment","speaker":"Player","text":"I'm here Edison.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I'm here Edison.","TextSheVersion":"I'm here Edison.","TextTheyVersion":"I'm here Edison."},"effects":[],"condit