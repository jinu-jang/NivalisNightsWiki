{"schemaVersion":2,"dialogueId":"Dlg_2E5D98A4","title":"Edison A Summary","entry":"Dlg_2E5D98A4::entry","exit":"Dlg_2E5D98A4::exit","nodes":[{"id":"DFr_F96FF0E1","articyId":"72057619807797428","type":"line","className":"DemeanorTemplate","speaker":"Edison Mattix","text":"Hey friend, thanks for meeting me. I'm kinda at the end of my rope here. You're all I got.","speakerId":"Ntt_5057514D","textSource":"localization","pronounText":{"TextHeVersion":"Hey friend, thanks for meeting me. I'm kinda at the end of my rope here. You're all I got.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":-500.0,"y":200.0},"source":{"file":"resources.assets","pathId":"50022","byteOffset":33267448,"byteLength":436}},{"id":"DFr_7F134817","articyId":"72057619807797474","type":"line","className":"DemeanorTemplate","speaker":"Edison Mattix","text":"I was worried you wouldn't come.","speakerId":"Ntt_5057514D","textSource":"localization","pronounText":{"TextHeVersion":"I was worried you wouldn't come.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":100.0,"y":75.0},"source":{"file":"resources.assets","pathId":"40013","byteOffset":29467000,"byteLength":388}},{"id":"DFr_C9E1BA41","articyId":"72057619807797484","type":"line","className":"DemeanorTemplate","speaker":"Edison Mattix","text":"Appreciate it. There's been a lot going on... I'm pretty sure I'm in over my head.","speakerId":"Ntt_5057514D","textSource":"localization","pronounText":{"TextHeVersion":"Appreciate it. There's been a lot going on... I'm pretty sure I'm in over my head.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":3,"name":"Happy"},"position":{"x":100.0,"y":325.0},"source":{"file":"resources.assets","pathId":"22273","byteOffset":16312448,"byteLength":428}},{"id":"DFr_8F21DBBB","articyId":"72057619807797762","type":"line","className":"DemeanorTemplate","speaker":"Edison Mattix","text":"She's on Calypso. Off on some digital detox Automata Absence challenge. Trying to realign with the island or something like that. She does it once or twice a year.","speakerId":"Ntt_5057514D","textSource":"localization","pronounText":{"TextHeVersion":"She's on Calypso. Off on some digital detox Automata Absence challenge. Trying to realign with the island or something like that. She does it once or twice a year.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":6700.0,"y":200.0},"source":{"file":"resources.assets","pathId":"51691","byteOffset":33970632,"byteLength":472}},{"id":"DFr_E966D1D1","articyId":"72057619807797770","type":"line","className":"DemeanorTemplate","speaker":"Edison Mattix","text":"No. No... You can't do it. You can't risk your life for me. It's too dangerous.","speakerId":"Ntt_5057514D","textSource":"localization","pronounText":{"TextHeVersion":"No. No... You can't do it. You can't risk your life for me. It's too dangerous.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":7300.0,"y":200.0},"source":{"file":"resources.assets","pathId":"49683","byteOffset":33137456,"byteLength":460}},{"id":"DFr_60B10E8F","articyId":"72057619807797784","type":"line","className":"DemeanorTemplate","speaker":"Edison Mattix","text":"Alright... Alright, fine. You'll find her on the Island near a place called Last Call. She will not be happy to see you.","speakerId":"Ntt_5057514D","textSource":"localization","pronounText":{"TextHeVersion":"Alright... Alright, fine. You'll find her on the Island near a place called Last Call. She will not be happy to see you.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":7900.0,"y":200.0},"source":{"file":"resources.assets","pathId":"23283","byteOffset":16690080,"byteLength":428}},{"id":"DFr_57367AE6","articyId":"72057821671351382","type":"line","className":"DemeanorTemplate","speaker":"Edison Mattix","text":"I know where my niece is. We have to do something!","speakerId":"Ntt_5057514D","textSource":"localization","pronounText":{"TextHeVersion":"I know where my niece is. We have to do something!","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":3,"name":"Happy"},"position":{"x":700.0,"y":200.0},"source":{"file":"resources.assets","pathId":"40696","byteOffset":29724520,"byteLength":360}},{"id":"DFr_BDFA0B2C","articyId":"72057821671351456","type":"line","className":"DemeanorTemplate","speaker":"Edison Mattix","text":"One of Freya Portlet's assistants let slip. She was a Gen Debtor we freed eight years ago.","speakerId":"Ntt_5057514D","textSource":"localization","pronounText":{"TextHeVersion":"One of Freya Portlet's assistants let slip. She was a Gen Debtor we freed eight years ago.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1300.0,"y":200.0},"source":{"file":"resources.assets","pathId":"38069","byteOffset":28736920,"byteLength":436}},{"id":"DFr_622FFC71","articyId":"72057821671351477","type":"line","className":"DemeanorTemplate","speaker":"Edison Mattix","text":"Can I trust anybody? Can I trust YOU?","speakerId":"Ntt_5057514D","textSource":"localization","pronounText":{"TextHeVersion":"Can I trust anybody? Can I trust YOU?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1900.0,"y":225.0},"source":{"file":"resources.assets","pathId":"37236","byteOffset":28428328,"byteLength":384}},{"id":"DFr_61D2A9C6","articyId":"72057821671351499","type":"line","className":"DemeanorTemplate","