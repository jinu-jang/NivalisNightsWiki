{"schemaVersion":2,"dialogueId":"Dlg_051D4597","title":"Dagmar Has Another Job","entry":"Dlg_051D4597::entry","exit":"Dlg_051D4597::exit","nodes":[{"id":"DFr_840FE4B1","articyId":"72057791606438255","type":"line","className":"DemeanorTemplate","speaker":"Dagmar Fitz","text":"So, you're back. Nice job on the old rat n' run.","speakerId":"Ntt_7E28D88A","textSource":"localization","pronounText":{"TextHeVersion":"So, you're back. Nice job on the old rat n' run.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":175.0,"y":275.0},"source":{"file":"resources.assets","pathId":"36827","byteOffset":28275192,"byteLength":356}},{"id":"DFr_F80D648A","articyId":"72057791606438269","type":"line","className":"DemeanorTemplate","speaker":"Dagmar Fitz","text":"Thing is, our rivals just aren't sinking fast enough for my liking. And seeing you make money gets me itchy.","speakerId":"Ntt_7E28D88A","textSource":"localization","pronounText":{"TextHeVersion":"Thing is, our rivals just aren't sinking fast enough for my liking. And seeing you make money gets me itchy.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":775.0,"y":275.0},"source":{"file":"resources.assets","pathId":"19011","byteOffset":15078928,"byteLength":452}},{"id":"DFr_9A06FF86","articyId":"72057791606438290","type":"line","className":"DemeanorTemplate","speaker":"Dagmar Fitz","text":"I've seen that know it all food critic DeNuite skulking around the place. A good word from him and business would boom.","speakerId":"Ntt_7E28D88A","textSource":"localization","pronounText":{"TextHeVersion":"I've seen that know it all food critic DeNuite skulking around the place. A good word from him and business would boom.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":1975