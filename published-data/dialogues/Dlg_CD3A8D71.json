{"schemaVersion":2,"dialogueId":"Dlg_CD3A8D71","title":"Tell Andrea About None","entry":"Dlg_CD3A8D71::entry","exit":"Dlg_CD3A8D71::exit","nodes":[{"id":"DFr_31FDE922","articyId":"72057752951736977","type":"line","className":"DemeanorTemplate","speaker":"Andrea Cellini","text":"Any luck with those lyrics honey?","speakerId":"Ntt_A5F46049","textSource":"localization","pronounText":{"TextHeVersion":"Any luck with those lyrics honey?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":300.0,"y":275.0},"source":{"file":"resources.assets","pathId":"51145","byteOffset":33762432,"byteLength":380}},{"id":"DFr_E7ABCBD4","articyId":"72057752951736998","type":"line","className":"DemeanorTemplate","speaker":"Andrea Cellini","text":"Well that's the most un-Jazz thing I ever heard. I had a feeling you were gonna bottle it. Never mind I guess, I'll find someone who cares","speakerId":"Ntt_A5F46049","textSource":"localization","pronounText":{"TextHeVersion":"Well that's the most un-Jazz thing I ever heard. I had a feeling you were gonna bottle it. Never mind I guess, I'll find someone who cares","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":6,"name":"Sad"},"position":{"x":900.0,"y":275.0},"source":{"file":"resources.assets","pathId":"45044","byteOffset":31373944,"byteLength":484}},{"id":"DFr_30800357","articyId":"72057752951737019","type":"line","className":"DemeanorTemplate","speaker":"Andrea Cellini","text":"You're just like all the rest. Well I hope you find happiness in your life before you croak, it's clearly eluded you up to this point.","speakerId":"Ntt_A5F46049","textSource":"localization","pronounText":{"TextHeVersion":"You're just like all the rest. Well I hope you find happiness in your life before you croak, it's clearly eluded you up to this point.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":