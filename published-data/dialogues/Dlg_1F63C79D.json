{"schemaVersion":2,"dialogueId":"Dlg_1F63C79D","title":"Sell Neon to Danny","entry":"Dlg_1F63C79D::entry","exit":"Dlg_1F63C79D::exit","nodes":[{"id":"DFr_FC454889","articyId":"72057791606431167","type":"line","className":"DemeanorTemplate","speaker":"Danny Danetti","text":"Hey so donut question: crab parfait with a fishtail glaze. Right on, or right in the bin?","speakerId":"Ntt_BB92D958","textSource":"localization","pronounText":{"TextHeVersion":"Hey so donut question: crab parfait with a fishtail glaze. Right on, or right in the bin?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":125.0,"y":175.0},"source":{"file":"resources.assets","pathId":"38458","byteOffset":28883648,"byteLength":436}},{"id":"DFr_59E2149F","articyId":"72057791606431188","type":"line","className":"DemeanorTemplate","speaker":"Danny Danetti","text":"I knew it! Fish donuts - this is gonna be my ticket to the big time.","speakerId":"Ntt_BB92D958","textSource":"localization","pronounText":{"TextHeVersion":"I knew it! Fish donuts - this is gonna be my ticket to the big time.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":725.0,"y":75.0},"source":{"file":"resources.assets","pathId":"35113","byteOffset":25644632,"byteLength":376}},{"id":"DFr_C6FBE666","articyId":"72057791606431201","type":"line","className":"DemeanorTemplate","speaker":"Danny Danetti","text":"Damn. Thought I was onto something. Ah well, back to the kitchen.","speakerId":"Ntt_BB92D958","textSource":"localization","pronounText":{"TextHeVersion":"Damn. Thought I was onto something. Ah well, back to the kitchen.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":725.0,"y":300.0},"source":{"file":"resources.assets","pathId":"52444","byteOffset":34253776,"byteLength":376}},{"id":"DFr_E0F11070","articyId":"72057791606431222","type":"line","className":"DemeanorTemplate","speaker":"Danny Danetti","text":"*sigh* A fickle mistress. One second people are going crazy for a kidney creme cruller, next you can't drag them in the door.","speakerId":"Ntt_BB92D958","textSource":"localization","pronounText":{"TextHeVersion":"*sigh* A fickle mistress. One second people are going crazy for a kidney creme cruller, next you can't drag them in the door.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1350.0,"y":175.0},"source":{"file":"resources.assets","pathId":"16835","byteOffset":14261168,"byteLength":436}},{"id":"DFr_D3994C38","articyId":"72057791606431237","type":"line","className":"DemeanorTemplate","speaker":"Danny Danetti","text":"Aww, you ain't gonna try sell me one of those Digital Declutterers are ya?","speakerId":"Ntt_BB92D958","textSource":"localization","pronounText":{"TextHeVersion":"Aww, you ain't gonna try sell me one of those Digital Declutterers are ya?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1924.0,"y":187.5},"source":{"file":"resources.assets","pathId":"22751","byteOffset":16491872,"byteLength":420}},{"id":"DFr_786A43F1","articyId":"72057791606431258","type":"line","className":"DemeanorTemplate","speaker":"Danny Danetti","text":"That scam Nola Berg is peddling. Gave me. Gave me a headache so bad I couldn't piss straight.","speakerId":"Ntt_BB92D958","textSource":"localization","pronounText":{"TextHeVersion":"That scam Nola Berg is peddling. Gave me. Gave me a headache so bad I couldn't piss straight.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2498.0,"y":62.5},"source":{"file":"resources.assets","pathId":"39164","byteOffset":29148296,"byteLength":404}},{"id":"DFr_0749BE3D","articyId":"72057791606431272","type":"line","className":"DemeanorTemplate","speaker":"Danny Danetti","text":"Oh yeah? I'm listening.","speakerId":"Ntt_BB92D958","textSource":"localization","pronounText":{"TextHeVersion":"Oh yeah? I'm listening.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3075.0,"y":300.0},"source":{"file":"resources.assets","pathId":"37744","byteOffset":28616032,"byteLength":332}},{"id":"DFr_7A75DD8C","articyId":"72057791606431287","type":"line","className":"DemeanorTemplate","speaker":"Danny Danetti","text":"Neon? Ain't that a bit, you know, tasteless?","speakerId":"Ntt_BB92D958","textSource":"localization","pronounText":{"TextHeVersion":"Neon? Ain't that a bit, you know, tasteless?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3649.0,"y":300.0},"source":{"file":"resources.assets","pathId":"33256","byteOffset":20465776,"byteLength":388}},{"id":"DFr_38AA667F","articyId":"72057791606431308","type":"line","className":"DemeanorTemplate","speaker":"Danny Danetti","text":"What the fuck, bud?","speakerId":"Ntt_BB92D958","textSource":"localization","pronounText":{"TextHeVersion":"What the fuck, bud?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":2,"name":"Upset"},"position":{"x":4223.0,"y":425.0},"source":{"file":"resources.assets","pathId":"42767","byteOffset":30509320,"byteLength":364}},{"id":"DFr_586261D8","articyId":"72057791606431315","type":"line","className":"DemeanorTemplate","speaker":"Danny Danetti","text":"Huh, now you mention it, I can kinda see it.","speakerId":"Ntt_BB92D958","textSource":"localization","pronounText":{"TextHeVersion":"Huh, now you mention it, I can kinda see it.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":4223.0,"y":175.0},"source":{"file":"resources.assets","pathId":"32440","byteOffset":20155184,"byteLength":352}},{"id":"DFr_7C3B2E6F","articyId":"72057791606431335","type":"line","className":"DemeanorTemplate","speaker":"Danny Danetti","text":"Blue for tuna... yeah, I can totally see it!","speakerId":"Ntt_BB92D958","textSource":"localization","pronounText":{"TextHeVersion":"Blue for tuna... yeah, I can totally see it!","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":4797.0,"y":175.0},"source":{"file":"resources.assets","pathId":"26906","byteOffset":18059744,"byteLength":352}},{"id":"DFr_BE900F2E","articyId":"72057791606431356","type":"line","className":"DemeanorTemplate","speaker":"Danny Danetti","text":"Yeah well, I ain't in the mood today. Look, I gotta run, 'k? See ya around.","speakerId":"Ntt_BB92D958","textSource":"localization","pronounText":{"TextHeVersion":"Yeah well, I ain't in the mood today. Look, I gotta run, 'k? See ya around.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":4787.0,"y":425.0},"source":{"file":"resources.assets","pathId":"35558","byteOffset":27801096,"byteLength":384}},{"id":"DFr_241E2654","articyId":"72057791606431363","type":"line","className":"DemeanorTemplate","speaker":"Danny Danetti","text":"You wanna talk about bad food you should eat at your own place sometime, friend. See ya around.","speakerId":"Ntt_BB92D958","textSource":"localization","pronounText":{"TextHeVersion":"You wanna talk about bad food you should eat at your own place sometime, friend. See ya around.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":4787.0,"y":675.0},"source":{"file":"r