,"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1600.0,"y":450.0},"source":{"file":"resources.assets","pathId":"19897","byteOffset":15411440,"byteLength":388}},{"id":"DFr_937FE7B6","articyId":"72057606922873518","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"It was close, Lochlainn. But we made it.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"It was close, Lochlainn. But we made it.","TextSheVersion":"It was close, Lochlainn. But we made it.","TextTheyVersion":"It was close, Lochlainn. But we made it."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1600.0,"y":700.0},"source":{"file":"resources.assets","pathId":"18378","byteOffset":14841024,"byteLength":348}},{"id":"DFr_A0988471","articyId":"72057606922873525","type":"line","className":"DemeanorTemplate","speaker":"Lochlainn McKenna","text":"Thank CORA. I can't believe it. I... don't know what to say boss...","speakerId":"LochlainnMcKenna","textSource":"localization","pronounText":{"TextHeVersion":"Thank CORA. I can't believe it. I... don't know what to say boss...","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":4,"name":"Shocked"},"position":{"x":1900.0,"y":450.0},"source":{"file":"resources.assets","pathId":"50839","byteOffset":33573368,"byteLength":376}},{"id":"DFr_0ABF9339","articyId":"72057606922873534","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"We did it. I'm on my way to Idlehands to get the mask.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"We did it. I'm on my way to Idlehands to get the mask.","TextSheVersion":"We did it. I'm on my way to Idlehands to get the mask.","TextTheyVersion":"We did it. I'm on my way to Idlehands to get the mask."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"posit