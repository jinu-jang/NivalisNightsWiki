{"schemaVersion":2,"dialogueId":"Dlg_6AF6583E","title":"Tell Freya You Found an Act","entry":"Dlg_6AF6583E::entry","exit":"Dlg_6AF6583E::exit","nodes":[{"id":"DFr_AE0F9795","articyId":"72057778721544888","type":"line","className":"DemeanorTemplate","speaker":"Freya Portlet","text":"I'm impressed. And I don't say that often. Or ever. If the act you found is half as good as these people think, well...","speakerId":"Ntt_1F68839F","textSource":"localization","pronounText":{"TextHeVersion":"I'm impressed. And I don't say that often. Or ever. If the act you found is half as good as these people think, well...","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":3,"name":"Happy"},"position":{"x":175.0,"y":400.0},"source":{"file":"resources.assets","pathId":"44459","byteOffset":31149608,"byteLength":500}},{"id":"DFr_68405D87","articyId":"72057778721544922","type":"line","className":"DemeanorTemplate","speaker":"Freya Portlet","text":"Yeah, to the Spire we go. You got a spark I guess. Now we just gotta see if it ignites.","speakerId":"Ntt_1F68839F","textSource":"localization","pronounText":{"TextHeVersion":"Yeah, to the Spire we go. You got a spark I guess. Now we just gotta see if it ignites.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":775.0,"y":175.0},"source":{"file":"resources.assets","pathId":"31929","byteOffset":19960312,"byteLength":420}},{"id":"DFr_8CFC0EC7","articyId":"72057778721544937","type":"line","className":"DemeanorTemplate","speaker":"Freya Portlet","text":"We'll see. Let's start with handling the influx of new customers this is gonna bring you. See if you still have the energy for more after that.","speakerId":"Ntt_1F68839F","textSource":"localization","pronounText":{"TextHeVersion":"We'll see. Let's start with handling the influx of new customers this is gonna bring you. See if you still have the energy for more after that.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":3,"name":"Happy"},"position":{"x":1400.0,"y":400.0},"source":{"file":"resources.assets","pathId":"25946","byteOffset":17698168,"byteLength":452}},{"id":"DFr_CD88B51E","articyId":"72057778721544945","type":"line","className":"DemeanorTemplate","speaker":"Freya Portlet","text":"No, I believe I did. Which is why I called you. Did you think I'd put you up to this if I thought you'd fail? With my name on it? Please.","speakerId":"Ntt_1F68839F","textSource":"localization","pronounText":{"TextHeVersion":"No, I believe I did. Which is why I called you. Did you think I'd put you up to this if I thought you'd fail? With my name on it? Please.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":775.0,"y":400.0},"source":{"file":"resources.assets","pathId":"19152","byteOffset":15130680,"byteLength":448}},{"id":"DFr_027BF4F7","articyId":"72057778721544960","type":"line","className":"DemeanorTemplate","speaker":"Freya Portlet","text":"You have to be yourself or you'll never survive. Didn't anyone ever tell you that?","speakerId":"Ntt_1F68839F","textSource":"localization","pronounText":{"TextHeVersion":"You have to be yourself or you'll never survive. Didn't anyone ever tell you that?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":1,"name":"Neutral"},"position":{"x":775.0,"y":625.0},"source":{"file":"resources.assets","pathId":"40852","byteOffset":29781672,"byteLength":428}},{"id":"DFr_4922FC55","articyId":"72057778721544901","type":"choice","className":"DialogueFragment","speaker":"Player","text":"So, to the Spire we go?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"So, to the Spire we go?","TextSheVersion":"So, to the Spire we go?","TextTheyVersion":"So, to the Spire we go?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":475.0,"y":175.0},"source":{"file":"resources.assets","pathId":"36103","byteOffset":28005432,"byteLength":304}},{"id":"DFr_8C9D3B31","articyId":"72057778721544907","type":"choice","className":"DialogueFragment","speaker":"Player","text":"Told you I'd come through.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Told you I'd come through.","TextSheVersion":"Told you I'd come through.","TextTheyVersion":"Told you I'd come through."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":475.0,"y":400.0},"source":{"file":"resources.assets","pathId":"24961","byteOffset":17323424,"byteLength":308}},{"id":"DFr_31074891","articyId":"72057778721544913","type":"choice","className":"DialogueFragment","speaker":"Player","text":"So now you'll stop being a major pain in the ass to everyone?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"So now you'll stop being a major pain in the ass to everyone?","TextSheVersion":"So now you'll stop being a major pain in the ass to everyone?","TextTheyVersion":"So now you'll stop being a major pain in the ass to everyone?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":475.0,"y":625.0},"source":{"file":"resources.assets","pathId":"46214","byteOffset":31814424,"byteLength":344}},{"id":"DFr_15A7B439","articyId":"72057778721544930","type":"choice","className":"DialogueFragment","speaker":"Player","text":"It'll last.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"It'll last.","TextSheVersion":"It'll last.","TextTheyVersion":"It'll last."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1075.0,"y":175.0},"source":{"file":"resources.assets","pathId":"46829","byteOffset":32046328,"byteLength":292}},{"id":"DFr_5FBE7D1C","articyId":"72057778721544952","type":"choice","className":"DialogueF