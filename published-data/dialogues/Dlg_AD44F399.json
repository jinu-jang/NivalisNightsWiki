{"schemaVersion":2,"dialogueId":"Dlg_AD44F399","title":"R M Alken Chess Introduction Match","entry":"Dlg_AD44F399::entry","exit":"Dlg_AD44F399::exit","nodes":[{"id":"DFr_10C2F733","articyId":"72057778721539853","type":"line","className":"DemeanorTemplate","speaker":"R M Alken","text":"Aye! Here for the tournament?","speakerId":"Ntt_4318BDFB","textSource":"localization","pronounText":{"TextHeVersion":"Aye! Here for the tournament?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":-350.0,"y":-100.0},"source":{"file":"resources.assets","pathId":"21921","byteOffset":16180152,"byteLength":376}},{"id":"DFr_C2A9AD0D","articyId":"72057778721539909","type":"line","className":"DemeanorTemplate","speaker":"R M Alken","text":"Oh, well, that'd be me. I can't really let yah register if you can't beat the person, you know, doing the registration.","speakerId":"Ntt_4318BDFB","textSource":"localization","pronounText":{"TextHeVersion":"Oh, well, that'd be me. I can't really let yah register if you can't beat the person, you know, doing the registration.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":1150.0,"y":-100.0},"source":{"file":"resources.assets","pathId":"51991","byteOffset":34083376,"byteLength":428}},{"id":"DFr_C1DD2BA0","articyId":"72057778721540667","type":"line","className":"DemeanorTemplate","speaker":"R M Alken","text":"Beat all seven and you win. If you lose once, you're out. Well, except the introductory stage. You can register as many times as you want.","speakerId":"Ntt_4318BDFB","textSource":"localization","pronounText":{"TextHeVersion":"Beat all seven and you win. If you lose once, you're out. Well, except the introductory stage. You can register as many times as you want.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"nam