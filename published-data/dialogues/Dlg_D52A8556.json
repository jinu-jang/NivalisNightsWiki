{"schemaVersion":2,"dialogueId":"Dlg_D52A8556","title":"Agent Teleshenko at the book fair","entry":"Dlg_D52A8556::entry","exit":"Dlg_D52A8556::exit","nodes":[{"id":"DFr_24634BB4","articyId":"72057821671271059","type":"line","className":"DemeanorTemplate","speaker":"Agent Teleshko","text":"Hello. Are you also finding some good books tonight?","speakerId":"Ntt_2B1C9A1E","textSource":"localization","pronounText":{"TextHeVersion":"Hello. Are you also finding some good books tonight?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":525.0,"y":450.0},"source":{"file":"resources.assets","pathId":"29025","byteOffset":18862760,"byteLength":396}},{"id":"DFr_43AEF955","articyId":"72057821671271066","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Teleshko! What are you doing here?!","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Teleshko! What are you doing here?!","TextSheVersion":"Teleshko! What are you doing here?!","TextTheyVersion":"Teleshko! What are you doing here?!"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":825.0,"y":325.0},"source":{"file":"resources.assets","pathId":"20601","byteOffset":15677752,"byteLength":344}},{"id":"DFr_64A1204B","articyId":"72057821671271073","type":"line","className":"DemeanorTemplate","speaker":"Agent Teleshko","text":"I am perusing the wares.","speakerId":"Ntt_2B1C9A1E","textSource":"localization","pronounText":{"TextHeVersion":"I am perusing the wares.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1125.0,"y":325.0},"source":{"file":"resources.assets","pathId":"31567","byteOffset":19823544,"byteLength":332}},{"id":"DFr_56638836","articyId":"72057821671271080","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Isn't this all illegal? Are you here as a CorpSec Officer?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Isn't this all illegal? Are you here as a CorpSec Officer?","TextSheVersion":"Isn't this all illegal? Are you here as a CorpSec Officer?","TextTheyVersion":"Isn't this all illegal? Are you here as a CorpSec Officer?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1425.0,"y":450.0},"source":{"file":"resources.assets","pathId":"28074","byteOffset":18503328,"byteLength":368}},{"id":"DFr_3CEAD708","articyId":"72057821671271087","type":"line","className":"DemeanorTemplate","speaker":"Agent Teleshko","text":"I only work during the day. By night, I am a mere citizen.","speakerId":"Ntt_2B1C9A1E","textSource":"localization","pronounText":{"TextHeVersion":"I only work during the day. By night, I am a mere citizen.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1725.0,"y":450.0},"source":{"file":"resources.assets","pathId":"51448","byteOffset":33878768,"byteLength":404}},{"id":"DFr_2D051BAF","articyId":"72057821671271094","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"If someone asks, you weren't here.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"If someone asks, you weren't here.","TextSheVersion":"If someone asks, you weren't here.","TextTheyVersion":"If someone asks, you weren't here."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2025.0,"y":325.0},"source":{"file":"resources.assets","pathId":"41753","byteOffset":30123688,"byteLength":344}},{"id":"DFr_A60D7E21","articyId":"72057821671272189","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Teleshko! Wait, are you here to bust everyone?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Teleshko! Wait, are you here to bust everyone?","TextSheVersion":"Teleshko! Wait, are you here to bust everyone?","TextTheyVersion":"Teleshko! Wait, are you here to bust everyone?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":825.0,"y":575.0},"source":{"file":"resources.assets","pathId":"24163","byteOffset":17019600,"byteLength":356}},{"id":"DFr_BB983304","articyId":"72057821671272196","type":"line","className":"DemeanorTemplate","speaker":"Agent Teleshko","text":"No. I am here for the books.","speakerId":"Ntt_2B1C9A1E","textSource":"localization","pronounText":{"TextHeVersion":"No. I am here for the books.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1125.0,"y":575.0},"source":{"file":"resources.assets","pathId":"35746","byteOffset":27871440,"byteLength":336}},{"id":"DFr_50C01E03","articyId":"72057821671279381","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Are you selling some books?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Are you selling some books?","TextSheVersion":"Are you selling some books?","TextTheyVersion":"Are you selling some books?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2025.0,"y":575.0},"source":{"file":"resources.assets","pathId":"28142","byteOffset":18529272,"byteLength":336}},{"id":"DFr_D2054617","articyId":"72057821671279388","type":"line","className":"DemeanorTemplate","speaker":"Agent Teleshko","text":"No. I'm collecting.","speakerId":"Ntt_2B1C9A1E","textSource":"localization","pronounText":{"TextHeVersion":"No. I'm collecting.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2325.0,"y":575.0},"source":{"file":"resources.assets","pathId":"45086","byteOffset":31389704,"byteLength":328}},{"id":"DFr_6A7F0B0A","articyId":"72057821671279395","type":"line","className":"DemeanorTemplate","speaker":"Agent Teleshko","text":"I never sell. I can't part with them. The smell. The feeling in your hands. The haptics! They are glorious things.","speakerId":"Ntt_2B1C9A1E","textSource":"localization","pronounText":{"TextHeVersion":"I never sell. I can't part with them. The smell. The feeling in your hands. The haptics! They are glorious things.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2625.0,"y":575.0},"source":{"file":"resources.assets","pathId":"19653","byteOffset":15318544,"byteLength":460}},{"id":"DFr_A714FBF6","articyId":"72057821671279402","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"I am surprised. You seem to really love books.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I am surprised. You seem to really love books.","TextSheVersion":"I am surprised. You seem to really love books.","TextTheyVersion":"I am surprised. You seem to really love books."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2925.0,"y":575.0},"source":{"file":"resources.assets","pathId":"28907","byteOffset":18819464,"byteLength":356}},{"id":"DFr_D7E5070A","articyId":"72057821671279409","type":"line","className":"DemeanorTemplate","speaker":"Agent Teleshko","text":"No one wants to believe I am more than a CorpSec agent. I also appreciate culture.","speakerId":"Ntt_2B1C9A1E","textSource":"localization","pronounText":{"TextHeVersion":"No one wants to believe I am more than a CorpSec agent. I also appreciate culture.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3225.0,"y":575.0},"source":