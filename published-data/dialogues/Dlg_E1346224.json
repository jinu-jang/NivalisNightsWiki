't here and I think your augments might be shorting.","TextSheVersion":"Kai, Hayden isn't here and I think your augments might be shorting.","TextTheyVersion":"Kai, Hayden isn't here and I think your augments might be shorting."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1500.0,"y":375.0},"source":{"file":"resources.assets","pathId":"40067","byteOffset":29487144,"byteLength":348}},{"id":"DFr_BE055D1E","articyId":"72057628397670733","type":"choice","className":"DialogueFragment","speaker":"Player","text":"You've seen punks taking over real estate? Seriously?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"You've seen punks taking over real estate? Seriously?","TextSheVersion":"You've seen punks taking over real estate? Seriously?","TextTheyVersion":"You've seen punks taking over real estate? Seriously?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1500.0,"y":600.0},"source":{"file":"resources.assets","pathId":"19014","byteOffset":15080056,"byteLength":336}},{"id":"DFr_B2882159","articyId":"72057697117150149","type":"choice","className":"DialogueFragment","speaker":"Player","text":"You okay, Kai?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"You okay, Kai?","TextSheVersion":"You okay, Kai?","TextTheyVersion":"You okay, Kai?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":-874.0,"y":375.0},"source":{"file":"resources.assets","pathId":"25548","byteOffset":17551416,"byteLength":296}},{"id":"DFr_3B0521FF","articyId":"72057697117150163","type":"choice","className":"DialogueFragment","speaker":"Player","text":"Do you know where you are right now?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Do you know where you are right now?","TextSheVersion":"Do you know where you are right now?","TextTheyVersion":"Do you know where you are right now?"},"effects":[],"conditions":