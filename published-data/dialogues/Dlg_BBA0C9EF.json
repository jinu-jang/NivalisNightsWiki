72057645577584589","type":"choice","className":"DialogueFragment","speaker":"Player","text":"To figure out who he's looking for?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"To figure out who he's looking for?","TextSheVersion":"To figure out who he's looking for?","TextTheyVersion":"To figure out who he's looking for?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":2000.0,"y":500.0},"source":{"file":"resources.assets","pathId":"26448","byteOffset":17887528,"byteLength":316}},{"id":"DFr_45F7DC31","articyId":"72057645577584597","type":"line","className":"DialogueFragment","speaker":"Ava","text":"No. He's looking for Thaddeus. Are you properly awake today?","speakerId":"Ntt_DC270F89","textSource":"localization","pronounText":{"TextHeVersion":"No. He's looking for Thaddeus. Are you properly awake today?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":2300.0,"y":500.0},"source":{"file":"resources.assets","pathId":"25433","byteOffset":17507952,"byteLength":356}},{"id":"DFr_21F7EDC0","articyId":"72057645577584603","type":"line","className":"DialogueFragment","speaker":"Ava","text":"Yes, that's what I was thinking. Thanks for paying attention.","speakerId":"Ntt_DC270F89","textSource":"localization","pronounText":{"TextHeVersion":"Yes, that's what I was thinking. Thanks for paying attention.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":2600.0,"y":275.0},"source":{"file":"resources.assets","pathId":"52300","byteOffset":34200208,"byteLength":344}},{"id":"DFr_D05E36C8","articyId":"72057645577584616","type":"choice","className":"DialogueFragment","speaker":"Player","text":"I got confused.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I got confused.","TextSheVersion":"I got confused.","TextTheyVersion":"I got confused."},"effec