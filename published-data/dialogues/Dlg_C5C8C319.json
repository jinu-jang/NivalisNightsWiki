"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1300.0,"y":325.0},"source":{"file":"resources.assets","pathId":"30447","byteOffset":19399848,"byteLength":288}},{"id":"DFr_211C18BF","articyId":"72057718591980062","type":"line","className":"DialogueFragment","speaker":"Ava","text":"The Aseptic is known for striking at night. Fewer people in the streets, fewer bodies.","speakerId":"Ntt_DC270F89","textSource":"localization","pronounText":{"TextHeVersion":"The Aseptic is known for striking at night. Fewer people in the streets, fewer bodies.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1600.0,"y":325.0},"source":{"file":"resources.assets","pathId":"31973","byteOffset":19977512,"byteLength":404}},{"id":"DFr_316AA094","articyId":"72057718591980069","type":"choice","className":"DialogueFragment","speaker":"Player","text":"So the killer only murders people on the street?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"So the killer only murders people on the street?","TextSheVersion":"So the killer only murders people on the street?","TextTheyVersion":"So the killer only murders people on the street?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1900.0,"y":325.0},"source":{"file":"resources.assets","pathId":"40281","byteOffset":29569776,"byteLength":328}},{"id":"DFr_CED53896","articyId":"72057718591980076","type":"line","className":"DialogueFragment","speaker":"Ava","text":"Oh gosh no, 87% of the killings have happened indoors. Probably because that's where most people are.","speakerId":"Ntt_DC270F89","textSource":"localization","pronounText":{"TextHeVersion":"Oh gosh no, 87% of the killings have happened indoors. Probably because that's where most people are.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":2200.0,"y":325.0},"source":{"file":"resources.assets","pathId":"35852","byteOffset":27910688,"byteLength":384}},{"id":"DFr_4AE020A3","articyId":"72057718591980083","type":"choice","className":"DialogueFragment","speaker":"Player","text":"Hold on... what debt?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Hold on... what debt?","TextSheVersion":"Hold on... what debt?","TextTheyVersion":"Hold on... what debt?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":3100.0,"y":325.0},"source":{"file":"resources.assets","pathId":"49329","byteOffset":33004848,"byteLength":304}},{"id":"DFr_7AA41A01","articyId":"72057718591980090","type":"line","className":"DialogueFragment","speaker":"Ava","text":"The debt from Thaddeus's Noodle Bar. When you took on the restaurant the debt came with it. Free of charge!","speakerId":"Ntt_DC270F89","textSource":"localization","pronounText":{"TextHeVersion":"The debt from Thaddeus's Noodle Bar. When you took on the restaurant the debt came with it. Free of charge!","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":3425.0,"y":300.0},"source":{"file":"resources.assets","pathId":"25864","byteOffset":17667352,"byteLength":388}},{"id":"DFr_2EACFA0B","articyId":"72057718591980097","type":"choice","className":"DialogueFragment","speaker":"Player","text":"That doesn't seem fair!","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"That doesn't seem fair!","TextSheVersion":"That doesn't seem fair!","TextTheyVersion":"That doesn't seem fair!"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":3725.0,"y":325.0},"source":{"file":"resources.assets","pathId":"42019","byteOffset":30223280,"byteLength":304}},{"id":"DFr_DAAA3DC3","articyId":"72057718591980104","type":"line","className":"DialogueFragment","speaker":"Ava","text":"The good news is, you can choose to spend a larger percentage of today's profits paying off the interest. 5% 10% or even 15%!","speakerId":"Ntt_DC270F89","textSource":"localization","pronounText":{"TextHeVersion":"The good news is, you can choose to spend a larger percentage of today's profits paying off the interest. 5% 10% or even 15%!","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":4025.0,"y":300.0},"source":{"file":"resources.assets","pathId":"23867","byteOffset":16908968,"byteLength":408}},{"id":"DFr_82801B9A","articyId":"72057718591980111","type":"choice","className":"DialogueFragment","speaker":"Player","text":"Why would I pay off more?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Why would I pay off more?","TextSheVersion":"Why would I pay off more?","TextTheyVersion":"Why would I pay off more?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":4347.06689453125,"y":351.20001220703125},"source":{"file":"resources.assets","pathId":"50625","byteOffset":33493208,"byteLength":308}},{"id":"DFr_8C7995FB","articyId":"72057718591980118","type":"line","className":"DialogueFragment","speaker":"Ava","text":"Well, if there was a killer on the loose targeting people with large debt responsibilities, I'd want that debt gone as quickly as possible.","speakerId":"Ntt_DC270F89","textSource":"localization","pronounText":{"TextHeVersion":"Well, if there was a killer on the loose targeting people with large debt responsibilities, I'd want that debt gone as quickly as possible.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":4647.06689453125,"y":326.20001220703125},"source":{"file":"resources.assets","pathId":"29497","byteOffset":19038368,"byteLength":420}},{"id":"DFr_39CB6B95","articyId":"72057718591980125","type":"choice","className":"DialogueFragment","speaker":"Player","text":"This is all a lot.","speakerId":"Ntt_4A96A8B1","textSource":"localization",