nations. I'll forward the funds to you once a week.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":5,"name":"Smile"},"position":{"x":3900.0,"y":375.0},"source":{"file":"resources.assets","pathId":"18343","byteOffset":14827736,"byteLength":444}},{"id":"DFr_257CE37B","articyId":"72057606922874455","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"I knew you're a good businessman!","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I knew you're a good businessman!","TextSheVersion":"I knew you're a good businessman!","TextTheyVersion":"I knew you're a good businessman!"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3600.0,"y":625.0},"source":{"file":"resources.assets","pathId":"23369","byteOffset":16720832,"byteLength":344}},{"id":"DFr_6FD8C1CB","articyId":"72057606922874463","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Thank you.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Thank you.","TextSheVersion":"Thank you.","TextTheyVersion":"Thank you."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":4500.0,"y":375.0},"source":{"file":"resources.assets","pathId":"49268","byteOffset":32980880,"byteLength":320}},{"id":"DFr_43156D14","articyId":"72057606922874469","type":"line","className":"DemeanorTemplate","speaker":"Clancy Pantermino","text":"Always a pleasure doing business with you. Have a nice day.","speakerId":"Ntt_CDA9F8FA","textSource":"localization","pronounText":{"TextHeVersion":"Always a pleasure doing business with you. Have a nice day.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":4800.0,"y":375.0},"source":{"file":"resources.assets","pathId":"42305","byteOffset":30332904,"byteLength":368}},{"id":"DFr_ACCECE2F","articyId":"72057606922874477","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Now you do. I own the noodle stand in Meridian market.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Now you do. I own the noodle stand in Meridian market.","TextSheVersion":"Now you do. I own the noodle stand in Meridian market.","TextTheyVersion":"Now you do. I own the noodle stand in Meridian market."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":300.0,"y":625.0},"source":{"file":"resources.assets","pathId":"22825","byteOffset":16519240,"byteLength":364}},{"id":"DFr_5CCF0FD2","articyId":"72057606922874499","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Your advertisement space.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Your advertisement space.","TextSheVersion":"Your advertisement space.","TextTheyVersion":"Your advertisement space."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2100.0,"y":625.0},"source":{"file":"resources.assets","pathId":"33954","byteOffset":20727512,"byteLength":336}},{"id":"DFr_9FDBA02E","articyId":"72057606922874491","type":"line","className":"DialogueFragment","speaker":"Clancy Pantermino","text":"I can give you something more valuable, though. Something that both of us will profit from.","speakerId":"Ntt_CDA9F8FA","textSource":"localization","pronounText":{"TextHeVersion":"I can give you something more valuable, though. Something that both of us will profit from.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1800.0,"y":375.0},"source":{"file":"resources.assets","pathId":"30071","byteOffset":19256168,"byteLength":408}},{"id":"DFr_7D549C6C","articyId":"72057606922874507","type":"line","className":"Dial