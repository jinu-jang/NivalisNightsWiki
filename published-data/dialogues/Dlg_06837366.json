{"schemaVersion":2,"dialogueId":"Dlg_06837366","title":"Marcelle Stops By Incognito","entry":"Dlg_06837366::entry","exit":"Dlg_06837366::exit","nodes":[{"id":"DFr_5351059B","articyId":"72057611217950655","type":"line","className":"DemeanorTemplate","speaker":"Marcelle DeNuite","text":"Your dishes already told me that.","speakerId":"Ntt_F55BAE21","textSource":"localization","pronounText":{"TextHeVersion":"Your dishes already told me that.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2225.0,"y":300.0},"source":{"file":"resources.assets","pathId":"42278","byteOffset":30323280,"byteLength":344}},{"id":"DFr_94C372B6","articyId":"72057611217950676","type":"line","className":"DemeanorTemplate","speaker":"Marcelle DeNuite","text":"Every dish tells a tale. These greenhouse-grown vegetables, this distinctly illegal but surprisingly excellent miso paste… they tell a story of endings and beginnings.","speakerId":"Ntt_F55BAE21","textSource":"localization","pronounText":{"TextHeVersion":"Every dish tells a tale. These greenhouse-grown vegetables, this distinctly illegal but surprisingly excellent miso paste… they tell a story of endings and beginnings.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2812.0,"y":250.0},"source":{"file":"resources.assets","pathId":"35642","byteOffset":27832024,"byteLength":480}},{"id":"DFr_B4B7B323","articyId":"72057611217950690","type":"line","className":"DemeanorTemplate","speaker":"Marcelle DeNuite","text":"Perhaps. Tell me, do you have rat meat on your menu?","speakerId":"Ntt_F55BAE21","textSource":"localization","pronounText":{"TextHeVersion":"Perhaps. Tell me, do you have rat meat on your menu?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3386.0,"y"