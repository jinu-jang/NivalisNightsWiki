","className":"DemeanorTemplate","speaker":"Player","text":"I'm just trying to help a kid.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I'm just trying to help a kid.","TextSheVersion":"I'm just trying to help a kid.","TextTheyVersion":"I'm just trying to help a kid."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1325.0,"y":600.0},"source":{"file":"resources.assets","pathId":"47822","byteOffset":32426856,"byteLength":340}},{"id":"DFr_26F8AA89","articyId":"72057606922877504","type":"line","className":"DemeanorTemplate","speaker":"Mary-Nyx Curzona","text":"Always talking when you should be listening. You think that kid has it bad? We can make your life far worse. And shorter.","speakerId":"Ntt_1672A850","textSource":"localization","pronounText":{"TextHeVersion":"Always talking when you should be listening. You think that kid has it bad? We can make your life far worse. And shorter.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1625.0,"y":475.0},"source":{"file":"resources.assets","pathId":"36294","byteOffset":28076448,"byteLength":468}},{"id":"DFr_3BBF1A87","articyId":"72057606922877511","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Don't see that it's any of your business.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Don't see that it's any of your business.","TextSheVersion":"Don't see that it's any of your business.","TextTheyVersion":"Don't see that it's any of your business."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1925.0,"y":350.0},"source":{"file":"resources.assets","pathId":"38791","byteOffset":29007984,"byteLength":352}},{"id":"DFr_A23F47E8","articyId":"72057606922877518","type":"line","className":"DemeanorTemplate","speaker":"Mary-N