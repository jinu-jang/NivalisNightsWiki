{"schemaVersion":2,"dialogueId":"Dlg_C2A6308B","title":"Meet Gladstone after the quest","entry":"Dlg_C2A6308B::entry","exit":"Dlg_C2A6308B::exit","nodes":[{"id":"DFr_D6A1C729","articyId":"72057606922863105","type":"line","className":"DemeanorTemplate","speaker":"Gladstone","text":"You again?","speakerId":"Ntt_B44D6973","textSource":"localization","pronounText":{"TextHeVersion":"You again?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":625.0,"y":425.0},"source":{"file":"resources.assets","pathId":"36257","byteOffset":28063112,"byteLength":320}},{"id":"DFr_AF173374","articyId":"72057606922863112","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"How are your little companions doing?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"How are your little companions doing?","TextSheVersion":"How are your little companions doing?","TextTheyVersion":"How are your little companions doing?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":925.0,"y":425.0},"source":{"file":"resources.assets","pathId":"40568","byteOffset":29676016,"byteLength":348}},{"id":"DFr_4A60C97C","articyId":"72057606922863119","type":"line","className":"DemeanorTemplate","speaker":"Gladstone","text":"Not my companions. We don't compare.","speakerId":"Ntt_B44D6973","textSource":"localization","pronounText":{"TextHeVersion":"Not my companions. We don't compare.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1225.0,"y":425.0},"source":{"file":"resources.assets","pathId":"51672","byteOffset":33963368,"byteLength":380}},{"id":"DFr_D1C01A44","articyId":"72057606922863126","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"How come?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"How come?","TextSheVersion":"How come?","TextTheyVersion":"How come?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1525.0,"y":300.0},"source":{"file":"resources.assets","pathId":"26521","byteOffset":17913104,"byteLength":320}},{"id":"DFr_7A5F8E33","articyId":"72057606922863133","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"I remember you calling them your furry little angels.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I remember you calling them your furry little angels.","TextSheVersion":"I remember you calling them your furry little angels.","TextTheyVersion":"I remember you calling them your furry little angels."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1525.0,"y":550.0},"source":{"file":"resources.assets","pathId":"51747","byteOffset":33993272,"byteLength":364}},{"id":"DFr_483810BF","articyId":"72057606922863140","type":"line","className":"DemeanorTemplate","speaker":"Gladstone","text":"I had to learn they don't like that.","speakerId":"Ntt_B44D6973","textSource":"localization","pronounText":{"TextHeVersion":"I had to learn they don't like that.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1825.0,"y":550.0},"source":{"file":"resources.assets","pathId":"36149","byteOffset":28022808,"byteLength":344}},{"id":"DFr_632472FA","articyId":"72057606922863147","type":"line","className":"DemeanorTemplate","speaker":"Gladstone","text":"They're gonna rule once their plot is complete. So I gotta show them respect!","speakerId":"Ntt_B44D6973","textSource":"localization","pronounText":{"TextHeVersion":"They're gonna rule once their plot is complete. So I gotta show them respect!","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2125.0,"y":550.0},"source":{"file":"resources.assets","pathId":"37780","byteOffset":28628968,"byteLength":388}},{"id":"DFr_F422255A","articyId":"72057606922863154","type":"line","className":"DemeanorTemplate","speaker":"Gladstone","text":"Have you ever seen rats congregating, packing, and attacking as one?","speakerId":"Ntt_B44D6973","textSource":"localization","pronounText":{"TextHeVersion":"Have you ever seen rats congregating, packing, and attacking as one?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1825.0,"y":300.0},"source":{"file":"resources.assets","pathId":"35887","byteOffset":27923752,"byteLength":376}},{"id":"DFr_11B49065","articyId":"72057606922863161","type":"line","className":"DemeanorTemplate","speaker":"Gladstone","text":"They don't do that. Unlike humans.","speakerId":"Ntt_B44D6973","textSource":"localization","pronounText":{"TextHeVersion":"They don't do that. Unlike humans.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2125.0,"y":300.0},"source":{"file":"resources.assets","pathId":"33126","byteOffset":20415256,"byteLength":344}},{"id":"DFr_E1187654","articyId":"72057606922863168","type":"line","className":"DemeanorTemplate","speaker":"Gladstone","text":"They're not like us. They are not going to eat us.","speakerId":"Ntt_B44D6973","textSource":"localization","pronounText":{"TextHeVersion":"They're not like us. They are not going to eat us.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2425.0,"y":300.0},"source":{"file":"resources.assets","pathId":"45209","byteOffset":31437232,"byteLength":360}},{"id":"DFr_6D03BFBC","articyId":"72057606922863175","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Afraid of them?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Afraid of them?","TextSheVersion":"Afraid of them?","TextTheyVersion":"Afraid of them?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2425.0,"y":550.0},"source":{"file":"resources.assets","pathId":"23954","byteOffset":16941648,"byteLength":324}},{"id":"DFr_6905763C","articyId":"72057606922863183","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"But you bow to their king?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"But you bow to their king?","TextSheVersion":"But you bow to their king?","TextTheyVersion":"But you bow to their king?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2725.0,"y":300.0},"source":{"file":"resources.assets","pathId":"50730","byteOffset":33532544,"byteLength":336}},{"id":"DFr_B5542F59","articyId":"72057606922863190","type":"line","className":"DemeanorTemplate","speaker":"Gladstone","text":"Out of respect, not fear. And in order to better understand him, to be honest.","speakerId":"Ntt_B44D6973","textSource":"localization","pronounText":{"TextHeVersion":"Out of respect, not fear. And in order to better understand him, to be honest.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3025.0,"y":425.0},"source":{"file":"resources.assets","pathId":"41955","byteOffset":30198864,"byteLength":388}},{"id":"DFr_0738961D","articyId":"72057606922863197","type":"line","className":"DemeanorTemplate","speaker":"Gladstone","text":"Not exactly a loudmouth. Not human. They've got time.","speakerId":"Ntt_B44D6973","textSource":"localization","pronounText":{"TextHeVersion":"Not exactly a loudmouth. Not human. They've got time.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3325.0,"y":425.0},"source":{"file":"resources.assets","pathId":"48767","byteOffset":32786872,"byteLength":400}},{"id":"DFr_A671943E","articyId":"72057606922863204","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Doesn't compare, I get it.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Doesn't compare, I get it.","TextSheVersion":"Doesn't compare, I get it.","TextTheyVersion":"Doesn't compare, I get it."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3625.0,"y":300.0},"source":{"file":"resources.assets","pathId":"49416","byteOffset":33036488,"byteLength":336}},{"id":"DFr_A2E0BE26","articyId":"72057606922863211","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"One electric cable at a time, I get it.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"One electric cable at a time, I get it.","TextSheVersion":"One electric cable at a time, I get it.","TextTheyVersion":"One electric cable at a time, I get it."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3625.0,"y":550.0},"source":{"file":"resources.assets","pathId":"43066","byteOffset":30622552,"byteLength":348}},{"id":"DFr_FFC5E541","articyId":"72057606922863218","type":"line","className":"DemeanorTemplate","speaker":"Gladstone","text":"So what do you want?","speakerId":"Ntt_B44D6973","textSource":"localization","pronounText":{"TextHeVersion":"So what do you want?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3925.0,"y":425.0},"source":{"file":"resources.assets","pathId":"46799","byteOffset":32035568,"byteLength":328}},{"id":"DFr_706399E1","articyId":"72057606922863226","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"I thought maybe you would like to have a regular job with a fixed income.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I thought maybe you would like to have a regular job with a fixed income.","TextSheVersion":"I thought maybe you would like to have a regular job with a fixed income.","TextTheyVersion":"I thought maybe you would like to have a regular job with a fixed income."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":4225.0,"y":425.0},"source":{"file":"resources.assets","pathId":"45801","byteOffset":31659904,"byteLength":384}},{"id":"DFr_DEB1BE31","articyId":"72057606922863233","type":"line","className":"DemeanorTemplate","speaker":"Gladstone","text":"Maybe you can't tell from the outside, but I'm not a nine-to-five kind of guy.","speakerId":"Ntt_B44D6973","textSource":"localization","pronounText":{"TextHeVersion":"Maybe you can't tell from the outside, but I'm not a nine-to-five kind of guy.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":4525.0,"y":425.0},"source":{"file":"resources.assets","pathId":"44237","byteOffset":31069432,"byteLength":424}},{"id":"DFr_B992BA57","articyId":"72057606922863240","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"That's not what I meant.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"That's not what I meant.","TextSheVersion":"That's not what I meant.","TextTheyVersion":"That's not what I meant."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":4825.0,"y":300.0},"source":{"file":"resources.assets","pathId":"50094","byteOffset":33294224,"byteLength":332}},{"id":"DFr_E1E128FC","articyId":"72057606922863247","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Too bad. I need a rat meat specialist!","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Too bad. I need a rat meat specialist!","TextSheVersion":"Too bad. I need a rat meat specialist!","TextTheyVersion":"Too bad. I need a rat meat specialist!"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":4825.0,"y":550.0},"source":{"file":"resources.assets","pathId":"29677","byteOffset":19108440,"byteLength":348}},{"id":"DFr_C12F733D","articyId":"72057606922863254","type":"line","className":"DemeanorTemplate","speaker":"Gladstone","text":"So what's it then?","speakerId":"Ntt_B44D6973","textSource":"localization","pronounText":{"TextHeVersion":"So what's it then?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":5125.0,"y":300.0},"source":{"file":"resources.assets","pathId":"44035","byteOffset":30994752,"byteLength":328}},{"id":"DFr_A5B1DC87","articyId":"72057606922863261","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"I need five portions of rat meat a day, delivered fresh and without intermediaries.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I need five portions of rat meat a day, delivered fresh and without intermediaries.","TextSheVersion":"I need five portions of rat meat a day, delivered fresh and without intermediaries.","TextTheyVersion":"I need five portions of rat meat a day, delivered fresh and without intermediaries."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":5425.0,"y":300.0},"source":{"file":"resources.assets","pathId":"31129","byteOffset":19657544,"byteLength":392}},{"id":"DFr_EDFB73AC","articyId":"72057606922863268","type":"line","className":"DemeanorTemplate","speaker":"Gladstone","text":"Didn't I tell you I converted? Not killing rats anymore. I've seen the light.","speakerId":"Ntt_B44D6973","textSource":"localization","pronounText":{"TextHeVersion":"Didn't I tell you I converted? Not killing rats anymore. I've seen the light.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":5725.0,"y":300.0},"source":{"file":"resources.assets","pathId":"46797","byteOffset":32034848,"byteLength":388}},{"id":"DFr_46B53C4E","articyId":"72057606922863275","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"You did. But you gotta make a living, too!","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"You did. But you gotta make a living, too!","TextSheVersion":"You did. But you gotta make a living, too!","TextTheyVersion":"You did. But you gotta make a living, too!"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":6025.0,"y":425.0},"source":{"file":"resources.assets","pathId":"41652","byteOffset":30086376,"byteLength":352}},{"id":"DFr_45670B96","articyId":"72057606922863282","type":"line","className":"DemeanorTemplate","speaker":"Gladstone","text":"Oh, I do. Or I will. Just founded a start-up, showing tourists the underbelly of the city, the places where our little furry overlords dwell.","speakerId":"Ntt_B44D6973","textSource":"localization","pronounText":{"TextHeVersion":"Oh, I do. Or I will. Just founded a start-up, showing tourists the underbelly of the city, the places where our little furry overlords dwell.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":6325.0,"y":425.0},"source":{"file":"resources.assets","pathId":"40193","byteOffset":29536104,"byteLength":488}},{"id":"DFr_16706754","articyId":"72057606922863289","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Not a lot of tourists around right now, in the LUZ.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Not a lot of tourists around right now, in the LUZ.","TextSheVersion":"Not a lot of tourists around right now, in the LUZ.","TextTheyVersion":"Not a lot of tourists around right now, in the LUZ."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":6625.0,"y":300.0},"source":{"file":"resources.assets","pathId":"41633","byteOffset":30078440,"byteLength":360}},{"id":"DFr_EF56C2CA","articyId":"72057606922863296","type":"line","className":"DemeanorTemplate","speaker":"Gladstone","text":"That's temporary. As soon as the city opens up again, my business will explode!","speakerId":"Ntt_B44D6973","textSource":"localization","pronounText":{"TextHeVersion":"That's temporary. As soon as the city opens up again, my business will explode!","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":6925.0,"y":300.0},"source":{"file":"resources.assets","pathId":"24324","byteOffset":17078648,"byteLength":388}},{"id":"DFr_4871F0E3","articyId":"72057606922863303","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"So no rat meat delivery?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"So no rat meat delivery?","TextSheVersion":"So no rat meat delivery?","TextTheyVersion":"So no rat meat delivery?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":7225.0,"y":425.0},"source":{"file":"resources.assets","pathId":"32434","byteOffset":20152672,"byteLength":332}},{"id":"DFr_2594739D","articyId":"72057606922863310","type":"line","className":"DemeanorTemplate","speaker":"Gladstone","text":"You heard me, man. No killing rats anymore. Had my Damascus moment.","speakerId":"Ntt_B44D6973","textSource":"localization","pronounText":{"TextHeVersion":"You heard me, man. No killing rats anymore. Had my Damascus moment.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":7525.0,"y":425.0},"source":{"file":"resources.assets","pathId":"18801","byteOffset":15000200,"byteLength":376}},{"id":"DFr_57748052","articyId":"72057606922863318","type":"line","className":"DemeanorTemplate","speaker":"Gladstone","text":"Not me. You're too late. That ship has sailed. And the rats aren't leaving it.","speakerId":"Ntt_B44D6973","textSource":"localization","pronounText":{"TextHeVersion":"Not me. You're too late. That ship has sailed. And the rats aren't leaving it.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":5125.0,"y":550.0},"source":{"file":"resources.assets","pathId":"50214","byteOffset":33338592,"byteLength":388}},{"id":"DFr_35DE4C43","articyId":"72057606922863325","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"So who can help me?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"So who can help me?","TextSheVersion":"So who can help me?","TextTheyVersion":"So who can help me?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":5425.0,"y":550.0},"source":{"file":"resources.assets","pathId":"51559","byteOffset":33922584,"byteLength":328}},{"id":"DFr_480B596D","articyId":"72057606922863332","type":"line","className":"DemeanorTemplate","speaker":"Gladstone","text":"I told you I converted, right? I can't kill rats anymore. Not gonna tell you who does. I've seen the light.","speakerId":"Ntt_B44D6973","textSource":"localization","pronounText":{"TextHeVersion":"I told you I converted, right? I can't kill rats anymore. Not gonna tell you who does. I've seen the light.","TextSheVersion":"~","Te