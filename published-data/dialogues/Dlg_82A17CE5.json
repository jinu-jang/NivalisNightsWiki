{"schemaVersion":2,"dialogueId":"Dlg_82A17CE5","title":"Salt Pete and the Truth","entry":"Dlg_82A17CE5::entry","exit":"Dlg_82A17CE5::exit","nodes":[{"id":"DFr_B609C81F","articyId":"72057645577642018","type":"line","className":"DemeanorTemplate","speaker":"Salt Pete","text":"Hey Mariner, you don't look too cheery. And I don't see the Captain.","speakerId":"Ntt_87542622","textSource":"localization","pronounText":{"TextHeVersion":"Hey Mariner, you don't look too cheery. And I don't see the Captain.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":6,"name":"Sad"},"position":{"x":450.0,"y":425.0},"source":{"file":"resources.assets","pathId":"43668","byteOffset":30848784,"byteLength":376}},{"id":"DFr_26ED3294","articyId":"72057645577642041","type":"line","className":"DemeanorTemplate","speaker":"Salt Pete","text":"I see...","speakerId":"Ntt_87542622","textSource":"localization","pronounText":{"TextHeVersion":"I see...","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":6,"name":"Sad"},"position":{"x":1650.0,"y":425.0},"source":{"file":"resources.assets","pathId":"20716","byteOffset":15721840,"byteLength":352}},{"id":"DFr_E570D35D","articyId":"72057645577642024","type":"choice","className":"DialogueFragment","speaker":"Player","text":"Crabface told me what happened.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Crabface told me what happened.","TextSheVersion":"Crabface told me what happened.","TextTheyVersion":"Crabface told me what happened."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":750.0,"y":425.0},"source":{"file":"resources.assets","pathId":"42965","byteOffset":30584376,"byteLength":312}},{"id":"DFr_D3FF2A0F","articyId":"72057645577642030","type":"line","className":"DialogueFragment","speaker":"Salt Pete","text":"He did, did he? And the Captain?","speakerId":"Ntt_87542622","textSource":"localization","pronounText":{"TextHeVersion":"He did, did he? And the Captain?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1050.0,"y":425.0},"source":{"file":"resources.assets","pathId":"22954","byteOffset":16568240,"byteLength":312}},{"id":"DFr_17C4F084","articyId":"72057645577642035","type":"choice","className":"DialogueFragment","speaker":"Player","text":"I got all the pieces, but Crabface said the real Captain was lost. It was junk.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I got all the pieces, but Crabface said the real Captain was lost. It was junk.","TextSheVersion":"I got all the pieces, but Crabface said the real Captain was lost. It was junk.","TextTheyVersion":"I got all the pieces, but Crabface said the real Captain was lost. It was junk."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1350.0,"y":425.0},"source":{"file":"resources.assets","pathId":"35111","byteOffset":25643904,"byteLength":360}},{"id":"DFr_7439FD95","articyId":"72057645577642046","type":"choice","className":"DialogueFragment","speaker":"Player","text":"You knew.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"You knew.","TextSheVersion":"You knew.","TextTheyVersion":"You knew."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1950.0,"y":300.0},"source":{"file":"resources.assets","pathId":"33793","byteOffset":20667040,"byteLength":292}},{"id":"DFr_7A84A182","articyId":"72057645577642052","type":"line","className":"DialogueFragment","speaker":"Salt Pete","text":"Ah, don't fret. I suspected as much. Old Crabface can barely catch a virus, far less dredge up a lost sea captain. I suspected he was trying to give us some peace of mind. He's a rusty old bastard, but I get it.","speakerId":"Ntt_87542622","textSource":"localization","pronounText":{"TextHeVersion":"Ah, don't fret. I suspected as much. Old Crabface can barely catch a virus, far less dredge up a lost sea captain. I suspected he was trying to give us some peace of mind. He's a rusty old bastard, but I get it.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":2250.0,"y":425.0},"source":{"file":"resources.assets","pathId":"25323","byteOffset":17464632,"byteLength":492}},{"id":"DFr_81E5E63A","articyId":"72057645577642057","type":"choice","className":"DialogueFragment","speaker":"Player","text":"What really happened?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"What really happened?","TextSheVersion":"What really happened?","TextTheyVersion":"What really happened?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":2550.0,"y":425.0},"source":{"file":"resources.assets","pathId":"25733","byteOffset":17619272,"byteLength":304}},{"id":"DFr_994A8D73","articyId":"72057645577642080","type":"choice","className":"DialogueFragment","speaker":"Player","text":"I'm sorry.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I'm sorry.","TextSheVersion":"I'm sorry.","TextTheyVersion":"I'm sorry."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":1950.0,"y":525.0},"source":{"file":"resources.assets","pathId":"37141","byteOffset":28392720,"byteLength":292}},{"id":"DFr_4E7E7568","articyId":"72057645577642091","type":"line","className":"DialogueFragment","speaker":"Salt Pete","text":"We was bickering as usual. Captain was trying to get us to pull together in the middle of a storm. But we was all obsessed. Looking for The Gridless Sea. She went in the drink, and we all blamed each other. And ourselves.","speakerId":"Ntt_87542622","textSource":"localization","pronounText":{"TextHeVersion":"We was bickering as usual. Captain was trying to get us to pull together in the middle of a storm. But we was all obsessed. Looking for The Gridless Sea. She went in the drink, and we all blamed each other. And ourselves.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":2850.0,"y":400.0},"source":{"file":"resources.assets","pathId":"35735","byteOffset":27867552,"byteLength":504}},{"id":"DFr_6D972B61","articyId":"72057645577642098","type":"choice","className":"DialogueFragment","speaker":"Player","text":"What IS The Gridless Sea?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"What IS The Gridless Sea?","TextSheVersion":"What IS The Gridless Sea?","TextTheyVersion":"What IS The Gridless Sea?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":3150.0,"y":425.0},"source":{"file":"resources.assets","pathId":"36605","byteOffset":28192416,"byteLength":308}},{"id":"DFr_EE4CF6C6","articyId":"72057645577642105","type":"line","className":"DialogueFragment","speaker":"Salt Pete","text":"That's what we was all arguing about. Caleb thought it was a way out of Nivalis, to a better place. A current that swept you out to a new land. A better place for all of us.","speakerId":"Ntt_87542622","textSource":"localization","pronounText":{"TextHeVersion":"That's what we was all arguing about. Caleb thought it was a way out of Nivalis, to a better place. A current that swept you out to a new land. A better place for all of us.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":3450.0,"y":400.0},"source":{"file":"resources.assets","pathId":"46483","byteOffset":31919152,"byteLength":492}},{"id":"DFr_65A97D44","articyId":"72057645577642112","type":"choice","className":"DialogueFragment","speaker":"Player","text":"What about the others?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"What about the others?","TextSheVersion":"What about the others?","TextTheyVersion":"What about the others?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":3750.0,"y":300.0},"source":{"file":"resources.assets","pathId":"50950","byteOffset":33615480,"byteLength":304}},{"id":"DFr_F6AD49A8","articyId":"72057645577642119","type":"line","className":"DialogueFragment","speaker":"Salt Pete","text":"The Captain and Karel both believed the same thing. That The Gridless Sea goes on forever. That we could sail over the horizon and keep going forever - cos this world is flat.","speakerId":"Ntt_87542622","textSource":"localization","pronounText":{"TextHeVersion":"The Captain and Karel both believed the same thing. That The Gridless Sea goes on forever. That we could sail over the horizon and keep going forever - cos this world is flat.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":4050.0,"y":400.0},"source":{"file":"resources.assets","pathId":"28933","byteOffset":18828792,"byteLength":492}},{"id":"DFr_674CE82E","articyId":"72057645577642126","type":"choice","className":"DialogueFragment","speaker":"Player","text":"...Flat?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"...Flat?","TextSheVersion":"...Flat?","TextTheyVersion":"...Flat?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":4350.0,"y":300.0},"source":{"file":"resources.assets","pathId":"43486","byteOffset":30780448,"byteLength":288}},{"id":"DFr_A0E4D9C3","articyId":"72057645577642133","type":"line","className":"DialogueFragment","speaker":"Salt Pete","text":"Aye. I never said they was the brightest sparks in the sea, you know? They had some mad theory - that The Gridless Sea is infinite, and the world is made up of little boxes or something? They talked some real nonsense during those long ocean voyages.","speakerId":"Ntt_87542622","textSource":"localization","pronounText":{"TextHeVersion":"Aye. I never said they was the brightest sparks in the sea, you know? They had some mad theory - that The Gridless Sea is infinite, and the world is made up of little boxes or something? They talked some real nonsense during those long ocean voyages.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":4650.0,"y":400.0},"source":{"file":"resources.assets","pathId":"36206","byteOffset":28044040,"byteLength":532}},{"id":"DFr_03830B35","articyId":"72057645577642140","type":"choice","className":"DialogueFragment","speaker":"Player","text":"And what did you think?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"And what did you think?","TextSheVersion":"And what did you think?","TextTheyVersion":"And what did you think?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":4950.0,"y":425.0},"source":{"file":"resources.assets","pathId":"49300","byteOffset":32992888,"byteLength":304}},{"id":"DFr_268DA31B","articyId":"72057645577642147","type":"line","className":"DialogueFragment","speaker":"Salt Pete","text":"Out on one of those voyages, I saw something that changed my view of not just The Gridless Sea, but all of Nivalis.","speakerId":"Ntt_87542622","textSource":"localization","pronounText":{"TextHeVersion":"Out on one of those voyages, I saw something that changed my view of not just The Gridless Sea, but all of Nivalis.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":5250.0,"y":400.0},"source":{"file":"resources.assets","pathId":"22911","byteOffset":16552072,"byteLength":396}},{"id":"DFr_8604E650","articyId":"72057645577642154","type":"choice","className":"DialogueFragment","speaker":"Player","text":"What did you see?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"What did you see?","TextSheVersion":"What did you see?","TextTheyVersion":"What did you see?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":5575.0,"y":425.0},"source":{"file":"resources.assets","pathId":"39388","byteOffset":29231416,"byteLength":300}},{"id":"DFr_9B0B614C","articyId":"72057645577642161","type":"line","className":"DialogueFragment","speaker":"Salt Pete","text":"Ah, that's a secret that best dies with me. I wish I didn't learn the truth. If I hadn't been so obsessed with The Gridless Sea, maybe I'd still have a Captain... and good friends.","speakerId":"Ntt_87542622","textSource":"localization","pronounText":{"TextHeVersion":"Ah, that's a secret that best dies with me. I wish I didn't learn the truth. If I hadn't been so obsessed with The Gridless Sea, maybe I'd still have a Captain... and good friends.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":5875.0,"y":400.0},"source":{"file":"resources.assets","pathId":"35690","byteOffset":27850328,"byteLength":460}},{"id":"DFr_9E4DB9E5","articyId":"72057821671326866","type":"choice","className":"DialogueFragment","speaker":"Player","text":"We all dream of something like that.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"We all dream of something like that.","TextSheVersion":"We all dream of something like that.","TextTheyVersion":"We all dream of something like that."},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":3750.0,"y":550.0},"source":{"file":"resources.assets","pathId":"44336","byteOffset":31105048,"byteLength":316}},{"id":"DFr_744230AF","articyId":"72057821671326874","type":"choice","className":"DialogueFragment","speaker":"Player","text":"Seriously?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Seriously?","TextSheVersion":"Seriously?","TextTheyVersion":"Seriously?"},"effects":[],"conditions":[],"script":"","demeanor":null,"position":{"x":4350.0,"y":550.0},"source":{"file":"resources.assets","pathId":"51848","byteOffset":34031272,"byteLength":292}},{"id":"Dlg_82A17CE5::entry","type":"entry","text":"Salt Pete and the Truth","speaker":null,"effects":[],"conditions":[]},{"id":"Dlg_82A17CE5::exit","type":"exit","text":"Salt Pete and the Truth","speaker":null,"effects":[],"conditions":[]},{"id":"Dlg_F2E69E4B","type":"external","text":"Ava has one last lead","speaker":null,"effects":[],"conditions":[],"source":{"file":"resources.assets","pathId":"36946","byteOffset":28321120,"byteLength":412},"dialogueId":"Dlg_F2E69E4B"}],"edges":[{"id":"Dlg_82A17CE5::entry:72057645577641314:0","from":"Dlg_82A17CE5::entry","to":"DFr_B609C81F","fromPin":"72057645577641314","toPin":"72057645577642021","targetPinRole":"input","pinOrder":0,"order":0,"label":"","effects":[],"script":"","conditions":[]},{"id":"DFr_B609C81F:72057645577642022:0","from":"DFr_B609C81F","to":"DFr_E570D35D","fromPin":"72057645577642022","toPin":"72057645577642027","targetPinRole":"input","pinOrder":0,"order":0,"label":"","effects":[],"script":"","conditions":[]},{"id":"DFr_26ED3294:72057645577642043:0","from":"DFr_26ED3294","to":"DFr_7439FD95","fromPin":"72057645577642043","toPin":"72057645577642047","targetPinRole":"input","pinOrder":0,"order":0,"label":"","effects":[],"script":"","conditions":[]},{"id":"DFr_26ED3294:72057645577642043:1","from":"DFr_26ED3294","to":"DFr_994A8D73","fromPin":"72057645577642043","toPin":"72057645577642081","targetPinRole":"input","pinOrder":0,"order":1,"label":"","effects":[],"script":"","conditions":[]},{"id":"DFr_E570D35D:72057645577642028:0","from":"DFr_E570D35D","to":"DFr_D3FF2A0F","fromPin":"72057645577642028","toPin":"72057645577642031","targetPinRole":"input","pinOrder":0,"order":0,"label":"","effects":[],"script":"","conditions":[]},{"id":"DFr_D3FF2A0F:72057645577642032:0","from":"DFr_D3FF2A0F","to":"DFr_17C4F084","fromPin":"72057645577642032","toPin":"72057645577642036","targetPinRole":"input","pinOrder":0,"order":0,"label":"","effects":[],"script":"","conditions":[]},{"id":"DFr_17C4F084:72057645577642037:0"