{"schemaVersion":2,"dialogueId":"Dlg_C5A1B698","title":"Lynnphora says goodbye","entry":"Dlg_C5A1B698::entry","exit":"Dlg_C5A1B698::exit","nodes":[{"id":"DFr_46A042F1","articyId":"72057821671326650","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"I threw the ashes into the endless waves of the sea.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I threw the ashes into the endless waves of the sea.","TextSheVersion":"I threw the ashes into the endless waves of the sea.","TextTheyVersion":"I threw the ashes into the endless waves of the sea."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":700.0,"y":300.0},"source":{"file":"resources.assets","pathId":"41843","byteOffset":30157960,"byteLength":420}},{"id":"DFr_9DCDBD1F","articyId":"72057821671326656","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"(lie) I let him run free in the winds by the seaside. He'll hunt seagulls.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"(lie) I let him run free in the winds by the seaside. He'll hunt seagulls.","TextSheVersion":"(lie) I let him run free in the winds by the seaside. He'll hunt seagulls.","TextTheyVersion":"(lie) I let him run free in the winds by the seaside. He'll hunt seagulls."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":700.0,"y":800.0},"source":{"file":"resources.assets","pathId":"34123","byteOffset":20790976,"byteLength":420}},{"id":"DFr_100B97B8","articyId":"72057821671326662","type":"line","className":"DemeanorTemplate","speaker":"Lynnphora Adams","text":"Oh, hi! So what did you decide to do?","speakerId":"Ntt_F651C091","textSource":"localization","pronounText":{"TextHeVersion":"Oh, hi! So what did you decide to do?","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":400.0,"y":550.0},"source":{"file":"resources.assets","pathId":"33405","byteOffset":20522744,"byteLength":420}},{"id":"DFr_88B0E13C","articyId":"72057821671326670","type":"line","className":"DemeanorTemplate","speaker":"Lynnphora Adams","text":"Thank you. He would have loved this. But I simply couldn't do it.","speakerId":"Ntt_F651C091","textSource":"localization","pronounText":{"TextHeVersion":"Thank you. He would have loved this. But I simply couldn't do it.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1000.0,"y":300.0},"source":{"file":"resources.assets","pathId":"44886","byteOffset":31315232,"byteLength":376}},{"id":"DFr_D8ABBDC0","articyId":"72057821671326677","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"He's resting now and so should you, in a different way.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"He's resting now and so should you, in a different way.","TextSheVersion":"He's resting now and so should you, in a different way.","TextTheyVersion":"He's resting now and so should you, in a different way."},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1300.0,"y":300.0},"source":{"file":"resources.assets","pathId":"42251","byteOffset":30312576,"byteLength":392}},{"id":"DFr_6A7D1D11","articyId":"72057821671326684","type":"line","className":"DemeanorTemplate","speaker":"Lynnphora Adams","text":"In a way, yes. We're both at peace now. Thank you, with all my heart.","speakerId":"Ntt_F651C091","textSource":"localization","pronounText":{"TextHeVersion":"In a way, yes. We're both at peace now. Thank you, with all my heart.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1600.0,"y":300.0},"source":{"file":"resourc