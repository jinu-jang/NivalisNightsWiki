xtSheVersion":"And what guarantee do I have that you're telling me the truth?","TextTheyVersion":"And what guarantee do I have that you're telling me the truth?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":2950.0,"y":300.0},"source":{"file":"resources.assets","pathId":"39360","byteOffset":29220728,"byteLength":372}},{"id":"DFr_94C8224A","articyId":"72057821671271438","type":"line","className":"DemeanorTemplate","speaker":"Rollo","text":"I'm a serious businessman. I'm strongarming people, not lying to them.","speakerId":"Ntt_9A01C4FA","textSource":"localization","pronounText":{"TextHeVersion":"I'm a serious businessman. I'm strongarming people, not lying to them.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3250.0,"y":300.0},"source":{"file":"resources.assets","pathId":"23757","byteOffset":16869024,"byteLength":380}},{"id":"DFr_E188937B","articyId":"72057821671271451","type":"line","className":"DemeanorTemplate","speaker":"Rollo","text":"You can meet Nabla in the Stacks. Tomorrow.","speakerId":"Ntt_9A01C4FA","textSource":"localization","pronounText":{"TextHeVersion":"You can meet Nabla in the Stacks. Tomorrow.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":3850.0,"y":425.0},"source":{"file":"resources.assets","pathId":"51867","byteOffset":34037840,"byteLength":388}},{"id":"DFr_C7F035D3","articyId":"72057821671271458","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"At night?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"At night?","TextSheVersion":"At night?","TextTheyVersion":"At night?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":4150.0,"y":300.0},"source":{"file":"resources.assets","pathI