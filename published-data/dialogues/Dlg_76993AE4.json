{"schemaVersion":2,"dialogueId":"Dlg_76993AE4","title":"Rollo in the Spire","entry":"Dlg_76993AE4::entry","exit":"Dlg_76993AE4::exit","nodes":[{"id":"DFr_BC43AD40","articyId":"72057821671271368","type":"line","className":"DemeanorTemplate","speaker":"Rollo","text":"I love it, when debtors finally appear to pay their debt.","speakerId":"Ntt_9A01C4FA","textSource":"localization","pronounText":{"TextHeVersion":"I love it, when debtors finally appear to pay their debt.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":-350.0,"y":425.0},"source":{"file":"resources.assets","pathId":"46503","byteOffset":31926600,"byteLength":404}},{"id":"DFr_86B9CA38","articyId":"72057821671271375","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"Help my memories: Since when do I owe you money?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"Help my memories: Since when do I owe you money?","TextSheVersion":"Help my memories: Since when do I owe you money?","TextTheyVersion":"Help my memories: Since when do I owe you money?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":-50.0,"y":300.0},"source":{"file":"resources.assets","pathId":"41262","byteOffset":29937504,"byteLength":356}},{"id":"DFr_B2F789BD","articyId":"72057821671271382","type":"line","className":"DemeanorTemplate","speaker":"Rollo","text":"A certain hacker involved me in a wild goose chase. Sending you running all over the city.","speakerId":"Ntt_9A01C4FA","textSource":"localization","pronounText":{"TextHeVersion":"A certain hacker involved me in a wild goose chase. Sending you running all over the city.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":250.0,"y":300.0},"source":{"file":"resources.assets","pathId":"35941","byteOffset":27944992,"byteLength":400}},{"id":"DFr_EA99C5EB","articyId":"72057821671271389","type":"line","className":"DemeanorTemplate","speaker":"Rollo","text":"Technically it's not really a debt, but a... fee. You owe me my fee.","speakerId":"Ntt_9A01C4FA","textSource":"localization","pronounText":{"TextHeVersion":"Technically it's not really a debt, but a... fee. You owe me my fee.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":550.0,"y":425.0},"source":{"file":"resources.assets","pathId":"52053","byteOffset":34107656,"byteLength":412}},{"id":"DFr_039CBD1C","articyId":"72057821671271396","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"How much?","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"How much?","TextSheVersion":"How much?","TextTheyVersion":"How much?"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":850.0,"y":300.0},"source":{"file":"resources.assets","pathId":"42102","byteOffset":30254096,"byteLength":320}},{"id":"DFr_DA15D7A7","articyId":"72057821671271403","type":"line","className":"DemeanorTemplate","speaker":"Rollo","text":"100 Lims. Special discount price, for my close friends.","speakerId":"Ntt_9A01C4FA","textSource":"localization","pronounText":{"TextHeVersion":"100 Lims. Special discount price, for my close friends.","TextSheVersion":"~","TextTheyVersion":"~"},"effects":[],"conditions":[],"script":"","demeanor":{"value":0,"name":"Unspecified"},"position":{"x":1150.0,"y":425.0},"source":{"file":"resources.assets","pathId":"19081","byteOffset":15105040,"byteLength":364}},{"id":"DFr_EF02C472","articyId":"72057821671271410","type":"choice","className":"DemeanorTemplate","speaker":"Player","text":"I already paid Nabla.","speakerId":"Ntt_4A96A8B1","textSource":"localization","pronounText":{"TextHeVersion":"I already paid Nabla.","TextS