{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nivalis quest v2",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "description", "objectives", "dialogueIds", "flow"],
  "properties": {
    "schemaVersion": {"const": 2},
    "id": {"type": "string"},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "owner": {"type": ["string", "null"]},
    "dialogueIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "type", "dialogueIds", "sourceOrder"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "description": {"type": "string"},
          "type": {"type": "string"},
          "targetName": {"type": ["string", "null"]},
          "sourceOrder": {"type": "integer", "minimum": 0},
          "dialogueIds": {"type": "array", "items": {"type": "string"}},
          "condition": {"type": "string"},
          "onStart": {"type": "array", "items": {"$ref": "dialogue.schema.json#/$defs/effect"}},
          "onComplete": {"type": "array", "items": {"$ref": "dialogue.schema.json#/$defs/effect"}}
        }
      }
    },
    "flow": {
      "type": "object",
      "required": ["entry", "exit", "nodes", "edges"],
      "properties": {
        "entry": {"type": "string"},
        "exit": {"type": "string"},
        "nodes": {"type": "array"},
        "edges": {"type": "array"}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
