{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nivalis static effect-combination analysis v2",
  "description": "Complete means structural completeness only; guards are not evaluated. Partial, cycle and limit analyses never claim maxima or guaranteed rewards.",
  "type": "object",
  "required": ["schemaVersion", "status", "complete", "method", "message", "outcomes", "stats", "diagnostics"],
  "properties": {
    "schemaVersion": {"const": 2},
    "status": {"enum": ["complete", "partial", "cycle", "limit"]},
    "complete": {"type": "boolean"},
    "method": {"const": "merged-effect-states-v1"},
    "message": {"type": "string"},
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "summary", "conditions", "effects", "witness"],
        "properties": {
          "id": {"type": "string", "pattern": "^outcome-[0-9a-f]{20}$"},
          "summary": {
            "description": "Ordered literal composition; opaque actions/scripts are not simulated. A variable appears in either deltas or assignments, never both. Actions and unparsed lists preserve repeated occurrences.",
            "type": "object",
            "required": ["deltas", "assignments", "recipes", "actions", "unparsed"],
            "properties": {
              "deltas": {"type": "object", "additionalProperties": {"type": "number"}},
              "assignments": {"type": "object", "additionalProperties": {"type": ["number", "boolean"]}},
              "recipes": {"$ref": "#/$defs/uniqueStrings"},
              "actions": {"$ref": "#/$defs/strings"},
              "unparsed": {"$ref": "#/$defs/strings"}
            }
          },
          "conditions": {"$ref": "#/$defs/uniqueStrings"},
          "effects": {
            "description": "Original node and edge effect payloads in the witness's execution order.",
            "type": "array",
            "items": {"type": "object"}
          },
          "witness": {
            "description": "A genuine entry-to-exit route using real graph IDs; convergent cycles may repeat nodes.",
            "type": "object",
            "required": ["nodes", "edges", "choices"],
            "properties": {
              "nodes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "edges": {"$ref": "#/$defs/strings"},
              "choices": {"$ref": "#/$defs/strings"}
            }
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "required": ["totalNodes", "totalEdges", "reachableNodes", "effectBearingNodes", "effectBearingEdges", "processedStates", "discoveredStates", "mergedStates", "processedTransitions", "effectOperations", "stateLimit", "transitionLimit", "effectOperationLimit", "stateUnits", "stateUnitLimit", "witnessSteps", "witnessStepLimit", "outputEffects", "outputEffectLimit", "cycleComponents", "omittedCycleTransitions", "boundaries", "deadEnds", "outcomes"],
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "message"],
        "properties": {
          "kind": {"enum": ["effectful_cycle", "convergent_cycle", "unsupported_effect", "boundary", "dead_end", "invalid_transition", "missing_entry", "resource_limit", "unreachable_exit"]},
          "message": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string"}},
    "uniqueStrings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
